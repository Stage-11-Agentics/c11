     private var lastRows: UInt16 = 0[m
     private var userdataRetain: Unmanaged<SpikeDaemonConnection>?[m
     private var readerStarted = false[m
[32m+[m[32m    private var resizeGeneration: UInt64 = 0[m
[32m+[m[32m    private static let resizeSettleMs = 40[m
 [m
     /// Connects and sends OPEN before the surface exists, so any early IO-thread[m
     /// write (initial input, focus report) is ordered after it on the socket.[m
[36m@@ -11291,7 +11293,24 @@[m [mfinal class SpikeDaemonConnection {[m
 [m
     /// Main thread, after every `ghostty_surface_set_size` and cell-size change.[m
     /// Manual mode has no resize hook, so the host reads the grid itself.[m
[32m+[m[32m    /// Trailing debounce: Ghostty applies a resize to its grid up to 25 ms after[m
[32m+[m[32m    /// `set_size` (Termio coalesce). Sending TIOCSWINSZ before that lets a TUI's[m
[32m+[m[32m    /// SIGWINCH redraw land on the old grid (seen live with vim), so wait 40 ms[m
[32m+[m[32m    /// after the last change, then send the grid Ghostty reports.[m
     func noteGridSize(_ surface: ghostty_surface_t) {[m
[32m+[m[32m        resizeGeneration &+= 1[m
[32m+[m[32m        let generation = resizeGeneration[m
[32m+[m[32m        DispatchQueue.main.asyncAfter(deadline: .now() + .milliseconds(Self.resizeSettleMs)) { [weak self] in[m
[32m+[m[32m            guard let self, self.resizeGeneration == generation else { return }[m
[32m+[m[32m            os_unfair_lock_lock(self.surfaceLock)[m
[32m+[m[32m            let current = self.surface[m
[32m+[m[32m            os_unfair_lock_unlock(self.surfaceLock)[m
[32m+[m[32m            guard let current else { return }[m
[32m+[m[32m            self.sendGridSizeNow(current)[m
[32m+[m[32m        }[m
[32m+[m[32m    }[m
[32m+[m
[32m+[m[32m    private func sendGridSizeNow(_ surface: ghostty_surface_t) {[m
         let size = ghostty_surface_size(surface)[m
         guard size.columns > 0, size.rows > 0 else { return }[m
         guard size.columns != lastCols || size.rows != lastRows else { return }[m

