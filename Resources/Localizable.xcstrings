    "browser.dialog.queued": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This page wants to show a dialog. Click the page to see it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このページはダイアログを表示しようとしています。ページをクリックして表示してください。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
