    "hc.admission.notOwned": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Caller is not descended from a live terminal in this c11 session."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "呼び出し元は、この c11 セッション内の実行中のターミナルの子孫ではありません。"
          }
        },
        "uk": {
          "stringUnit": {
