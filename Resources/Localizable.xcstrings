          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "六个终端区域，2 列 3 行。建议使用 27 英寸以上的外部显示器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
