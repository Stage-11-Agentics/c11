      }
    },
    "mailbox.insights.pickup.note.unreadable": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "c11 could not read this workspace's mailbox log, so no pickup times are known."}},
        "ja": {"stringUnit": {"state": "translated", "value": "c11 がこのワークスペースのメールボックスログを読み取れなかったため、受け取りまでの時間は不明です。"}},
        "uk": {"stringUnit": {"state": "translated", "value": "c11 не зміг прочитати журнал поштової скриньки цього робочого простору, тому час очікування невідомий."}},
        "ko": {"stringUnit": {"state": "translated", "value": "c11이 이 작업 공간의 메일함 로그를 읽지 못해 가져간 시간을 알 수 없습니다."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "c11 无法读取此工作区的邮箱日志，因此不知道取走等待时间。"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "c11 無法讀取此工作區的郵箱日誌，因此不知道取走等待時間。"}},
        "ru": {"stringUnit": {"state": "translated", "value": "c11 не смог прочитать журнал почтового ящика этого рабочего пространства, поэтому время ожидания неизвестно."}}
      }
    },
    "mailbox.insights.pickup.note.noLog": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "This workspace has no mailbox log yet, so no pickup times are known."}},
        "ja": {"stringUnit": {"state": "translated", "value": "このワークスペースにはまだメールボックスログがないため、受け取りまでの時間は不明です。"}},
        "uk": {"stringUnit": {"state": "translated", "value": "Цей робочий простір ще не має журналу поштової скриньки, тому час очікування невідомий."}},
        "ko": {"stringUnit": {"state": "translated", "value": "이 작업 공간에는 아직 메일함 로그가 없어 가져간 시간을 알 수 없습니다."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "此工作区尚无邮箱日志，因此不知道取走等待时间。"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "此工作區尚無郵箱日誌，因此不知道取走等待時間。"}},
        "ru": {"stringUnit": {"state": "translated", "value": "У этого рабочего пространства пока нет журнала почтового ящика, поэтому время ожидания неизвестно."}}
      }
    },
    "mailbox.insights.pickup.note.readFrom": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "The mailbox log was read back to %@ only; claims before then are not counted."}},
        "ja": {"stringUnit": {"state": "translated", "value": "メールボックスログは %@ までしか遡って読み取っていません。それ以前の取得は集計されません。"}},
        "uk": {"stringUnit": {"state": "translated", "value": "Журнал поштової скриньки прочитано лише до %@; раніші випадки, коли повідомлення забирали, не враховано."}},
        "ko": {"stringUnit": {"state": "translated", "value": "메일함 로그는 %@까지만 거슬러 읽었으며, 그 이전의 가져감은 집계되지 않습니다."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "邮箱日志仅回溯读取到 %@；此前的取走记录不计入。"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "郵箱日誌僅回溯讀取到 %@；此前的取走紀錄不計入。"}},
        "ru": {"stringUnit": {"state": "translated", "value": "Журнал почтового ящика прочитан только до %@; более ранние случаи, когда сообщения забирали, не учитываются."}}
      }
    },
    "mailbox.insights.pickup.note.unclaimed": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Taken in the last %lld days without a claim record: %lld. c11 records claims from version 1.7.5, so mail taken before that has no pickup time."}},
        "ja": {"stringUnit": {"state": "translated", "value": "直近 %lld 日間に取得記録なしで受け取られたもの：%lld 件。c11 はバージョン 1.7.5 から取得を記録するため、それ以前に受け取られたメールには受け取りまでの時間がありません。"}},
        "uk": {"stringUnit": {"state": "translated", "value": "Забрано за останні %lld дн. без запису про забирання: %lld. c11 записує забирання з версії 1.7.5, тому в пошти, забраної раніше, немає часу очікування."}},
        "ko": {"stringUnit": {"state": "translated", "value": "최근 %lld일 동안 가져감 기록 없이 가져간 메일: %lld개. c11은 버전 1.7.5부터 가져감을 기록하므로 그 이전에 가져간 메일에는 대기 시간이 없습니다."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "最近 %lld 天内已被取走但无取走记录的：%lld 条。c11 自 1.7.5 版起记录取走，因此更早取走的邮件没有等待时间。"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "最近 %lld 天內已被取走但無取走紀錄的：%lld 則。c11 自 1.7.5 版起記錄取走，因此更早取走的郵件沒有等待時間。"}},
        "ru": {"stringUnit": {"state": "translated", "value": "Забрано за последние %lld дн. без записи о получении: %lld. c11 записывает получение с версии 1.7.5, поэтому у почты, забранной раньше, нет времени ожидания."}}
      }
    },
    "mailbox.insights.pickup.note.sample": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Pickup waits cover only the newest %lld of %lld messages."}},
        "ja": {"stringUnit": {"state": "translated", "value": "受け取り待ち時間は、最新の %lld 件（全 %lld 件中）のみが対象です。"}},
        "uk": {"stringUnit": {"state": "translated", "value": "Час очікування враховує лише найновіші %lld із %lld повідомлень."}},
        "ko": {"stringUnit": {"state": "translated", "value": "대기 시간은 최신 %lld개 / 전체 %lld개 메시지만 기준으로 합니다."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "取走等待时间仅统计最新 %lld 条（共 %lld 条）消息。"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "取走等待時間僅統計最新 %lld 則（共 %lld 則）訊息。"}},
        "ru": {"stringUnit": {"state": "translated", "value": "Время ожидания учитывает только новейшие %lld из %lld сообщений."}}
      }
    },
    "mailbox.conversations.missed": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "That conversation is not in the list. Conversations reads only this panel's newest %lld received messages and its sends since then."}},
        "ja": {"stringUnit": {"state": "translated", "value": "その会話は一覧にありません。会話は、このパネルが受信した最新の %lld 件と、それ以降の送信分のみを読み取ります。"}},
        "uk": {"stringUnit": {"state": "translated", "value": "Цієї розмови немає в списку. Розмови враховують лише найновіші %lld отриманих цією панеллю повідомлень і надіслані відтоді."}},
        "ko": {"stringUnit": {"state": "translated", "value": "해당 대화가 목록에 없습니다. 대화는 이 패널이 받은 최신 메시지 %lld개와 그 이후 보낸 메시지만 읽습니다."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "该对话不在列表中。对话仅读取此面板收到的最新 %lld 条消息及此后发出的消息。"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "該對話不在清單中。對話僅讀取此面板收到的最新 %lld 則訊息及此後傳送的訊息。"}},
        "ru": {"stringUnit": {"state": "translated", "value": "Этого диалога нет в списке. Диалоги учитывают только новейшие %lld полученных этой панелью сообщений и отправленные с тех пор."}}
      }
    },
    "c11.tip.keptRunning.one": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your terminal kept running while c11 was closed."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "c11を閉じている間も、ターミナルは実行を続けていました。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш термінал продовжував працювати, поки c11 був закритий."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "c11를 닫아 둔 동안에도 터미널이 계속 실행되고 있었습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "c11 关闭期间，你的终端一直在运行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "c11 關閉期間，你的終端機一直在執行。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш терминал продолжал работать, пока c11 был закрыт."
          }
        }
      }
    },
    "c11.tip.keptRunning.other": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your %lld terminals kept running while c11 was closed."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "c11を閉じている間も、%lld個のターミナルが実行を続けていました。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Термінали продовжували працювати, поки c11 був закритий: %lld."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "c11를 닫아 둔 동안에도 터미널 %lld개가 계속 실행되고 있었습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "c11 关闭期间，你的 %lld 个终端一直在运行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "c11 關閉期間，你的 %lld 個終端機一直在執行。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Терминалы продолжали работать, пока c11 был закрыт: %lld."
          }
        }
      }
    },
    "c11.tip.keptRunning.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quitting c11 never ends them. Closing a panel does."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "c11を終了しても、ターミナルは終了しません。パネルを閉じると終了します。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вихід із c11 їх не завершує, а закриття панелі завершує."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "c11를 종료해도 터미널은 끝나지 않습니다. 패널을 닫으면 끝납니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "退出 c11 不会结束它们，关闭面板才会。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "結束 c11 不會終止它們，關閉面板才會。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выход из c11 их не завершает, а закрытие панели завершает."
          }
        }
      }
    },
    "c11.tip.remoteLabel.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This terminal runs on %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このターミナルは%@で実行されています。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей термінал працює на %@."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 터미널은 %@에서 실행 중입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此终端运行在 %@ 上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此終端機正在 %@ 上執行。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот терминал работает на %@."
          }
        }
      }
    },
    "c11.tip.remoteLabel.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Its title bar names that machine. If the link drops, it says Reconnecting and the session keeps running."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タイトルバーにそのマシンの名前が表示されます。接続が切れると「Reconnecting」と表示されますが、セッションは実行を続けます。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У заголовку вікна вказано цей комп'ютер. Якщо зв'язок обірветься, з'явиться «Reconnecting», а сеанс продовжить працювати."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제목 막대에 해당 컴퓨터의 이름이 표시됩니다. 연결이 끊기면 ‘Reconnecting’이라고 표시되며, 세션은 계속 실행됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标题栏会显示该设备的名称。如果连接中断，会显示“Reconnecting”，会话仍会继续运行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "標題列會顯示該機器的名稱。如果連線中斷，會顯示「Reconnecting」，工作階段仍會繼續執行。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В заголовке указан этот компьютер. Если связь прервётся, появится «Reconnecting», а сеанс продолжит работать."
          }
        }
      }
    },
    "c11.tip.endSession.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That ended the terminal and everything it started."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ターミナルと、そこで起動したものがすべて終了しました。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Термінал і все, що він запустив, завершено."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "터미널과 그 터미널에서 시작한 모든 것이 종료되었습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "终端及其启动的所有内容都已结束。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "終端機及其啟動的所有項目都已結束。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Терминал и всё, что он запустил, завершены."
          }
        }
      }
    },
    "c11.tip.endSession.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Background jobs ended too. Quitting c11 instead keeps terminals running."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックグラウンドのジョブも終了しました。代わりにc11を終了すると、ターミナルは実行を続けます。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Фонові завдання також завершено. Вихід із c11 натомість залишає термінали працювати."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "백그라운드 작업도 종료되었습니다. 대신 c11를 종료하면 터미널은 계속 실행됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "后台任务也已结束。如果改为退出 c11，终端会继续运行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "背景工作也已結束。若改為結束 c11，終端機會繼續執行。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Фоновые задания тоже завершены. Если выйти из c11, терминалы продолжат работать."
          }
        }
      }
    },
    "agentLaunchWatch.notInstalled": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ on %2$@ didn't start: %3$@ is not installed there."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@（%2$@）を起動できませんでした：%3$@がインストールされていません。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ (%2$@): не вдалося запустити — там не встановлено %3$@."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@(%2$@)을(를) 시작하지 못했습니다: %3$@이(가) 설치되어 있지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@（%2$@）未能启动：未安装 %3$@。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@（%2$@）未能啟動：尚未安裝 %3$@。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ (%2$@): не удалось запустить — там не установлено %3$@."
          }
        }
      }
    },
    "agentLaunchWatch.usageLimit": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ on %2$@ didn't start: its account there hit a usage limit."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@（%2$@）を起動できませんでした：そちらのアカウントが利用上限に達しました。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ (%2$@): не вдалося запустити — обліковий запис там досяг ліміту використання."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@(%2$@)을(를) 시작하지 못했습니다: 해당 컴퓨터의 계정이 사용 한도에 도달했습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@（%2$@）未能启动：该电脑上的账号已达到使用上限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@（%2$@）未能啟動：該電腦上的帳號已達到使用上限。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ (%2$@): не удалось запустить — учётная запись там достигла лимита использования."
          }
        }
      }
    },
    "agentLaunchWatch.notLoggedIn": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ on %2$@ didn't start: it is not logged in there."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@（%2$@）を起動できませんでした：そちらではログインしていません。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ (%2$@): не вдалося запустити — там не виконано вхід."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@(%2$@)을(를) 시작하지 못했습니다: 해당 컴퓨터에 로그인되어 있지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@（%2$@）未能启动：该电脑上尚未登录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@（%2$@）未能啟動：該電腦上尚未登入。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ (%2$@): не удалось запустить — там не выполнен вход."
          }
        }
      }
    },
    "agentLaunchWatch.apiError": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ on %2$@ hit an API error while starting."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@（%2$@）は起動中に API エラーが発生しました。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ (%2$@): під час запуску сталася помилка API."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@(%2$@) 시작 중 API 오류가 발생했습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@（%2$@）启动时遇到 API 错误。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@（%2$@）啟動時遇到 API 錯誤。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
