    "sidebarIcon.picker.characterViewer.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the macOS Character Viewer; the emoji you pick lands in the field."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS の「絵文字と記号」を開きます。選んだ絵文字がフィールドに入力されます。"
