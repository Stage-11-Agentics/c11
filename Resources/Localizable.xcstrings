    "settings.savedConfigs.note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "each config is a full launch recipe layered over its harness's Settings. click one to edit; the A button launches the pinned default."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各設定は、実行環境の設定に重ねて適用される完全な起動レシピです。クリックして編集します。A ボタンは固定されたデフォルトを起動します。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "кожна конфігурація — це повний рецепт запуску, накладений на налаштування свого середовища запуску. клацніть одну, щоб редагувати; кнопка A запускає закріплену типову."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 구성은 해당 실행 환경의 설정 위에 적용되는 완전한 실행 레시피입니다. 하나를 클릭하여 편집하고, A 버튼으로 고정된 기본값을 실행합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个配置都是叠加在其执行环境设置之上的完整启动方案。点按一项即可编辑；A 按钮会启动已固定的默认配置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每個設定都是疊加在其執行環境設定之上的完整啟動配方。點一下即可編輯；A 按鈕會啟動已釘選的預設。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "каждая конфигурация — полный рецепт запуска поверх настроек своей среды запуска. нажмите на неё, чтобы изменить; кнопка A запускает закреплённую конфигурацию по умолчанию."
          }
        }
      }
    },
