    "show.point.pageChanged": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The page changed. Option-click again to point at it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ページが変わりました。もう一度 Option キーを押しながらクリックして指し示してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
