    "terminal.remoteDrop.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ gets a copy of each file, and the path it lands at is pasted into this terminal."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各ファイルのコピーが%@に送られ、コピー先のパスがこのターミナルにペーストされます。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Копію кожного файлу буде надіслано на %@, а шлях до неї буде вставлено в цей термінал."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 파일의 복사본이 %@(으)로 전송되고, 저장된 경로가 이 터미널에 붙여넣어집니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个文件的副本都会发送到%@,其保存路径会粘贴到此终端中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每個檔案的副本都會傳送到%@,其儲存路徑會貼到此終端機中。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Копия каждого файла будет отправлена на %@, а путь к ней будет вставлен в этот терминал."
          }
        }
      }
    },
