          }
        }
      }
    },
    "agentLaunchWatch.trustFolder": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ on %2$@ is waiting for you to trust %3$@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@（%2$@）は、%3$@を信頼するかどうかの確認を待っています。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ (%2$@) чекає, поки ви підтвердите довіру: %3$@."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@(%2$@)이(가) 사용자가 %3$@을(를) 신뢰하기를 기다리고 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@（%2$@）正在等待你信任 %3$@。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@（%2$@）正在等待你信任 %3$@。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ (%2$@) ждёт, пока вы подтвердите доверие: %3$@."
          }
        }
      }
    },
