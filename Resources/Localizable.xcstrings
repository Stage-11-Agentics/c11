    "browser.remoteProxy.paused.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Requests from this page are blocked until the connection to %@ is back."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このページからのリクエストは、%@との接続が回復するまでブロックされます。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запити з цієї сторінки блокуються, доки не відновиться з’єднання з %@."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@와(과) 다시 연결될 때까지 이 페이지의 요청이 차단됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在与%@的连接恢复之前，此页面的请求将被阻止。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在與%@的連線恢復之前，此頁面的請求將被封鎖。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запросы с этой страницы блокируются, пока не восстановится соединение с %@."
          }
        }
      }
    },
