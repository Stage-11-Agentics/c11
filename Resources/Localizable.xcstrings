    "socket.retry_input.failedReason": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Input could not be resumed: %@. Try again."}},
        "ja": {"stringUnit": {"state": "translated", "value": "入力を再開できませんでした（%@）。もう一度お試しください。"}},
        "uk": {"stringUnit": {"state": "translated", "value": "Не вдалося відновити введення: %@. Спробуйте ще раз."}},
        "ko": {"stringUnit": {"state": "translated", "value": "입력을 재개하지 못했습니다: %@. 다시 시도하세요."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "无法恢复输入：%@。请重试。"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "無法恢復輸入：%@。請再試一次。"}},
        "ru": {"stringUnit": {"state": "translated", "value": "Не удалось возобновить ввод: %@. Повторите попытку."}}
      }
    },
    "hc.input.fault": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Input is paused after an interruption. Check the terminal, then choose Retry input."}},
        "ja": {"stringUnit": {"state": "translated", "value": "中断が発生したため、入力を一時停止しています。ターミナルを確認してから「入力を再試行」を選択してください。"}},
        "uk": {"stringUnit": {"state": "translated", "value": "Введення призупинено після переривання. Перевірте термінал, потім виберіть «Повторити введення»."}},
        "ko": {"stringUnit": {"state": "translated", "value": "중단 이후 입력이 일시 중지되었습니다. 터미널을 확인한 다음 \"입력 재시도\"를 선택하세요."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "输入因中断而暂停。请检查终端，然后选择“重试输入”。"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "輸入因中斷而暫停。請檢查終端機，然後選擇「重試輸入」。"}},
        "ru": {"stringUnit": {"state": "translated", "value": "Ввод приостановлен после прерывания. Проверьте терминал, затем нажмите «Повторить ввод»."}}
      }
    },
    "hc.input.guardRefused": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Input was not sent because the prompt changed. Check the terminal before trying again."}},
        "ja": {"stringUnit": {"state": "translated", "value": "プロンプトが変更されたため、入力は送信されませんでした。ターミナルを確認してから、もう一度お試しください。"}},
        "uk": {"stringUnit": {"state": "translated", "value": "Введення не надіслано, бо змінився запит. Перевірте термінал, перш ніж повторювати спробу."}},
        "ko": {"stringUnit": {"state": "translated", "value": "프롬프트가 바뀌어 입력이 전송되지 않았습니다. 다시 시도하기 전에 터미널을 확인하세요."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "由于提示符已更改，输入未发送。请先检查终端，再重试。"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "由於提示已變更，輸入未傳送。請檢查終端機後再重試。"}},
        "ru": {"stringUnit": {"state": "translated", "value": "Ввод не отправлен, потому что приглашение изменилось. Проверьте терминал, прежде чем повторять попытку."}}
      }
    },
    "hc.input.interrupted": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Input interrupted. Some input may have arrived. Previous input will not be sent again."}},
        "ja": {"stringUnit": {"state": "translated", "value": "入力が中断されました。一部の入力は届いている可能性があります。以前の入力は再送されません。"}},
        "uk": {"stringUnit": {"state": "translated", "value": "Введення перервано. Частина введеного могла дійти. Попереднє введення не буде надіслано повторно."}},
        "ko": {"stringUnit": {"state": "translated", "value": "입력이 중단되었습니다. 일부 입력은 전달되었을 수 있습니다. 이전 입력은 다시 전송되지 않습니다."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "输入已中断，部分输入可能已送达。之前的输入不会再次发送。"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "輸入已中斷，部分輸入可能已送達。先前的輸入不會再次傳送。"}},
        "ru": {"stringUnit": {"state": "translated", "value": "Ввод прерван. Часть ввода могла дойти. Предыдущий ввод повторно отправлен не будет."}}
      }
    },
    "hc.input.queueFull": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Input was not sent because the terminal input queue is full. Try again when it responds."}},
        "ja": {"stringUnit": {"state": "translated", "value": "ターミナルの入力キューがいっぱいのため、入力は送信されませんでした。応答するようになってから、もう一度お試しください。"}},
        "uk": {"stringUnit": {"state": "translated", "value": "Введення не надіслано, бо черга введення термінала заповнена. Повторіть спробу, коли він відповість."}},
        "ko": {"stringUnit": {"state": "translated", "value": "터미널 입력 대기열이 가득 차서 입력이 전송되지 않았습니다. 터미널이 응답하면 다시 시도하세요."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "由于终端输入队列已满，输入未发送。请在终端恢复响应后重试。"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "終端機輸入佇列已滿，輸入未傳送。請待其回應後再試。"}},
        "ru": {"stringUnit": {"state": "translated", "value": "Ввод не отправлен: очередь ввода терминала заполнена. Повторите попытку, когда он ответит."}}
      }
    },
    "hc.input.reconnecting": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Input was not sent while this terminal reconnects."}},
        "ja": {"stringUnit": {"state": "translated", "value": "このターミナルの再接続中のため、入力は送信されませんでした。"}},
        "uk": {"stringUnit": {"state": "translated", "value": "Введення не надіслано, поки цей термінал перепідключається."}},
        "ko": {"stringUnit": {"state": "translated", "value": "이 터미널을 다시 연결하는 동안에는 입력이 전송되지 않았습니다."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "此终端正在重新连接，输入未发送。"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "此終端機重新連線期間，輸入未傳送。"}},
        "ru": {"stringUnit": {"state": "translated", "value": "Ввод не отправлен, пока этот терминал переподключается."}}
      }
    },
    "hc.cli.retryRead": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Retrying this read-only command is safe; run the same command again. Unavailable inventory does not mean sessions ended."}},
        "ja": {"stringUnit": {"state": "translated", "value": "この読み取り専用コマンドは再試行しても安全です。同じコマンドをもう一度実行してください。インベントリが利用できないことは、セッションが終了したことを意味しません。"}},
        "uk": {"stringUnit": {"state": "translated", "value": "Повторити цю команду лише для читання безпечно: виконайте ту саму команду ще раз. Недоступність переліку не означає, що сеанси завершилися."}},
        "ko": {"stringUnit": {"state": "translated", "value": "이 읽기 전용 명령은 다시 시도해도 안전합니다. 같은 명령을 다시 실행하세요. 인벤토리를 사용할 수 없다고 해서 세션이 종료된 것은 아닙니다."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "重试这条只读命令是安全的；请再次运行同一条命令。清单不可用并不表示会话已结束。"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "重試這個唯讀指令是安全的；請再次執行同一個指令。清單無法使用並不表示工作階段已結束。"}},
        "ru": {"stringUnit": {"state": "translated", "value": "Повторить эту команду только для чтения безопасно: выполните ту же команду ещё раз. Недоступность перечня не означает, что сеансы завершились."}}
      }
    },
    "hc.input.retry": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Retry input"}},
        "ja": {"stringUnit": {"state": "translated", "value": "入力を再試行"}},
        "uk": {"stringUnit": {"state": "translated", "value": "Повторити введення"}},
        "ko": {"stringUnit": {"state": "translated", "value": "입력 재시도"}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "重试输入"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "重試輸入"}},
        "ru": {"stringUnit": {"state": "translated", "value": "Повторить ввод"}}
      }
    },
    "hc.input.screenUnavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Input was not sent because the terminal screen is not ready."}},
        "ja": {"stringUnit": {"state": "translated", "value": "ターミナルの画面の準備ができていないため、入力は送信されませんでした。"}},
        "uk": {"stringUnit": {"state": "translated", "value": "Введення не надіслано, бо екран термінала ще не готовий."}},
        "ko": {"stringUnit": {"state": "translated", "value": "터미널 화면이 아직 준비되지 않아 입력이 전송되지 않았습니다."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "由于终端屏幕尚未就绪，输入未发送。"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "終端機畫面尚未就緒，輸入未傳送。"}},
        "ru": {"stringUnit": {"state": "translated", "value": "Ввод не отправлен: экран терминала ещё не готов."}}
      }
    },
    "hc.input.staleIdentity": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Input was not sent because the terminal connection changed."}},
        "ja": {"stringUnit": {"state": "translated", "value": "ターミナルの接続が変更されたため、入力は送信されませんでした。"}},
        "uk": {"stringUnit": {"state": "translated", "value": "Введення не надіслано, бо змінилося з'єднання термінала."}},
        "ko": {"stringUnit": {"state": "translated", "value": "터미널 연결이 바뀌어 입력이 전송되지 않았습니다."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "由于终端连接已更改，输入未发送。"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "終端機連線已變更，輸入未傳送。"}},
        "ru": {"stringUnit": {"state": "translated", "value": "Ввод не отправлен, потому что соединение с терминалом изменилось."}}
      }
    },
    "hc.input.tooLarge": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Input was not sent because it is too large. Try a smaller paste."}},
        "ja": {"stringUnit": {"state": "translated", "value": "サイズが大きすぎるため、入力は送信されませんでした。ペーストするデータを小さくしてお試しください。"}},
        "uk": {"stringUnit": {"state": "translated", "value": "Введення не надіслано, бо воно завелике. Спробуйте вставити менший фрагмент."}},
        "ko": {"stringUnit": {"state": "translated", "value": "입력이 너무 커서 전송되지 않았습니다. 더 작은 단위로 붙여넣어 보세요."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "由于输入过大，未发送。请尝试粘贴较小的内容。"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "輸入內容過大，未傳送。請嘗試較小的貼上內容。"}},
        "ru": {"stringUnit": {"state": "translated", "value": "Ввод не отправлен, потому что он слишком большой. Попробуйте вставить меньший фрагмент."}}
      }
    },
    "workspace.recovered": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Recovered"}},
        "ja": {"stringUnit": {"state": "translated", "value": "復旧済み"}},
        "uk": {"stringUnit": {"state": "translated", "value": "Відновлено"}},
        "ko": {"stringUnit": {"state": "translated", "value": "복구됨"}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "已恢复"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "已復原"}},
        "ru": {"stringUnit": {"state": "translated", "value": "Восстановлено"}}
      }
    },
    "conversation.resume.liveAgent": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is still running in this terminal, so it was not resumed."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ はこのターミナルでまだ実行中のため、再開されませんでした。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ досі працює в цьому терміналі, тому його не відновлено."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 터미널에서 %@ 실행이 계속되고 있어 다시 시작하지 않았습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 仍在此终端中运行，因此未恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 仍在此終端機中執行，因此未恢復。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Возобновление не выполнено: %@ всё ещё работает в этом терминале."
          }
        }
      }
    },
    "conversation.resume.terminalNotReplaced": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "The terminal is still running or reconnecting."}},
        "ja": {"stringUnit": {"state": "translated", "value": "ターミナルはまだ実行中、または再接続中です。"}},
        "uk": {"stringUnit": {"state": "translated", "value": "Термінал досі працює або перепідключається."}},
        "ko": {"stringUnit": {"state": "translated", "value": "터미널이 아직 실행 중이거나 다시 연결 중입니다."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "该终端仍在运行或正在重新连接。"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "終端機仍在執行或正在重新連線。"}},
        "ru": {"stringUnit": {"state": "translated", "value": "Терминал ещё работает или переподключается."}}
      }
    },
    "terminal.restore.holderLost": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "The terminal host stopped and ended this session. This panel is kept for recovery."}},
        "ja": {"stringUnit": {"state": "translated", "value": "ターミナルのホストが停止し、このセッションは終了しました。このパネルは復旧のために保持されています。"}},
        "uk": {"stringUnit": {"state": "translated", "value": "Хост термінала зупинився й завершив цей сеанс. Цю панель збережено для відновлення."}},
        "ko": {"stringUnit": {"state": "translated", "value": "터미널 호스트가 중지되어 이 세션이 종료되었습니다. 이 패널은 복구를 위해 유지됩니다."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "终端宿主已停止并结束了此会话。此面板已保留以便恢复。"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "終端機主機已停止，並結束了此工作階段。此面板會保留以供復原。"}},
        "ru": {"stringUnit": {"state": "translated", "value": "Хост терминала остановился и завершил этот сеанс. Панель сохранена для восстановления."}}
      }
    },
    "terminal.restore.previousSessionEnded": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "The terminal host stopped and ended this panel's previous session. This is a new shell."}},
        "ja": {"stringUnit": {"state": "translated", "value": "ターミナルホストが停止し、このパネルの前のセッションが終了しました。これは新しいシェルです。"}},
        "uk": {"stringUnit": {"state": "translated", "value": "Хост термінала зупинився і завершив попередній сеанс цієї панелі. Це нова оболонка."}},
        "ko": {"stringUnit": {"state": "translated", "value": "터미널 호스트가 중지되어 이 패널의 이전 세션이 종료되었습니다. 새 셸입니다."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "终端主机已停止，并结束了此面板之前的会话。这是一个新的 shell。"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "終端機主機已停止，並結束了此面板先前的工作階段。這是一個新的 shell。"}},
        "ru": {"stringUnit": {"state": "translated", "value": "Хост терминала остановился и завершил предыдущий сеанс этой панели. Это новая оболочка."}}
      }
    },
    "terminal.restore.resourceExhausted": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "The terminal could not start because the host has no file handles available. This panel is waiting for recovery."}},
        "ja": {"stringUnit": {"state": "translated", "value": "ホストに使用可能なファイルハンドルがないため、ターミナルを起動できませんでした。このパネルは復旧を待っています。"}},
        "uk": {"stringUnit": {"state": "translated", "value": "Термінал не вдалося запустити, бо в хоста не лишилося вільних дескрипторів файлів. Ця панель чекає на відновлення."}},
        "ko": {"stringUnit": {"state": "translated", "value": "호스트에 사용할 수 있는 파일 핸들이 없어 터미널을 시작할 수 없습니다. 이 패널은 복구를 기다리는 중입니다."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "终端无法启动，因为宿主没有可用的文件句柄。此面板正在等待恢复。"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "終端機無法啟動，因為主機沒有可用的檔案控制代碼。此面板正在等待復原。"}},
        "ru": {"stringUnit": {"state": "translated", "value": "Терминал не удалось запустить: у хоста нет свободных файловых дескрипторов. Эта панель ждёт восстановления."}}
      }
    },
    "terminal.restore.dismissNotice": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Dismiss recovery notice"}},
        "ja": {"stringUnit": {"state": "translated", "value": "復旧のお知らせを閉じる"}},
        "uk": {"stringUnit": {"state": "translated", "value": "Закрити сповіщення про відновлення"}},
        "ko": {"stringUnit": {"state": "translated", "value": "복구 알림 닫기"}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "关闭恢复通知"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "關閉復原通知"}},
        "ru": {"stringUnit": {"state": "translated", "value": "Скрыть уведомление о восстановлении"}}
      }
    },
    "menu.app.endAllSessions": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "End All Sessions…"}},
        "ja": {"stringUnit": {"state": "translated", "value": "すべてのセッションを終了…"}},
        "uk": {"stringUnit": {"state": "translated", "value": "Завершити всі сеанси…"}},
        "ko": {"stringUnit": {"state": "translated", "value": "모든 세션 종료…"}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "结束所有会话…"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "結束所有工作階段…"}},
        "ru": {"stringUnit": {"state": "translated", "value": "Завершить все сеансы…"}}
      }
    },
    "dialog.endAllSessions.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "End all sessions?"}},
        "ja": {"stringUnit": {"state": "translated", "value": "すべてのセッションを終了しますか？"}},
        "uk": {"stringUnit": {"state": "translated", "value": "Завершити всі сеанси?"}},
        "ko": {"stringUnit": {"state": "translated", "value": "모든 세션을 종료하시겠습니까?"}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "结束所有会话？"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "要結束所有工作階段嗎？"}},
        "ru": {"stringUnit": {"state": "translated", "value": "Завершить все сеансы?"}}
      }
    },
    "dialog.endAllSessions.messageOwn": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "This ends every terminal session this c11 started and all of their agents and jobs, including background jobs and nohup processes. Sessions another c11 build started keep running."}},
        "ja": {"stringUnit": {"state": "translated", "value": "この c11 が開始したすべてのターミナルセッションと、そのエージェントおよびジョブ（バックグラウンドジョブや nohup プロセスを含む）が終了します。別の c11 ビルドが開始したセッションは引き続き実行されます。"}},
        "uk": {"stringUnit": {"state": "translated", "value": "Це завершить кожен термінальний сеанс, запущений цим c11, усіх їхніх агентів і завдання, зокрема фонові завдання та процеси nohup. Сеанси, запущені іншою збіркою c11, продовжать працювати."}},
        "ko": {"stringUnit": {"state": "translated", "value": "이 c11가 시작한 모든 터미널 세션과 그 안의 모든 에이전트 및 작업이 종료됩니다. 백그라운드 작업과 nohup 프로세스도 포함됩니다. 다른 c11 빌드가 시작한 세션은 계속 실행됩니다."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "这将结束此 c11 启动的所有终端会话及其全部智能体和任务，包括后台任务和 nohup 进程。其他 c11 构建启动的会话将继续运行。"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "此舉會結束此 c11 啟動的每一個終端機工作階段，以及其中所有代理與工作，包括背景工作和 nohup 行程。其他 c11 版本啟動的工作階段會繼續執行。"}},
        "ru": {"stringUnit": {"state": "translated", "value": "Будут завершены все терминальные сеансы, запущенные этим c11, со всеми их агентами и заданиями, включая фоновые задания и процессы nohup. Сеансы, запущенные другой сборкой c11, продолжат работать."}}
      }
    },
    "dialog.endAllSessions.end": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "End All Sessions"}},
        "ja": {"stringUnit": {"state": "translated", "value": "すべてのセッションを終了"}},
        "uk": {"stringUnit": {"state": "translated", "value": "Завершити всі сеанси"}},
        "ko": {"stringUnit": {"state": "translated", "value": "모든 세션 종료"}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "结束所有会话"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "結束所有工作階段"}},
        "ru": {"stringUnit": {"state": "translated", "value": "Завершить все сеансы"}}
      }
    },
    "dialog.quitC11h.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Quit c11?"}},
        "ja": {"stringUnit": {"state": "translated", "value": "c11 を終了しますか？"}},
        "uk": {"stringUnit": {"state": "translated", "value": "Завершити c11?"}},
        "ko": {"stringUnit": {"state": "translated", "value": "c11를 종료하시겠습니까?"}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "退出 c11？"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "要結束 c11 嗎？"}},
        "ru": {"stringUnit": {"state": "translated", "value": "Завершить c11?"}}
      }
    },
    "dialog.quitC11h.messageEnds": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep Terminals After Quit is off, so quitting ends every terminal on this Mac and the jobs inside them."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「終了後もターミナルを維持」がオフのため、終了するとこのMac上のすべてのターミナルと、その中のジョブが終了します。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Параметр «Зберігати термінали після виходу» вимкнено, тому вихід завершує кожен термінал на цьому Mac і завдання в них."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“종료 후 터미널 유지”가 꺼져 있어서, 종료하면 이 Mac의 모든 터미널과 그 안의 작업이 종료됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“退出后保留终端”已关闭，因此退出会结束这台 Mac 上的所有终端以及其中的任务。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「結束後保留終端機」已關閉，因此結束時會結束此 Mac 上的每個終端機及其中的工作。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Параметр «Сохранять терминалы после выхода» выключен, поэтому выход завершит все терминалы на этом Mac и задачи в них."
          }
        }
      }
    },
    "dialog.quitC11h.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Persistent terminals and agents keep running. You can return to them when you reopen c11. Nonpersistent sessions end when you quit."}},
        "ja": {"stringUnit": {"state": "translated", "value": "永続ターミナルとエージェントは実行を続けます。c11 を再度開くと、それらに戻れます。永続化されていないセッションは、終了時に終了します。"}},
        "uk": {"stringUnit": {"state": "translated", "value": "Постійні термінали й агенти продовжують працювати. Ви зможете повернутися до них, коли знову відкриєте c11. Непостійні сеанси завершуються під час виходу."}},
        "ko": {"stringUnit": {"state": "translated", "value": "영구 터미널과 에이전트는 계속 실행됩니다. c11를 다시 열면 그대로 돌아올 수 있습니다. 비영구 세션은 종료할 때 함께 끝납니다."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "持久终端和智能体会继续运行，重新打开 c11 后可返回。非持久会话将在退出时结束。"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "持續性終端機與代理會繼續執行，重新開啟 c11 後即可回到其中。非持續性的工作階段會在結束時一併結束。"}},
        "ru": {"stringUnit": {"state": "translated", "value": "Постоянные терминалы и агенты продолжат работать. К ним можно вернуться, снова открыв c11. Непостоянные сеансы завершатся при выходе."}}
      }
    },
    "dialog.quitC11h.quit": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Quit"}},
        "ja": {"stringUnit": {"state": "translated", "value": "終了"}},
