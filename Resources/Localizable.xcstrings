  "dialog.renameWindow.message": {
    "extractionState": "manual",
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "The name shows in the title bar and works as a --window ref. Leave it empty to remove it."
        }
      },
      "ja": {
        "stringUnit": {
          "state": "translated",
          "value": "名前はタイトルバーに表示され、--window の参照としても使えます。空にすると名前を削除します。"
        }
      },
      "uk": {
        "stringUnit": {
          "state": "translated",
          "value": "Назва показується в рядку заголовка й працює як посилання --window. Залиште поле порожнім, щоб видалити її."
        }
      },
      "ko": {
        "stringUnit": {
          "state": "translated",
          "value": "이름은 제목 표시줄에 표시되고 --window 참조로도 쓰여요. 비워 두면 이름이 삭제돼요."
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "名称会显示在标题栏中，也可用作 --window 引用。留空则删除名称。"
        }
      },
      "zh-Hant": {
        "stringUnit": {
          "state": "translated",
          "value": "名稱會顯示在標題列，也可作為 --window 參照。留空則移除名稱。"
        }
      },
      "ru": {
        "stringUnit": {
          "state": "translated",
          "value": "Имя отображается в заголовке окна и работает как ссылка --window. Оставьте поле пустым, чтобы удалить его."
        }
      }
    }
  },
