    "settings.dataPrivacy.telemetry.c11None": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "c11 sends no telemetry."}},
        "ja": {"stringUnit": {"state": "translated", "value": "c11 はテレメトリを送信しません。"}},
        "uk": {"stringUnit": {"state": "translated", "value": "c11 не надсилає телеметрію."}},
        "ko": {"stringUnit": {"state": "translated", "value": "c11는 원격 측정 데이터를 전송하지 않습니다."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "c11 不会发送遥测数据。"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "c11 不會傳送遙測資料。"}},
        "ru": {"stringUnit": {"state": "translated", "value": "c11 не отправляет телеметрию."}}
      }
    },
    "hc.resume.refused": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Resume input was refused: %@"}},
        "ja": {"stringUnit": {"state": "translated", "value": "再開の入力が拒否されました: %@"}},
        "uk": {"stringUnit": {"state": "translated", "value": "Введення для відновлення відхилено: %@"}},
        "ko": {"stringUnit": {"state": "translated", "value": "재개 입력이 거부되었습니다: %@"}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "恢复输入被拒绝：%@"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "恢復輸入遭拒：%@"}},
        "ru": {"stringUnit": {"state": "translated", "value": "Ввод для возобновления отклонён: %@"}}
      }
    },
    "hc.resume.interrupted": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Resume input was interrupted and will not be sent again."}},
        "ja": {"stringUnit": {"state": "translated", "value": "再開の入力が中断されました。再送信されません。"}},
        "uk": {"stringUnit": {"state": "translated", "value": "Введення для відновлення було перервано й не буде надіслане повторно."}},
        "ko": {"stringUnit": {"state": "translated", "value": "재개 입력이 중단되었으며 다시 전송되지 않습니다."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "恢复输入已中断，不会再次发送。"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "恢復輸入已中斷，不會再次傳送。"}},
        "ru": {"stringUnit": {"state": "translated", "value": "Ввод для возобновления прерван и повторно отправлен не будет."}}
      }
    },
    "hc.resume.notReady": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "The ended session does not have a fresh shell ready for resume."}},
        "ja": {"stringUnit": {"state": "translated", "value": "終了したセッションには、再開に使える新しいシェルが用意されていません。"}},
        "uk": {"stringUnit": {"state": "translated", "value": "Для завершеного сеансу немає свіжої оболонки, готової до відновлення."}},
        "ko": {"stringUnit": {"state": "translated", "value": "종료된 세션에 재개할 수 있는 새 셸이 준비되어 있지 않습니다."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "已结束的会话没有可用于恢复的全新 shell。"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "已結束的工作階段尚無可供恢復的全新 shell。"}},
        "ru": {"stringUnit": {"state": "translated", "value": "У завершённого сеанса нет свежей оболочки, готовой к возобновлению."}}
      }
    },
    "dialog.endAllSessions.pendingMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "End requests for known sessions are saved and will continue when the backend is available. If the session inventory could not be read, reconnect and choose End All Sessions again to include every session."}},
        "ja": {"stringUnit": {"state": "translated", "value": "既知のセッションの終了リクエストは保存され、バックエンドが利用可能になり次第続行されます。セッション一覧を読み取れなかった場合は、再接続してもう一度「すべてのセッションを終了」を選択すると、すべてのセッションが対象になります。"}},
        "uk": {"stringUnit": {"state": "translated", "value": "Запити на завершення відомих сеансів збережено, і вони виконаються, щойно бекенд стане доступним. Якщо не вдалося прочитати перелік сеансів, перепідключіться й знову виберіть «Завершити всі сеанси», щоб охопити кожен сеанс."}},
        "ko": {"stringUnit": {"state": "translated", "value": "알려진 세션의 종료 요청은 저장되며 백엔드를 사용할 수 있게 되면 계속 진행됩니다. 세션 목록을 읽지 못했다면 다시 연결한 뒤 모든 세션을 포함하도록 \"모든 세션 종료\"를 다시 선택하세요."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "已知会话的结束请求已保存，将在后端可用时继续执行。如果无法读取会话清单，请重新连接并再次选择“结束所有会话”，以涵盖每个会话。"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "已知工作階段的結束請求已儲存，待後端可用時會繼續執行。若無法讀取工作階段清單，請重新連線後再次選擇「結束所有工作階段」，以涵蓋每個工作階段。"}},
        "ru": {"stringUnit": {"state": "translated", "value": "Запросы на завершение известных сеансов сохранены и будут выполнены, когда серверная часть станет доступна. Если список сеансов прочитать не удалось, переподключитесь и снова выберите «Завершить все сеансы», чтобы охватить каждый сеанс."}}
      }
    },
    "dialog.endAllSessions.unavailableMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "The session backend is unavailable. Reconnect and choose End All Sessions again to confirm that every session has ended."}},
        "ja": {"stringUnit": {"state": "translated", "value": "セッションのバックエンドが利用できません。再接続してもう一度「すべてのセッションを終了」を選択し、すべてのセッションが終了したことを確認してください。"}},
        "uk": {"stringUnit": {"state": "translated", "value": "Бекенд сеансів недоступний. Перепідключіться й знову виберіть «Завершити всі сеанси», щоб підтвердити, що кожен сеанс завершено."}},
        "ko": {"stringUnit": {"state": "translated", "value": "세션 백엔드를 사용할 수 없습니다. 다시 연결한 뒤 \"모든 세션 종료\"를 다시 선택해 모든 세션이 종료되었는지 확인하세요."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "会话后端不可用。请重新连接并再次选择“结束所有会话”，以确认每个会话均已结束。"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "工作階段後端無法使用。請重新連線後再次選擇「結束所有工作階段」，以確認每個工作階段都已結束。"}},
        "ru": {"stringUnit": {"state": "translated", "value": "Серверная часть сеансов недоступна. Переподключитесь и снова выберите «Завершить все сеансы», чтобы убедиться, что все сеансы завершены."}}
      }
    },
    "dialog.endAllSessions.pendingTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Some sessions may still be running"}},
        "ja": {"stringUnit": {"state": "translated", "value": "実行中のセッションが残っている可能性があります"}},
        "uk": {"stringUnit": {"state": "translated", "value": "Деякі сеанси можуть досі працювати"}},
        "ko": {"stringUnit": {"state": "translated", "value": "일부 세션이 아직 실행 중일 수 있습니다"}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "部分会话可能仍在运行"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "部分工作階段可能仍在執行"}},
        "ru": {"stringUnit": {"state": "translated", "value": "Некоторые сеансы могут всё ещё работать"}}
      }
    },
    "hc.input.cancelled": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Input was cancelled before it was sent."}},
        "ja": {"stringUnit": {"state": "translated", "value": "入力は送信前にキャンセルされました。"}},
        "uk": {"stringUnit": {"state": "translated", "value": "Введення скасовано до надсилання."}},
        "ko": {"stringUnit": {"state": "translated", "value": "입력이 전송되기 전에 취소되었습니다."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "输入在发送前已取消。"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "輸入在傳送前已取消。"}},
        "ru": {"stringUnit": {"state": "translated", "value": "Ввод был отменён до отправки."}}
      }
    },
    "hc.input.dismiss": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Dismiss"}},
        "ja": {"stringUnit": {"state": "translated", "value": "閉じる"}},
        "uk": {"stringUnit": {"state": "translated", "value": "Закрити"}},
        "ko": {"stringUnit": {"state": "translated", "value": "닫기"}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "关闭"}},
