    "machineSetup.error.servingMismatch": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An hc that isn't this build's is already serving c11 on %1$@ (process %2$lld, %3$@), so c11 didn't use it or stop it. End that process there, then try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このビルドのものではない hc が、すでに %1$@ で c11 にサービスを提供しています(プロセス %2$lld、%3$@)。そのため c11 はそれを使用も停止もしていません。そちらでそのプロセスを終了してから、もう一度お試しください。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вже працює hc, який не належить до цієї збірки: він обслуговує c11 на %1$@ (процес %2$lld, %3$@), тому c11 його не використав і не зупинив. Завершіть цей процес там і повторіть спробу."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 빌드의 것이 아닌 hc가 이미 %1$@에서 c11을 서비스하고 있습니다(프로세스 %2$lld, %3$@). 그래서 c11은 이를 사용하거나 중지하지 않았습니다. 해당 위치에서 그 프로세스를 종료한 다음 다시 시도하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 上已有一个不属于此版本的 hc 正在为 c11 提供服务(进程 %2$lld,%3$@),因此 c11 没有使用它,也没有停止它。请在那里结束该进程,然后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 上已有一個不屬於此版本的 hc 正在為 c11 提供服務(程序 %2$lld,%3$@),因此 c11 沒有使用它,也沒有停止它。請在那裡結束該程序,然後再試一次。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На %1$@ уже работает hc не из этой сборки: он обслуживает c11 (процесс %2$lld, %3$@), поэтому c11 не стал его использовать и не остановил его. Завершите этот процесс там и повторите попытку."
          }
        }
      }
    },
    "machineSetup.linkSession.timeout": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "c11's hc core for new links did not start in time. Try again, or use Settings > Herder Topography > Add Machine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいリンク用の c11 の hc コアが時間内に起動しませんでした。もう一度お試しいただくか、「設定 > Herder トポグラフィー > マシンを追加」をご利用ください。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "hc-ядро c11 для нових з'єднань не запустилося вчасно. Повторіть спробу або скористайтеся розділом «Налаштування > Топографія herder > Додати машину»."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 링크용 c11의 hc 코어가 제때 시작되지 않았습니다. 다시 시도하거나 '설정 > 허더 토폴로지 > 머신 추가'를 사용하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "c11 用于新链接的 hc 核心未能及时启动。请重试，或使用“设置 > Herder 拓扑 > 添加机器”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "c11 用於新連結的 hc 核心未能及時啟動。請重試，或使用「設定 > Herder 拓撲 > 加入機器」。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ядро hc c11 для новых ссылок не запустилось вовремя. Повторите попытку или воспользуйтесь разделом «Настройки > Топография herder > Добавить машину»."
          }
        }
      }
    },
    "machineSetup.error.updateTarget": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ is linked through %2$@, not %3$@. To link it through another host, remove it and add it again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ は %3$@ ではなく %2$@ 経由でリンクされています。別のホスト経由でリンクするには、いったん削除してから追加し直してください。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ під'єднано через %2$@, а не через %3$@. Щоб під'єднати його через інший хост, видаліть його й додайте знову."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@은(는) %3$@이(가) 아니라 %2$@을(를) 통해 연결되어 있습니다. 다른 호스트를 통해 연결하려면 삭제한 뒤 다시 추가하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 是通过 %2$@ 连接的,而不是通过 %3$@。要改用其他主机连接,请先将其移除,再重新添加。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 是透過 %2$@ 連結的,而不是透過 %3$@。若要改用其他主機連結,請先將其移除,再重新加入。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ подключён через %2$@, а не через %3$@. Чтобы подключить его через другой хост, удалите его и добавьте снова."
          }
        }
      }
    },
    "machineSetup.error.updateTargetUnknown": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "c11 can't read how %@ is linked, so it won't update it in place. Remove it and add it again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "c11 は %@ のリンク方法を読み取れないため、その場で更新しません。いったん削除してから追加し直してください。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "c11 не може визначити, як під'єднано %@, тому не оновлюватиме його на місці. Видаліть його й додайте знову."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "c11이 %@의 연결 방식을 읽을 수 없어 제자리에서 업데이트하지 않습니다. 삭제한 뒤 다시 추가하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "c11 无法读取 %@ 的连接方式,因此不会就地更新它。请先将其移除,再重新添加。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "c11 無法讀取 %@ 的連結方式,因此不會就地更新它。請先將其移除,再重新加入。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "c11 не может определить, как подключён %@, поэтому не станет обновлять его на месте. Удалите его и добавьте снова."
          }
        }
      }
    },
