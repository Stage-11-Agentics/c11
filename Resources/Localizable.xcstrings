    "settings.notifications.turnEndSound.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Played when an agent finishes its turn, and for other routine notices."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントがターンを終えたとき、およびその他の定例通知で再生されます。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відтворюється, коли агент завершує свій хід, та для інших рутинних сповіщень."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이전트가 턴을 마칠 때와 기타 일반 알림에 재생됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "代理完成回合时播放，也用于其他常规通知。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "代理完成回合時播放，也用於其他例行通知。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Воспроизводится, когда агент завершает ход, и для других обычных уведомлений."
          }
        }
      }
    },
    "settings.notifications.needsYouSound.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Needs You Sound"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "要対応のサウンド"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Звук «Чекає на вас»"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "확인 필요 소리"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "待你处理声音"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "待你處理音效"
          }
        },
        "ru": {
