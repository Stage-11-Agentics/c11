          }
        }
      }
    },
    "machineSetup.step.secure": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check c11's hc and its folders"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "c11のhcとそのフォルダを確認"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перевірити hc від c11 і його теки"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "c11의 hc와 해당 폴더 확인"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查 c11 的 hc 及其文件夹"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檢查 c11 的 hc 及其資料夾"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверить hc от c11 и его папки"
          }
        }
      }
    },
    "machineSetup.error.hashMismatch": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The hc on %1$@ isn't the one this c11 ships (it hashes %2$@, this build expects %3$@), so c11 didn't link it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@のhcは、このc11が同梱するものと一致しません（ハッシュは%2$@、このビルドの期待値は%3$@）。c11はリンクしませんでした。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "hc на %1$@ не той, що постачається з цим c11 (його хеш %2$@, ця збірка очікує %3$@), тому c11 не під'єднав його."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@의 hc는 이 c11에 포함된 것이 아니므로(해시 %2$@, 이 빌드가 기대하는 값 %3$@) c11이 연결하지 않았습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 上的 hc 不是此 c11 自带的版本（其哈希为 %2$@，此构建期望的是 %3$@），因此 c11 没有连接它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 上的 hc 不是此 c11 隨附的版本（其雜湊為 %2$@，此版本預期的是 %3$@），因此 c11 沒有連結它。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "hc на %1$@ не тот, что поставляется с этим c11 (его хеш %2$@, эта сборка ожидает %3$@), поэтому c11 не стал его подключать."
          }
        }
      }
    },
    "machineSetup.error.folderRefused": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "c11 couldn't make hc's folder %2$@ on %1$@ private (%3$@), so it didn't link it. Fix or remove that folder there, then try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "c11は%1$@上のhcのフォルダ%2$@を非公開にできなかったため（%3$@）、リンクしませんでした。そちらでフォルダを修正または削除してから、もう一度お試しください。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "c11 не зміг зробити теку hc %2$@ на %1$@ закритою (%3$@), тому не під'єднав її. Виправте або видаліть цю теку там і спробуйте ще раз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "c11이 %1$@에서 hc의 폴더 %2$@을(를) 비공개로 만들지 못해(%3$@) 연결하지 않았습니다. 해당 머신에서 폴더를 고치거나 삭제한 뒤 다시 시도하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "c11 无法将 %1$@ 上 hc 的文件夹 %2$@ 设为私有（%3$@），因此没有连接。请在该机器上修复或删除该文件夹，然后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "c11 無法將 %1$@ 上 hc 的資料夾 %2$@ 設為私人（%3$@），因此沒有連結。請在該機器上修復或移除該資料夾，然後重試。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "c11 не смог сделать папку hc %2$@ на %1$@ закрытой (%3$@), поэтому не стал её подключать. Исправьте или удалите эту папку там и попробуйте снова."
          }
        }
      }
    },
    "machineSetup.consent.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Link %@ to c11?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@をc11にリンクしますか？"
          }
        },
        "uk": {
