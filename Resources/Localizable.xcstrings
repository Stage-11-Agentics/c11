    "settings.app.tabLayout.subtitleTabs": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A strip of panels across the top of each area; the count button opens the full list."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各エリアの上部にパネルを横一列に表示します。件数ボタンで全体の一覧を開きます。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
