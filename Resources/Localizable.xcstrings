    "show.load.insecureHTTP": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "plain HTTP to %@ needs the operator's consent in the viewer; use https or ask the operator"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ へのプレーン HTTP にはビューアでのオペレーターの同意が必要です。https を使うか、オペレーターに依頼してください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@(으)로의 일반 HTTP는 뷰어에서 운영자의 동의가 필요합니다. https를 사용하거나 운영자에게 요청하세요"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "для обычного HTTP к %@ нужно согласие оператора в окне просмотра; используйте https или попросите оператора"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "для звичайного HTTP до %@ потрібна згода оператора у вікні перегляду; використайте https або попросіть оператора"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "到 %@ 的明文 HTTP 需要操作员在查看器中同意；请使用 https 或请操作员处理"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連往 %@ 的明文 HTTP 需要操作員在檢視器中同意；請使用 https 或請操作員處理"
          }
        }
      }
    },
