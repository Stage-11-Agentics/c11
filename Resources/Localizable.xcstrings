    "cli.ssh.controlPath.tooLong": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ssh: the control socket path %@ is too long for a Unix socket; pass --ssh-option ControlPath=<shorter path>"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ssh: コントロールソケットのパス %@ は Unix ソケットとしては長すぎます。--ssh-option ControlPath=<shorter path> を指定してください"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "ssh: шлях керувального сокета %@ задовгий для Unix-сокета; передайте --ssh-option ControlPath=<shorter path>"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "ssh: 컨트롤 소켓 경로 %@이(가) Unix 소켓에 사용하기에는 너무 깁니다. --ssh-option ControlPath=<shorter path>를 지정하세요"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "ssh: 控制套接字路径 %@ 对 Unix 套接字而言太长；请传入 --ssh-option ControlPath=<shorter path>"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "ssh: 控制 socket 路徑 %@ 對 Unix socket 而言太長；請傳入 --ssh-option ControlPath=<shorter path>"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ssh: путь управляющего сокета %@ слишком длинный для Unix-сокета; передайте --ssh-option ControlPath=<shorter path>"
          }
        }
      }
    },
    "cli.ssh.controlFolder.startupRefused": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "c11 ssh: the control socket folder %@ is not a private folder you own; remove it and try again"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "c11 ssh: コントロールソケット用フォルダ %@ は、あなたが所有する非公開フォルダではありません。削除してからやり直してください"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "c11 ssh: папка керувального сокета %@ не є приватною папкою, якою ви володієте; видаліть її та спробуйте ще раз"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "c11 ssh: 컨트롤 소켓 폴더 %@은(는) 본인 소유의 비공개 폴더가 아닙니다. 폴더를 삭제한 후 다시 시도하세요"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "c11 ssh: 控制套接字文件夹 %@ 不是您拥有的私有文件夹；请将其删除后重试"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "c11 ssh: 控制 socket 資料夾 %@ 不是您擁有的私人資料夾；請將其移除後再試一次"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "c11 ssh: папка управляющего сокета %@ не является закрытой папкой, принадлежащей вам; удалите её и повторите попытку"
          }
        }
      }
    },
    "cli.ssh.controlFolder.notPrivate": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ssh: the control socket folder %@ is not a private folder you own; remove it, or pass --ssh-option ControlPath=<path>"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ssh: コントロールソケット用フォルダ %@ は、あなたが所有する非公開フォルダではありません。削除するか、--ssh-option ControlPath=<path> を指定してください"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "ssh: папка керувального сокета %@ не є приватною папкою, якою ви володієте; видаліть її або передайте --ssh-option ControlPath=<path>"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "ssh: 컨트롤 소켓 폴더 %@은(는) 본인 소유의 비공개 폴더가 아닙니다. 폴더를 삭제하거나 --ssh-option ControlPath=<path>를 지정하세요"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "ssh: 控制套接字文件夹 %@ 不是您拥有的私有文件夹；请将其删除，或传入 --ssh-option ControlPath=<path>"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "ssh: 控制 socket 資料夾 %@ 不是您擁有的私人資料夾；請將其移除，或傳入 --ssh-option ControlPath=<path>"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ssh: папка управляющего сокета %@ не является закрытой папкой, принадлежащей вам; удалите её или передайте --ssh-option ControlPath=<path>"
          }
        }
      }
    },
    "cli.ssh.controlFolder.createFailed": {
      "extractionState": "manual",
      "localizations": {
