    "settings.theme.gallery.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Colors the window, the sidebar and the panel title bars. A theme marked + terminal also sets the terminal colors. Each preview is your own window in that theme."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウィンドウ、サイドバー、パネルのタイトルバーの色を変えます。「+ ターミナル」の付いたテーマはターミナルの色も変えます。各プレビューは、そのテーマを適用したあなた自身のウィンドウです。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Змінює кольори вікна, бічної панелі та рядків заголовків панелей. Тема з позначкою + термінал також змінює кольори термінала. Кожен попередній перегляд — це ваше власне вікно з цією темою."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "창, 사이드바, 패널 제목 표시줄의 색을 바꿉니다. + 터미널 표시가 있는 테마는 터미널 색도 함께 바꿉니다. 각 미리보기는 해당 테마를 적용한 내 창입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更改窗口、侧边栏和面板标题栏的颜色。标有 + 终端 的主题还会设置终端颜色。每个预览都是应用该主题后的你自己的窗口。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "更改視窗、側邊欄和面板標題列的顏色。標有 + 終端機 的主題還會設定終端機顏色。每個預覽都是套用該主題後你自己的視窗。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Меняет цвета окна, боковой панели и строк заголовков панелей. Тема с пометкой + терминал также задаёт цвета терминала. Каждый предпросмотр — это ваше собственное окно с этой темой."
          }
        }
      }
    },
