    "settings.app.internalBrowser.subtitleOn": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow creating internal browser panels. Open browser panels keep running when turned off."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "内蔵ブラウザのパネルを作成できます。オフにしても、開いているブラウザのパネルはそのまま動作します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许创建内置浏览器面板。关闭后，已打开的浏览器面板继续运行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "允許建立內建瀏覽器面板。關閉後，已開啟的瀏覽器面板仍會繼續運作。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내장 브라우저 패널을 만들 수 있습니다. 끄더라도 열려 있는 브라우저 패널은 계속 실행됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешает создавать панели встроенного браузера. При отключении уже открытые панели браузера продолжают работать."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дозволяє створювати панелі вбудованого браузера. Після вимкнення вже відкриті панелі браузера продовжують працювати."
          }
        }
      }
    },
    "settings.app.internalBrowser.subtitleOff": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Block new internal browser panels. The Browser spawn button is hidden and CLI/socket creation is rejected."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しい内蔵ブラウザのパネルをブロックします。ブラウザの作成ボタンは非表示になり、CLI/ソケットからの作成も拒否されます。"
          }
