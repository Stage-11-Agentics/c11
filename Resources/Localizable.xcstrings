            "value": "每個區域頂部橫排顯示面板；點擊計數按鈕可開啟完整清單。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ряд панелей вверху каждой области; кнопка со счётчиком открывает полный список."
          }
        }
      }
    },
    "settings.app.tabLayout.subtitleRail": {
      "extractionState": "manual",
      "localizations": {
