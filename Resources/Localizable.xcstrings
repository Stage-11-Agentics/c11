    "mailbox.insights.note.sentTrimmed": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "c11 keeps about the newest %lld sent records, so older sends may not be counted."}},
        "ja": {"stringUnit": {"state": "translated", "value": "c11 は最新の送信記録を約 %lld 件保持するため、それより古い送信は集計されない場合があります。"}},
        "uk": {"stringUnit": {"state": "translated", "value": "c11 зберігає найновіші записи про надіслане (близько %lld), тож старіші можуть не враховуватися."}},
        "ko": {"stringUnit": {"state": "translated", "value": "c11은 최신 발신 기록을 약 %lld개 보관하므로 더 오래된 발신은 집계되지 않을 수 있습니다."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "c11 约保留最新的 %lld 条发送记录，更早的发送可能不计入。"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "c11 約保留最新的 %lld 則傳送記錄，更早的傳送可能不計入。"}},
        "ru": {"stringUnit": {"state": "translated", "value": "c11 хранит новейшие записи об отправленном (около %lld), поэтому более старые могут не учитываться."}}
      }
    },
