          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для сообщения почтового ящика нужен --to или --topic."
          }
        }
      }
    },
    "mailbox.cli.error.surface-not-found": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No panel named %@ in this workspace."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このワークスペースに %@ という名前のパネルはありません。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У цьому робочому просторі немає панелі з назвою %@."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 작업 공간에 %@이라는 패널이 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此工作区中没有名为 %@ 的面板。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此工作區中沒有名為 %@ 的面板。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В этом рабочем пространстве нет панели с именем %@."
          }
        }
      }
    },
    "mailbox.cli.error.topics-not-implemented": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Topic-only envelopes are not delivered in Stage 2 (topic subscribe/fan-out ships in Stage 3). Pair --topic with --to <panel-name> to send now."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トピックのみのメッセージは Stage 2 では配信されません（トピックの購読とファンアウトは Stage 3 で提供されます）。今すぐ送信するには、--topic を --to <panel-name> と組み合わせてください。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Повідомлення лише з темою не доставляються на етапі 2 (підписка на теми й розсилка з’являться на етапі 3). Щоб надіслати зараз, поєднайте --topic з --to <panel-name>."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주제만 지정한 메시지는 Stage 2에서 전달되지 않습니다 (주제 구독/팬아웃은 Stage 3에서 제공). 지금 보내려면 --topic을 --to <panel-name>과 함께 사용하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅含主题的消息在第 2 阶段不会投递（主题订阅/扇出将在第 3 阶段推出）。如需立即发送，请将 --topic 与 --to <panel-name> 搭配使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅指定主題的訊息在第 2 階段不會投遞（主題訂閱與扇出將於第 3 階段推出）。請將 --topic 搭配 --to <panel-name> 即可立即傳送。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сообщения только по теме на этапе 2 не доставляются (подписка на темы и рассылка появятся на этапе 3). Чтобы отправить сейчас, укажите --topic вместе с --to <panel-name>."
          }
        }
      }
    },
    "mailbox.cli.error.unresolved-recipient": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No live panel named \"%@\" in any workspace. Message not sent."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どのワークスペースにも \"%@\" という名前の開いているパネルはありません。メッセージは送信されていません。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жодна відкрита панель із назвою «%@» не знайдена в жодному робочому просторі. Повідомлення не надіслано."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어떤 작업 공간에도 \"%@\"이라는 열린 패널이 없습니다. 메시지를 보내지 않았습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任何工作区中都没有名为“%@”的活动面板。消息未发送。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "任何工作區中都沒有名為「%@」且仍開啟的面板。訊息未傳送。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет открытой панели с именем \"%@\" ни в одном рабочем пространстве. Сообщение не отправлено."
          }
        }
      }
    },
    "mailbox.cli.error.unverified-send": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "c11 unreachable: wrote envelope %@ to your own workspace but could not verify recipient \"%@\" across workspaces. If the recipient is not in your workspace the message will be rejected — run `c11 mailbox trace %@` to confirm delivery."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "c11 unreachable: メッセージ %@ を自分のワークスペースに書き込みましたが、ワークスペース間で宛先 \"%@\" を確認できませんでした。宛先が自分のワークスペースにない場合、メッセージは拒否されます。配信を確認するには `c11 mailbox trace %@` を実行してください。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "c11 недоступний: повідомлення %@ записано у ваш власний робочий простір, але не вдалося перевірити одержувача «%@» в інших робочих просторах. Якщо одержувача немає у вашому робочому просторі, повідомлення буде відхилено — виконайте `c11 mailbox trace %@`, щоб підтвердити доставку."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "c11에 연결할 수 없음: 메시지 %@을(를) 내 작업 공간에 기록했지만 다른 작업 공간의 수신자 \"%@\"을(를) 확인하지 못했습니다. 수신자가 내 작업 공간에 없으면 메시지는 거부됩니다. `c11 mailbox trace %@`를 실행해 전달 여부를 확인하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "c11 无法连接：已将消息 %@ 写入你自己的工作区，但无法跨工作区验证收件人“%@”。如果收件人不在你的工作区中，该消息将被拒绝，请运行 `c11 mailbox trace %@` 确认投递情况。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "c11 無法連線：已將訊息 %@ 寫入你自己的工作區，但無法跨工作區驗證收件者「%@」。若收件者不在你的工作區，訊息將被拒絕。請執行 `c11 mailbox trace %@` 確認是否已投遞。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "c11 недоступен: сообщение %@ записано в ваше собственное рабочее пространство, но получателя \"%@\" в других рабочих пространствах проверить не удалось. Если получателя нет в вашем рабочем пространстве, сообщение будет отклонено — выполните `c11 mailbox trace %@`, чтобы проверить доставку."
          }
        }
      }
    },
    "mailbox.cli.trace.usage": {
      "extractionState": "manual",
      "localizations": {
