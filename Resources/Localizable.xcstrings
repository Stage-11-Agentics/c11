    "settings.flagKinds.evaporate": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Evaporate after seconds"}},
        "ja": {"stringUnit": {"state": "translated", "value": "消えるまでの秒数"}},
        "uk": {"stringUnit": {"state": "translated", "value": "Зняти через (секунд)"}},
        "ko": {"stringUnit": {"state": "translated", "value": "해제까지 시간(초)"}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "自动消除前的秒数"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "自動消除前的秒數"}},
