{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://c11.stage11.ai/spec/usage.v1.schema.json",
  "title": "c11 offline usage output v1",
  "type": "object",
  "required": [
    "schema_version",
    "by",
    "totals",
    "unattributed",
    "groups",
    "coverage_gaps"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "by": {
      "enum": [
        "panel",
        "workspace",
        "model",
        "harness"
      ]
    },
    "since": {
      "type": [
        "string",
        "null"
      ]
    },
    "totals": {
      "$ref": "#/$defs/tokens"
    },
    "unattributed": {
      "$ref": "#/$defs/tokens"
    },
    "groups": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/tokens"
          },
          {
            "type": "object",
            "required": [
              "key",
              "estimated_api_usd"
            ],
            "properties": {
              "key": {
                "type": "string"
              },
              "estimated_api_usd": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              }
            }
          }
        ]
      }
    },
    "coverage_gaps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "pricing_basis": {
      "type": "string"
    }
  },
  "$defs": {
    "tokens": {
      "type": "object",
      "required": [
        "input_tokens",
        "output_tokens",
        "cache_read_tokens",
        "cache_write_5m_tokens",
        "cache_write_1h_tokens",
        "cache_write_unknown_ttl_tokens",
        "reasoning_output_tokens",
        "calls",
        "total_tokens"
      ],
      "properties": {
        "input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "cache_read_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "cache_write_5m_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "cache_write_1h_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "cache_write_unknown_ttl_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "reasoning_output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "calls": {
          "type": "integer",
          "minimum": 0
        },
        "total_tokens": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
