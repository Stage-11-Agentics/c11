    "blueprint.markdown.error.invalidCompanionLink": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "blueprint markdown: invalid companion link '%@'%@ [%@]"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "blueprint markdown: コンパニオンリンク '%@'%@ が無効です [%@]"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "blueprint markdown: недійсне посилання на супутника '%@'%@ [%@]"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "blueprint markdown: 잘못된 컴패니언 링크 '%@'%@ [%@]"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "blueprint markdown: 配套链接“%@”无效%@ [%@]"
          }
