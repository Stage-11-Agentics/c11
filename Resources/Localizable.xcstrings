    "agentConfigEditor.refusal.customCommandEmpty": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A Custom config needs a launch command — open Advanced and give it one, or pick a harness that ships its own."
          }
        },
        "ja": { "stringUnit": { "state": "translated", "value": "カスタム設定には起動コマンドが必要です。「詳細」を開いて入力するか、専用のコマンドを備えた実行環境を選んでください。" } },
        "uk": { "stringUnit": { "state": "translated", "value": "Для власної конфігурації потрібна команда запуску — відкрийте «Додатково» й задайте її або виберіть середовище запуску з власною командою." } },
        "ko": { "stringUnit": { "state": "translated", "value": "사용자 지정 설정에는 실행 명령이 필요합니다. ‘고급’을 열어 명령을 입력하거나 자체 명령이 포함된 실행 환경을 선택하세요." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "自定义配置需要启动命令。请打开“高级”并填写命令，或选择自带启动命令的执行环境。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "自訂設定需要啟動命令。請開啟「進階」並填入命令，或選擇內建啟動命令的執行環境。" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Для пользовательской конфигурации нужна команда запуска — откройте «Дополнительно» и укажите её либо выберите среду запуска со своей командой." } }
      }
    },
