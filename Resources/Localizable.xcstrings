    "cli.socket.overrideRefused": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@=%2$@ is not a c11 socket, so c11 will not use it. A c11 socket is in ~/Library/Application Support/c11/, or in /tmp named c11.sock, c11-*.sock or c11.*.sock. Rename the socket, or pass --socket %3$@ to use this path."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@=%2$@ は c11 のソケットではないため、c11 は使用しません。c11 のソケットは ~/Library/Application Support/c11/ 内、または /tmp にある c11.sock、c11-*.sock、c11.*.sock という名前のものです。ソケットの名前を変更するか、--socket %3$@ を指定してこのパスを使用してください。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@=%2$@ не є сокетом c11, тому c11 його не використовуватиме. Сокет c11 розташований у ~/Library/Application Support/c11/ або в /tmp і називається c11.sock, c11-*.sock чи c11.*.sock. Перейменуйте сокет або вкажіть --socket %3$@, щоб використати цей шлях."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@=%2$@ 은(는) c11 소켓이 아니므로 c11에서 사용하지 않습니다. c11 소켓은 ~/Library/Application Support/c11/ 안에 있거나, /tmp에 c11.sock, c11-*.sock 또는 c11.*.sock 이름으로 있습니다. 소켓 이름을 변경하거나 --socket %3$@ 를 지정하여 이 경로를 사용하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@=%2$@ 不是 c11 套接字，因此 c11 不会使用它。c11 套接字位于 ~/Library/Application Support/c11/ 中，或位于 /tmp 下，名称为 c11.sock、c11-*.sock 或 c11.*.sock。请重命名该套接字，或传入 --socket %3$@ 以使用此路径。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@=%2$@ 不是 c11 通訊端，因此 c11 不會使用它。c11 通訊端位於 ~/Library/Application Support/c11/ 中，或位於 /tmp 下，名稱為 c11.sock、c11-*.sock 或 c11.*.sock。請重新命名該通訊端，或傳入 --socket %3$@ 以使用此路徑。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@=%2$@ не является сокетом c11, поэтому c11 не будет его использовать. Сокет c11 находится в ~/Library/Application Support/c11/ или в /tmp и называется c11.sock, c11-*.sock либо c11.*.sock. Переименуйте сокет или укажите --socket %3$@, чтобы использовать этот путь."
          }
        }
      }
    },
    "cli.skill.package.retired": {
      "extractionState": "manual",
      "localizations": {
