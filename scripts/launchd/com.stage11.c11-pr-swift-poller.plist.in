<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.stage11.c11-pr-swift-poller</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>@HOME@/c11-poller/bin/c11-pr-swift-poller.py</string>
        <string>supervise</string>
        <string>--root</string>
        <string>@HOME@/c11-poller</string>
    </array>
    <key>WorkingDirectory</key>
    <string>@HOME@/c11-poller</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>@HOME@/c11-poller/state/supervisor.log</string>
    <key>StandardErrorPath</key>
    <string>@HOME@/c11-poller/state/supervisor.log</string>
</dict>
</plist>
