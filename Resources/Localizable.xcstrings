    "settings.sidebarBackground.fromTheme": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "From Theme"}},
        "ja": {"stringUnit": {"state": "translated", "value": "テーマから"}},
        "uk": {"stringUnit": {"state": "translated", "value": "З теми"}},
        "ko": {"stringUnit": {"state": "translated", "value": "테마에서"}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "来自主题"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "來自主題"}},
        "ru": {"stringUnit": {"state": "translated", "value": "Из темы"}}
      }
    },
    "settings.sidebarBackground.subtitleOneTheme": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "From Theme draws the theme's own background, or the tint for a theme without one. Sunset Mall and Outrun Horizon replace the theme's background. None always uses the tint."}},
        "ja": {"stringUnit": {"state": "translated", "value": "「テーマから」を選ぶと、テーマ自身の背景が表示されます。背景を持たないテーマではティントが使われます。Sunset Mall と Outrun Horizon は、テーマの背景を置き換えます。「なし」は常にティントを使います。"}},
        "uk": {"stringUnit": {"state": "translated", "value": "«З теми» показує власний фон теми, а для теми без фону — відтінок. Sunset Mall і Outrun Horizon замінюють фон теми. «Немає» завжди використовує відтінок."}},
        "ko": {"stringUnit": {"state": "translated", "value": "'테마에서'는 테마 자체의 배경을 표시하며, 배경이 없는 테마는 색조를 표시합니다. Sunset Mall과 Outrun Horizon은 테마의 배경을 대체합니다. '없음'은 항상 색조를 사용합니다."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "“来自主题”会绘制主题自带的背景；没有背景的主题则显示色调。Sunset Mall 和 Outrun Horizon 会取代主题的背景。“无”始终使用色调。"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "「來自主題」會繪製主題自帶的背景；沒有背景的主題則顯示色調。Sunset Mall 和 Outrun Horizon 會取代主題的背景。「無」一律使用色調。"}},
        "ru": {"stringUnit": {"state": "translated", "value": "«Из темы» рисует собственный фон темы, а для темы без фона — оттенок. Sunset Mall и Outrun Horizon заменяют фон темы. «Нет» всегда использует оттенок."}}
      }
    },
