    "cli.send.guard_refused_guidance": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\nNothing was sent; do not press Enter. If the operator is mid-draft, raise a flag (c11 raise-flag) instead of retrying."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\n何も送信されていません。Enter は押さないでください。オペレーターが入力の途中なら、再試行せずにフラグを立ててください (c11 raise-flag)。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\nНічого не надіслано; не натискайте Enter. Якщо оператор зараз пише чернетку, підніміть прапорець (c11 raise-flag) замість повторної спроби."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\n아무것도 전송되지 않았습니다. Enter 키를 누르지 마세요. 운영자가 입력 중이면 다시 시도하지 말고 플래그(c11 raise-flag)를 올리세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\n未发送任何内容；请勿按 Enter。如果操作者正在输入草稿，请改为举起标记（c11 raise-flag），不要重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\n未傳送任何內容；請勿按 Enter。若操作者正在輸入草稿，請改為升起標記 (c11 raise-flag)，不要重試。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\nНичего не отправлено; не нажимайте Enter. Если оператор в середине набора, поднимите флаг (c11 raise-flag) вместо повторной попытки."
          }
        }
      }
    },
    "cli.send.raw_unavailable": {
