    "settings.browser.import.hint.note.hidden": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The blank-panel import hint is hidden. Turn it back on any time."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "空パネルのインポート案内は非表示です。ここでいつでも再表示できます。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підказку про імпорт на порожній панелі приховано. Увімкніть її знову в будь-який момент."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빈 패널의 가져오기 힌트가 숨겨져 있어요. 언제든 다시 켤 수 있어요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "空白面板上的导入提示已隐藏。随时可重新打开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "空白面板的匯入提示已隱藏。隨時可以重新開啟。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подсказка импорта на пустой панели скрыта. Включите её снова в любой момент."
          }
        }
      }
    },
    "settings.browser.import.hint.note.settingsOnly": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Blank panels are on Settings-only mode from the debug window."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "空パネルはデバッグウィンドウの「設定のみ」モードです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빈 패널이 디버그 창의 설정 전용 모드로 설정되어 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "空白面板通过调试窗口处于「仅设置」模式。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "空白面板目前使用來自除錯視窗的「僅設定」模式。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пустые панели работают в режиме «Только настройки» из окна отладки."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Порожні панелі працюють у режимі «лише налаштування», заданому з вікна зневадження."
          }
        }
      }
    },
    "settings.browser.import.hint.note.visible": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Blank browser panels can show this import suggestion. Hide or re-enable it here."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "空のブラウザーパネルにこのインポート案内を表示できます。ここで非表示や再表示を切り替えられます。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Порожні панелі браузера можуть показувати цю пропозицію імпорту. Приховайте або ввімкніть її тут."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빈 브라우저 패널에 이 가져오기 제안을 표시할 수 있어요. 여기서 숨기거나 다시 활성화하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "空白浏览器面板可以显示这条导入建议。可在此处隐藏或重新启用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "空白的瀏覽器面板可顯示此匯入建議。可在這裡隱藏或重新啟用。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пустые панели браузера могут показывать это предложение импорта. Скройте его или включите снова здесь."
          }
        }
      }
    },
    "settings.browser.import.hint.show": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show import hint on blank browser panels"
          }
        },
        "ja": {
          "stringUnit": {
