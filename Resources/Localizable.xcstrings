    "hc.input.faultAgent": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Input is paused after an interruption. Run c11 retry-input --panel %1$@, then clear the line with c11 send-key --panel %1$@ ctrl+u."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "中断が発生したため、入力を一時停止しています。c11 retry-input --panel %1$@ を実行し、c11 send-key --panel %1$@ ctrl+u で行をクリアしてください。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Введення призупинено після переривання. Виконайте c11 retry-input --panel %1$@, потім очистьте рядок командою c11 send-key --panel %1$@ ctrl+u."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "중단 이후 입력이 일시 중지되었습니다. c11 retry-input --panel %1$@을(를) 실행한 다음 c11 send-key --panel %1$@ ctrl+u(으)로 줄을 지우세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入因中断而暂停。请运行 c11 retry-input --panel %1$@，然后用 c11 send-key --panel %1$@ ctrl+u 清除当前行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輸入因中斷而暫停。請執行 c11 retry-input --panel %1$@，然後用 c11 send-key --panel %1$@ ctrl+u 清除目前這一行。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ввод приостановлен после прерывания. Выполните c11 retry-input --panel %1$@, затем очистите строку командой c11 send-key --panel %1$@ ctrl+u."
          }
        }
      }
    },
    "hc.input.interruptedAgent": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Input interrupted. Some input may have arrived. Previous input will not be sent again. Run c11 retry-input --panel %1$@, then clear the line with c11 send-key --panel %1$@ ctrl+u."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力が中断されました。一部の入力は届いている可能性があります。以前の入力は再送されません。c11 retry-input --panel %1$@ を実行し、c11 send-key --panel %1$@ ctrl+u で行をクリアしてください。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Введення перервано. Частина введеного могла дійти. Попереднє введення не буде надіслано повторно. Виконайте c11 retry-input --panel %1$@, потім очистьте рядок командою c11 send-key --panel %1$@ ctrl+u."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "입력이 중단되었습니다. 일부 입력은 전달되었을 수 있습니다. 이전 입력은 다시 전송되지 않습니다. c11 retry-input --panel %1$@을(를) 실행한 다음 c11 send-key --panel %1$@ ctrl+u(으)로 줄을 지우세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入已中断，部分输入可能已送达。之前的输入不会再次发送。请运行 c11 retry-input --panel %1$@，然后用 c11 send-key --panel %1$@ ctrl+u 清除当前行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輸入已中斷，部分輸入可能已送達。先前的輸入不會再次傳送。請執行 c11 retry-input --panel %1$@，然後用 c11 send-key --panel %1$@ ctrl+u 清除目前這一行。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ввод прерван. Часть ввода могла дойти. Предыдущий ввод не будет отправлен повторно. Выполните c11 retry-input --panel %1$@, затем очистите строку командой c11 send-key --panel %1$@ ctrl+u."
          }
        }
      }
    },
