          "stringUnit": {
            "state": "translated",
            "value": "它们会持续运行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "它們會持續執行。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Они продолжают работать."
          }
        }
      }
    },
    "whatsDifferent.stop.switch.upgrade": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To have Quit end your terminals as c11 1.x did, turn off Keep Terminals After Quit in Settings > General."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "c11 1.xのように「終了」でターミナルも終了させるには、設定 > 一般で「終了後もターミナルを維持」をオフにします。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоб вихід завершував термінали, як у c11 1.x, вимкніть «Зберігати термінали після виходу» в Налаштування > Загальні."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "c11 1.x처럼 종료할 때 터미널도 함께 끝나게 하려면 설정 > 일반에서 “종료 후 터미널 유지”를 끄세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "若要让退出时像 c11 1.x 那样结束你的终端，请在“设置 > 通用”中关闭“退出后保留终端”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "若要讓「結束」像 c11 1.x 一樣結束你的終端機，請在「設定 > 一般」中關閉「結束後保留終端機」。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы выход завершал терминалы, как в c11 1.x, отключите «Сохранять терминалы после выхода» в разделе Настройки > Общие."
          }
        }
      }
    },
    "whatsDifferent.stop.switch": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To have Quit end your terminals too, turn off Keep Terminals After Quit in Settings > General."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「終了」でターミナルも終了させるには、設定 > 一般で「終了後もターミナルを維持」をオフにします。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоб вихід завершував і термінали, вимкніть «Зберігати термінали після виходу» в Налаштування > Загальні."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "종료할 때 터미널도 함께 끝나게 하려면 설정 > 일반에서 “종료 후 터미널 유지”를 끄세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "若要让退出时同样结束你的终端，请在“设置 > 通用”中关闭“退出后保留终端”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "若也要讓「結束」一併結束你的終端機，請在「設定 > 一般」中關閉「結束後保留終端機」。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы выход тоже завершал терминалы, отключите «Сохранять терминалы после выхода» в разделе Настройки > Общие."
          }
        }
      }
    },
