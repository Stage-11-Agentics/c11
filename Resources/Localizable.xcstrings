    "relay.error.notAllowedShow": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is not available through the machine relay. Test with a browser on your own machine, then `c11 show` the result."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ はマシンリレー経由では利用できません。自分のマシンのブラウザでテストしてから、結果を `c11 show` で表示してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@은(는) 머신 릴레이로 사용할 수 없습니다. 자신의 기기에서 브라우저로 테스트한 뒤 결과를 `c11 show`로 표시하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ недоступно через ретранслятор машин. Проверьте в браузере на своей машине, затем покажите результат через `c11 show`."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ недоступно через ретранслятор машин. Перевірте в браузері на власній машині, потім покажіть результат через `c11 show`."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 无法通过机器中继使用。请在你自己的机器上用浏览器测试，然后用 `c11 show` 展示结果。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 無法透過機器中繼使用。請在你自己的機器上用瀏覽器測試，然後用 `c11 show` 展示結果。"
          }
        }
      }
    },
