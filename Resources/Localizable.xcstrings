            "value": "'%@'은(는) 봉투 ID가 아닙니다 (26자 ULID)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' 不是信封 ID (26 个字符的 ULID)"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' 不是信封 ID (26 個字元的 ULID)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' не является идентификатором конверта (26-символьный ULID)"
          }
        }
      }
    },
    "mailbox.status.error.scanLimit": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "the scan limit was reached before envelope %@ was found; it may still exist"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エンベロープ %@ が見つかる前にスキャン上限に達しました。まだ存在する可能性があります"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "ліміт сканування вичерпано до того, як знайдено конверт %@; він може існувати"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "엔벨로프 %@을(를) 찾기 전에 스캔 한도에 도달했습니다. 아직 존재할 수 있습니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在找到信封 %@ 之前已达到扫描上限；它可能仍然存在"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在找到信封 %@ 之前已達到掃描上限；它可能仍然存在"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "лимит сканирования исчерпан до того, как найден конверт %@; он может существовать"
          }
        }
      }
    },
    "mailbox.status.error.notFound": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "no envelope %@ in any workspace's dispatch log or outbox"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どのワークスペースの送出ログにも送信箱にも、エンベロープ %@ はありません"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "конверта %@ немає в журналі відправлень чи вихідних жодного робочого простору"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어떤 워크스페이스의 전송 로그나 발신함에도 봉투 %@이(가) 없음"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任何工作区的派发日志或发件箱中都没有信封 %@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "任何工作區的派發日誌或寄件匣中都沒有信封 %@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "конверта %@ нет ни в журнале отправки, ни в исходящих ни одного рабочего пространства"
          }
        }
      }
    },
    "mailbox.cli.error.unknown-flag": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Unknown flag '%@'."}},
        "ja": {"stringUnit": {"state": "translated", "value": "不明なフラグ '%@'。"}},
        "uk": {"stringUnit": {"state": "translated", "value": "Невідомий прапорець '%@'."}},
        "ko": {"stringUnit": {"state": "translated", "value": "알 수 없는 플래그 '%@'."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "未知标志 '%@'。"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "未知旗標 '%@'。"}},
        "ru": {"stringUnit": {"state": "translated", "value": "Неизвестный флаг '%@'."}}
      }
    },
    "mailbox.cli.error.flag-needs-value": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Flag '%@' requires a value."}},
        "ja": {"stringUnit": {"state": "translated", "value": "フラグ '%@' には値が必要です。"}},
        "uk": {"stringUnit": {"state": "translated", "value": "Прапорець '%@' потребує значення."}},
        "ko": {"stringUnit": {"state": "translated", "value": "플래그 '%@'에는 값이 필요합니다."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "标志 '%@' 需要一个值。"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "旗標 '%@' 需要一個值。"}},
        "ru": {"stringUnit": {"state": "translated", "value": "Флаг '%@' требует значения."}}
      }
    },
    "mailbox.cli.error.flag-no-value": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Flag '%@' does not take a value."}},
        "ja": {"stringUnit": {"state": "translated", "value": "フラグ '%@' は値を取りません。"}},
        "uk": {"stringUnit": {"state": "translated", "value": "Прапорець '%@' не приймає значення."}},
        "ko": {"stringUnit": {"state": "translated", "value": "플래그 '%@'는 값을 받지 않습니다."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "标志 '%@' 不接受值。"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "旗標 '%@' 不接受值。"}},
        "ru": {"stringUnit": {"state": "translated", "value": "Флаг '%@' не принимает значения."}}
      }
    },
    "mailbox.cli.error.duplicate-flag": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Flag '%@' was passed more than once."}},
        "ja": {"stringUnit": {"state": "translated", "value": "フラグ '%@' が複数回指定されました。"}},
        "uk": {"stringUnit": {"state": "translated", "value": "Прапорець '%@' передано більше одного разу."}},
        "ko": {"stringUnit": {"state": "translated", "value": "플래그 '%@'가 두 번 이상 전달되었습니다."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "标志 '%@' 被传递了多次。"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "旗標 '%@' 被傳遞了多次。"}},
        "ru": {"stringUnit": {"state": "translated", "value": "Флаг '%@' передан больше одного раза."}}
      }
    },
    "mailbox.cli.error.admission-refused": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "c11 refused this caller; no envelope was written."}},
        "ja": {"stringUnit": {"state": "translated", "value": "c11 はこの呼び出し元を拒否したため、エンベロープは書き込まれませんでした。"}},
        "uk": {"stringUnit": {"state": "translated", "value": "c11 відхилив цей виклик; конверт не записано."}},
        "ko": {"stringUnit": {"state": "translated", "value": "c11가 이 호출자를 거부하여 봉투를 기록하지 않았습니다."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "c11 拒绝了此调用方；未写入信封。"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "c11 拒絕了此呼叫端；未寫入信封。"}},
        "ru": {"stringUnit": {"state": "translated", "value": "c11 отклонил этот вызов; конверт не записан."}}
      }
    },
    "mailbox.cli.error.body-conflict": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Pass the message as --body or as one trailing argument, not both."}},
        "ja": {"stringUnit": {"state": "translated", "value": "メッセージは --body か末尾の引数のどちらか一方で渡してください。"}},
        "uk": {"stringUnit": {"state": "translated", "value": "Передайте повідомлення як --body або як один кінцевий аргумент, але не обидва."}},
        "ko": {"stringUnit": {"state": "translated", "value": "메시지는 --body 또는 끝의 인자 중 하나만 전달하세요."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "请将消息作为 --body 或一个尾随参数传递，不要同时使用。"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "請將訊息作為 --body 或一個尾隨參數傳遞，不要同時使用。"}},
        "ru": {"stringUnit": {"state": "translated", "value": "Передайте сообщение как --body или как один завершающий аргумент, но не оба сразу."}}
      }
    },
    "mailbox.cli.error.extra-argument": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "mailbox send takes one message. Quote it, or pass --body."}},
        "ja": {"stringUnit": {"state": "translated", "value": "mailbox send はメッセージを1つ取ります。引用符で囲むか、--body を使ってください。"}},
        "uk": {"stringUnit": {"state": "translated", "value": "mailbox send приймає одне повідомлення. Візьміть його в лапки або передайте --body."}},
        "ko": {"stringUnit": {"state": "translated", "value": "mailbox send는 메시지 하나를 받습니다. 따옴표로 감싸거나 --body를 사용하세요."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "mailbox send 只接受一条消息。请用引号括起，或使用 --body。"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "mailbox send 只接受一則訊息。請用引號括起，或使用 --body。"}},
        "ru": {"stringUnit": {"state": "translated", "value": "mailbox send принимает одно сообщение. Заключите его в кавычки или передайте --body."}}
      }
    },
    "mailbox.cli.error.empty-body": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Refusing to send an empty mailbox message. Pass the text, or pass --body-ref for a file."}},
        "ja": {"stringUnit": {"state": "translated", "value": "空のメールボックスメッセージは送信しません。テキストを渡すか、ファイルには --body-ref を使ってください。"}},
        "uk": {"stringUnit": {"state": "translated", "value": "Порожнє повідомлення поштової скриньки не надсилається. Передайте текст або --body-ref для файлу."}},
        "ko": {"stringUnit": {"state": "translated", "value": "빈 메일박스 메시지는 보내지 않습니다. 텍스트를 전달하거나, 파일은 --body-ref로 지정하세요."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "拒绝发送空的邮箱消息。请传入文本，或用 --body-ref 指定文件。"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "拒絕傳送空的信箱訊息。請傳入文字，或用 --body-ref 指定檔案。"}},
        "ru": {"stringUnit": {"state": "translated", "value": "Пустое сообщение почтового ящика не отправляется. Передайте текст или --body-ref для файла."}}
      }
    },
    "mailbox.cli.error.recv-unexpected": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "mailbox recv does not take a trailing argument."}},
        "ja": {"stringUnit": {"state": "translated", "value": "mailbox recv は末尾の引数を取りません。"}},
        "uk": {"stringUnit": {"state": "translated", "value": "mailbox recv не приймає кінцевий аргумент."}},
        "ko": {"stringUnit": {"state": "translated", "value": "mailbox recv는 끝의 인자를 받지 않습니다."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "mailbox recv 不接受尾随参数。"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "mailbox recv 不接受尾隨參數。"}},
        "ru": {"stringUnit": {"state": "translated", "value": "mailbox recv не принимает завершающий аргумент."}}
      }
    },
    "mailbox.cli.error.recv-one-panel": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Pass only one of --panel, --tab, or --surface."}},
        "ja": {"stringUnit": {"state": "translated", "value": "--panel、--tab、--surface のうち1つだけを指定してください。"}},
        "uk": {"stringUnit": {"state": "translated", "value": "Передайте лише один із --panel, --tab або --surface."}},
        "ko": {"stringUnit": {"state": "translated", "value": "--panel, --tab, --surface 중 하나만 전달하세요."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "请只传递 --panel、--tab 或 --surface 中的一个。"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "請只傳遞 --panel、--tab 或 --surface 中的一個。"}},
        "ru": {"stringUnit": {"state": "translated", "value": "Передайте только один из --panel, --tab или --surface."}}
      }
    },
    "mailbox.cli.error.drain-unreadable": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Refusing to mark mailbox messages read because stdout is not a terminal. Run %@"}},
        "ja": {"stringUnit": {"state": "translated", "value": "標準出力が端末ではないため、メールボックスのメッセージを既読にしません。%@ を実行してください。"}},
        "uk": {"stringUnit": {"state": "translated", "value": "Повідомлення поштової скриньки не позначаються прочитаними, бо stdout не є терміналом. Виконайте %@"}},
        "ko": {"stringUnit": {"state": "translated", "value": "stdout이 터미널이 아니므로 메일박스 메시지를 읽음으로 표시하지 않습니다. %@ 를 실행하세요."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "标准输出不是终端，因此拒绝将邮箱消息标为已读。请运行 %@"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "標準輸出不是終端機，因此拒絕將信箱訊息標為已讀。請執行 %@"}},
        "ru": {"stringUnit": {"state": "translated", "value": "Сообщения почтового ящика не помечаются прочитанными, потому что stdout не является терминалом. Выполните %@"}}
      }
    },
    "mailbox.cli.error.workspace-not-set": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "C11_WORKSPACE_ID is not set. Run from a c11 panel or set it for a script."}},
        "ja": {"stringUnit": {"state": "translated", "value": "C11_WORKSPACE_ID が設定されていません。c11 のパネルから実行するか、スクリプト用に設定してください。"}},
        "uk": {"stringUnit": {"state": "translated", "value": "C11_WORKSPACE_ID не задано. Запустіть із панелі c11 або задайте його для скрипта."}},
        "ko": {"stringUnit": {"state": "translated", "value": "C11_WORKSPACE_ID가 설정되지 않았습니다. c11 패널에서 실행하거나 스크립트에 설정하세요."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "未设置 C11_WORKSPACE_ID。请在 c11 面板中运行，或在脚本中设置它。"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "C11_WORKSPACE_ID 未設定。請在 c11 面板中執行，或在腳本中設定它。"}},
        "ru": {"stringUnit": {"state": "translated", "value": "C11_WORKSPACE_ID не задан. Запустите из панели c11 или задайте его для скрипта."}}
      }
    },
    "mailbox.cli.error.panel-id-unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "C11_PANEL_ID is missing or is not a valid panel UUID. Pass --from <panel> to override."}},
        "ja": {"stringUnit": {"state": "translated", "value": "C11_PANEL_ID が未設定か、有効なパネルの UUID ではありません。--from <panel> を指定して上書きしてください。"}},
        "uk": {"stringUnit": {"state": "translated", "value": "C11_PANEL_ID відсутній або не є дійсним UUID панелі. Передайте --from <panel>, щоб перевизначити."}},
        "ko": {"stringUnit": {"state": "translated", "value": "C11_PANEL_ID가 없거나 유효한 패널 UUID가 아닙니다. 재정의하려면 --from <panel>을(를) 전달하세요."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "C11_PANEL_ID 缺失或不是有效的面板 UUID。请传入 --from <panel> 进行覆盖。"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "C11_PANEL_ID 缺失或不是有效的面板 UUID。請傳入 --from <panel> 以覆寫。"}},
        "ru": {"stringUnit": {"state": "translated", "value": "Переменная C11_PANEL_ID отсутствует или не является допустимым UUID панели. Передайте --from <panel>, чтобы переопределить."}}
      }
    },
    "mailbox.cli.error.caller-not-open": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Your panel %@ (`C11_PANEL_ID`) is not open in c11, in any workspace."}},
        "ja": {"stringUnit": {"state": "translated", "value": "あなたのパネル %@（`C11_PANEL_ID`）は、どのワークスペースでも c11 で開かれていません。"}},
        "uk": {"stringUnit": {"state": "translated", "value": "Вашу панель %@ (`C11_PANEL_ID`) не відкрито в c11 в жодному робочому просторі."}},
        "ko": {"stringUnit": {"state": "translated", "value": "사용자의 패널 %@(`C11_PANEL_ID`)이(가) 어떤 작업 공간에서도 c11에 열려 있지 않습니다."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "你的面板 %@（`C11_PANEL_ID`）未在 c11 的任何工作区中打开。"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "你的面板 %@（`C11_PANEL_ID`）未在 c11 的任何工作區中開啟。"}},
        "ru": {"stringUnit": {"state": "translated", "value": "Ваша панель %@ (`C11_PANEL_ID`) не открыта в c11 ни в одном рабочем пространстве."}}
      }
    },
    "mailbox.cli.error.caller-untitled": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Your panel %@ (`C11_PANEL_ID`) has no title. Name it with `c11 rename-panel`, or pass `--from <name>`."}},
        "ja": {"stringUnit": {"state": "translated", "value": "あなたのパネル %@（`C11_PANEL_ID`）にはタイトルがありません。`c11 rename-panel` で名前を付けるか、`--from <name>` を指定してください。"}},
        "uk": {"stringUnit": {"state": "translated", "value": "У вашої панелі %@ (`C11_PANEL_ID`) немає назви. Назвіть її за допомогою `c11 rename-panel` або передайте `--from <name>`."}},
        "ko": {"stringUnit": {"state": "translated", "value": "패널 %@(`C11_PANEL_ID`)에 제목이 없습니다. `c11 rename-panel`로 이름을 지정하거나 `--from <name>`을 전달하세요."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "你的面板 %@（`C11_PANEL_ID`）没有标题。请用 `c11 rename-panel` 为其命名，或传入 `--from <name>`。"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "你的面板 %@（`C11_PANEL_ID`）沒有標題。請用 `c11 rename-panel` 為其命名，或傳入 `--from <name>`。"}},
        "ru": {"stringUnit": {"state": "translated", "value": "У вашей панели %@ (`C11_PANEL_ID`) нет названия. Назовите её с помощью `c11 rename-panel` или передайте `--from <name>`."}}
      }
    },
    "mailbox.drawer.age.ago": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "%@ ago"}},
        "ja": {"stringUnit": {"state": "translated", "value": "%@前"}},
        "uk": {"stringUnit": {"state": "translated", "value": "%@ тому"}},
        "ko": {"stringUnit": {"state": "translated", "value": "%@ 전"}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "%@前"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "%@前"}},
        "ru": {"stringUnit": {"state": "translated", "value": "%@ назад"}}
      }
    },
    "mailbox.drawer.age.now": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "just now"}},
        "ja": {"stringUnit": {"state": "translated", "value": "たった今"}},
        "uk": {"stringUnit": {"state": "translated", "value": "щойно"}},
        "ko": {"stringUnit": {"state": "translated", "value": "방금"}},
