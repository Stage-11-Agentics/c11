[32m+[m[32m            _ = try file.seekToEnd()[m
[32m+[m[32m            handle = file[m
[32m+[m[32m        }[m
[32m+[m[32m    }[m
[32m+[m
[32m+[m[32m    deinit { try? handle?.close() }[m
[32m+[m
[32m+[m[32m    /// Called only while one offered invitation awaits confirmation. Reading[m
[32m+[m[32m    /// is bounded per call; a partial JSON line is retained until its newline.[m
[32m+[m[32m    func observe() throws -> Bool {[m
[32m+[m[32m        if handle == nil, FileManager.default.fileExists(atPath: path) {[m
[32m+[m[32m            handle = try FileHandle(forReadingFrom: URL(fileURLWithPath: path))[m
[32m+[m[32m        }[m
