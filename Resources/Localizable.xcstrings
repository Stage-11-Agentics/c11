    "titlebar.session.notKept.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "This session will not survive a restart. Plain-shell fallback."}},
        "ja": {"stringUnit": {"state": "translated", "value": "このセッションは再起動後には残りません。プレーンシェルへのフォールバックです。"}},
        "uk": {"stringUnit": {"state": "translated", "value": "Цей сеанс не переживе перезапуск. Запасний варіант — звичайна оболонка."}},
        "ko": {"stringUnit": {"state": "translated", "value": "이 세션은 다시 시작하면 사라집니다. 일반 셸로 대체됩니다."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "此会话在重启后不会保留。回退为普通 shell。"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "此工作階段在重新啟動後不會保留。將退回純 shell。"}},
        "ru": {"stringUnit": {"state": "translated", "value": "Этот сеанс не переживёт перезапуск. Запасной вариант: обычная оболочка."}}
      }
    },
    "titlebar.session.reconnecting.help": {
