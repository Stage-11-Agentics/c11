          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 영역 상단에 패널이 가로 한 줄로 표시됩니다. 개수 버튼으로 전체 목록을 엽니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
