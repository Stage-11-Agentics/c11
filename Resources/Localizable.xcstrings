    "machineRemove.none": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No c11 terminals are open on it. c11 unlinks it; you can add it again later."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開いているc11のターミナルはありません。c11がリンクを解除します。あとでもう一度追加できます。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На ній немає відкритих терміналів c11. c11 розірве зв’язок; ви зможете додати її знову пізніше."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "열려 있는 c11 터미널이 없습니다. c11가 연결을 해제하며, 나중에 다시 추가할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其上没有打开的 c11 终端。c11 将取消链接；你以后可以再次添加。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "其上沒有打開的 c11 終端機。c11 將取消連結；你之後可以再次加入。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На ней нет открытых терминалов c11. c11 разорвёт связь; позже вы сможете добавить её снова."
          }
        }
      }
    },
    "machineRemove.endingOne": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This c11 terminal on it will end, with everything it started:"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このマシン上の c11 ターミナルが、開始したすべてのものとともに終了します:"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей термінал c11 на ньому завершиться разом з усім, що він запустив:"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 머신의 c11 터미널이 시작한 모든 것과 함께 종료됩니다:"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其上的这个 c11 终端将与它启动的所有内容一起结束："
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "其上的這個 c11 終端機將與它啟動的所有內容一起結束："
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот терминал c11 на нём завершится вместе со всем, что он запустил:"
          }
        }
      }
    },
    "machineRemove.ending": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These %lld c11 terminals on it will end, with everything they started:"
