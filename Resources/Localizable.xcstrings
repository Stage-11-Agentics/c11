    "machineRemove.removedUnverified": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ removed. c11 couldn't confirm the hc there is its own, so it didn't stop it; it keeps running until it ends there."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ を削除しました。そこで動作している hc が c11 自身のものか確認できなかったため、停止していません。向こうで終了するまで動き続けます。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ вилучено. c11 не зміг підтвердити, що hc там належить йому, тому не зупинив його; він працюватиме там, доки сам не завершиться."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 항목을 제거했습니다. 그곳의 hc가 c11 자체의 것인지 확인하지 못해 중지하지 않았습니다. 그쪽에서 끝날 때까지 계속 실행됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已移除 %@。c11 无法确认那里的 hc 是它自己的，因此没有将其停止；它会在那里继续运行，直到自行结束。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已移除 %@。c11 無法確認那裡的 hc 是它自己的，因此沒有將其停止；它會在那裡繼續執行，直到自行結束。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ удалён. c11 не смог подтвердить, что hc там принадлежит ему, поэтому не остановил его; он продолжит работать там, пока сам не завершится."
          }
        }
      }
    },
    "machineRemove.removedC11hLinkDown": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ removed. Its link was down, so its c11h terminals and c11h's hc there may still run: c11 stops only an hc it installed."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ を削除しました。接続が切れていたため、その c11h のターミナルと c11h の hc がそこで動作し続けている可能性があります。c11 が停止するのは、自身がインストールした hc のみです。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ вилучено. Зв’язок було втрачено, тому термінали c11h і hc від c11h там можуть і далі працювати: c11 зупиняє лише той hc, який сам встановив."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@을(를) 제거했습니다. 연결이 끊어져 있었으므로 해당 머신의 c11h 터미널과 c11h의 hc가 계속 실행 중일 수 있습니다. c11은 자신이 설치한 hc만 중지합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已移除 %@。其连接已断开，因此那里的 c11h 终端和 c11h 的 hc 可能仍在运行：c11 只会停止它自己安装的 hc。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已移除 %@。其連線已中斷，因此那裡的 c11h 終端機和 c11h 的 hc 可能仍在執行：c11 只會停止它自己安裝的 hc。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ удалена. Связь была потеряна, поэтому терминалы c11h и hc от c11h там могут продолжать работать: c11 останавливает только тот hc, который установил сам."
          }
        }
      }
    },
    "machineRemove.removedC11hLink": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ removed; its c11h terminals ended. c11h's hc still runs there with no terminals: c11 stops only an hc it installed."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ を削除しました。その c11h のターミナルは終了しました。c11h の hc はターミナルなしでそこで動作し続けます。c11 が停止するのは、自身がインストールした hc のみです。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ вилучено; його термінали c11h завершено. hc від c11h і далі працює там без терміналів: c11 зупиняє лише той hc, який сам встановив."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@을(를) 제거했습니다. 해당 머신의 c11h 터미널은 종료되었습니다. c11h의 hc는 터미널 없이 그곳에서 계속 실행됩니다. c11은 자신이 설치한 hc만 중지합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已移除 %@；其 c11h 终端已结束。c11h 的 hc 仍在那里运行，但没有终端：c11 只会停止它自己安装的 hc。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已移除 %@；其 c11h 終端機已結束。c11h 的 hc 仍在那裡執行，但沒有終端機：c11 只會停止它自己安裝的 hc。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ удалена; её терминалы c11h завершены. hc от c11h по-прежнему работает там без терминалов: c11 останавливает только тот hc, который установил сам."
          }
        }
      }
    },
    "machineRemove.ambiguous": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ is linked by more than one session (%2$@). Say which link to remove with --session."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ は複数のセッション（%2$@）でリンクされています。削除するリンクは --session で指定してください。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ під'єднано в кількох сеансах (%2$@). Вкажіть, яке з'єднання вилучити, за допомогою --session."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@은(는) 여러 세션(%2$@)에서 링크되어 있습니다. 제거할 링크를 --session으로 지정하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 被多个会话（%2$@）链接。请用 --session 指定要移除哪个链接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 被多個工作階段（%2$@）連結。請用 --session 指定要移除哪個連結。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ связана в нескольких сеансах (%2$@). Укажите, какую ссылку удалить, с помощью --session."
          }
        }
      }
    },
    "machineRemove.noSuchLink": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ has no link in session %2$@; its links are in %3$@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ にはセッション %2$@ のリンクがありません。そのリンクは %3$@ にあります。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ не має з'єднання в сеансі %2$@; його з'єднання є в %3$@."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@은(는) 세션 %2$@에 링크가 없습니다. 해당 링크는 %3$@에 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 在会话 %2$@ 中没有链接；其链接位于 %3$@。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 在工作階段 %2$@ 中沒有連結；其連結位於 %3$@。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У %1$@ нет ссылки в сеансе %2$@; её ссылки есть в %3$@."
          }
        }
      }
    },
    "settings.machines.needsPinCheck": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "c11 won't use this link; hc may still redial it until you Update or Remove it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "c11 はこのリンクを使用しません。「アップデート」または「削除」するまで、hc が再接続を試みる場合があります。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "c11 не використовуватиме це з'єднання. Доки ви не натиснете «Оновити» або «Видалити», hc може намагатися підключитися до нього повторно."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "c11은 이 링크를 사용하지 않습니다. '업데이트'하거나 '제거'할 때까지 hc가 다시 연결을 시도할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
