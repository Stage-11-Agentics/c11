    "notifications.empty.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When an area needs you, it rings here. Tap one to jump to its area."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エリアがあなたを必要とするとき、ここで呼びかけます。クリックするとそのエリアに移動します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "区域有事,便在此叩你。点一下即刻跳到该区域。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "區域有事,便在此叩你。點一下即刻跳到該區域。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "영역이 당신을 필요로 할 때 여기서 울려요. 알림을 클릭하면 해당 영역으로 이동해요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда области нужно ваше внимание, она звенит здесь. Нажмите, чтобы перейти к ней."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Коли область потребує вас, вона гукає сюди. Натисніть, щоб перейти до неї."
          }
        }
      }
    },
