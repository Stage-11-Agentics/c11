        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按 Return 关闭工作区，按 Escape 取消。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按 Return 關閉工作區，按 Escape 取消。"
