    "cli.layout.workspace.required": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Layout commands require --workspace or C11_WORKSPACE_ID; the selected workspace is never used."}},
        "ja": {"stringUnit": {"state": "translated", "value": "レイアウトコマンドには --workspace または C11_WORKSPACE_ID が必要です。選択中のワークスペースは使用されません。"}},
        "uk": {"stringUnit": {"state": "translated", "value": "Команди layout вимагають --workspace або C11_WORKSPACE_ID; вибраний робочий простір ніколи не використовується."}},
        "ko": {"stringUnit": {"state": "translated", "value": "레이아웃 명령에는 --workspace 또는 C11_WORKSPACE_ID가 필요합니다. 선택된 작업 공간은 사용하지 않습니다."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "布局命令需要 --workspace 或 C11_WORKSPACE_ID；绝不会使用当前选中的工作区。"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "layout 指令需要 --workspace 或 C11_WORKSPACE_ID；絕不會使用所選的工作區。"}},
        "ru": {"stringUnit": {"state": "translated", "value": "Команды layout требуют --workspace или C11_WORKSPACE_ID; выбранное рабочее пространство не используется."}}
