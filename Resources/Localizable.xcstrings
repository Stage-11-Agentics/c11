        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Промпт агента не доставлен: %@. Агент не получил задачу."
          }
        }
      }
    },
    "agentLaunch.promptStagingFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't prepare the agent prompt. Check c11's runtime storage permissions and try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントのプロンプトを準備できませんでした。c11 のランタイムストレージの権限を確認して、もう一度お試しください。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося підготувати промпт агента. Перевірте дозволи на сховище середовища виконання c11 і спробуйте ще раз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이전트 프롬프트를 준비할 수 없습니다. c11 런타임 저장소의 권한을 확인한 후 다시 시도하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法准备智能体提示词。请检查 c11 运行时存储的权限后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法準備代理提示。請檢查 c11 執行階段儲存空間的權限，然後再試一次。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось подготовить промпт агента. Проверьте права на хранилище среды выполнения c11 и повторите попытку."
          }
        }
      }
    },
