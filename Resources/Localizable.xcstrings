    "mailbox.conversations.number.unknown": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "This panel is not open, and its number is not known"}},
        "ja": {"stringUnit": {"state": "translated", "value": "このパネルは開かれておらず、番号も不明です"}},
        "uk": {"stringUnit": {"state": "translated", "value": "Ця панель не відкрита, її номер невідомий"}},
