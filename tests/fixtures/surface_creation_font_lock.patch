+// C11H-248 deterministic fixture only. Applied by a local probe patch; not shipped.
+var creation_font_lock_probe_count: usize = 0;
+const CreationFontLockProbe = struct {
+    alloc: Allocator,
+    set: *font.SharedGridSet,
+    key: font.SharedGridSet.Key,
+    grid: *font.SharedGrid,
+    ready: std.Thread.ResetEvent = .{},
+    references: std.atomic.Value(u32) = .init(2),
+
+    fn release(self: *CreationFontLockProbe) void {
+        if (self.references.fetchSub(1, .acq_rel) == 1) self.alloc.destroy(self);
+    }
+
+    fn run(self: *CreationFontLockProbe) void {
+        defer self.release();
+        self.grid.lock.lock();
+        std.debug.print("C11_248_FONT_LOCK_HELD\n", .{});
+        self.ready.set();
+        std.Thread.sleep(1000 * std.time.ns_per_ms);
+        self.grid.lock.unlock();
+        std.debug.print("C11_248_FONT_LOCK_RELEASED\n", .{});
+        self.set.deref(self.key);
+    }
+};
