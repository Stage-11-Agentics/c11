      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How long before a sidebar status pill dims to signal it may be going quiet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サイドバーのステータスピルが薄暗くなり、静かになりつつあることを示すまでの時間。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "侧边栏状态标签变暗、提示其可能正在沉寂之前的时长。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "側邊欄狀態標籤變暗、提示其可能正在沉寂之前的時長。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사이드바 상태 표시가 흐려져 조용해지고 있음을 알리기까지의 시간."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сколько времени пройдёт, прежде чем плашка статуса в боковом меню потускнеет, сигнализируя, что она может затихать."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Скільки часу мине, перш ніж плашка статусу на бічній панелі потьмяніє, сигналізуючи, що вона може затихати."
