      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Agents cannot change the operator's workspace. Raise a flag if you need the operator to switch; background panels remain fully drivable." } },
        "ja": { "stringUnit": { "state": "translated", "value": "エージェントはオペレーターのワークスペースを切り替えられません。切り替えが必要な場合はフラグを立ててください。バックグラウンドのパネルもすべて操作できます。" } },
        "uk": { "stringUnit": { "state": "translated", "value": "Агенти не можуть змінювати робочий простір оператора. Якщо оператору потрібно перейти до іншого простору, підніміть прапорець; фоновими панелями можна повноцінно керувати." } },
        "ko": { "stringUnit": { "state": "translated", "value": "에이전트는 운영자의 작업 공간을 변경할 수 없습니다. 운영자가 전환해야 한다면 플래그를 설정해 알리세요. 백그라운드 패널은 모두 조작할 수 있습니다." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "智能体无法更改操作员的工作区。如需操作员切换，请发出标记提醒；后台面板仍可完整操作。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "代理程式無法更改操作員的工作區。如需操作員切換，請發出標記提醒；背景面板仍可完整操作。" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Агенты не могут менять рабочее пространство оператора. Если оператору нужно переключиться, поднимите флаг; панелями в фоне можно полноценно управлять." } }
      }
    },
    "socket.send.guard_refused": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Input guard refused the send because a %@ is present. Nothing was sent; do not press Enter. If the operator is mid-draft, raise a flag (c11 raise-flag) instead of retrying."}},
        "ja": {"stringUnit": {"state": "translated", "value": "入力ガードは「%@」を検出したため、送信を拒否しました。何も送信されていません。Enter キーを押さないでください。オペレーターが入力途中の場合は再試行せず、c11 raise-flag でフラグを立ててください。"}},
        "uk": {"stringUnit": {"state": "translated", "value": "Захист вводу відхилив надсилання, оскільки виявлено %@. Нічого не надіслано; не натискайте Enter. Якщо оператор ще вводить текст, замість повторної спроби встановіть прапорець командою c11 raise-flag."}},
        "ko": {"stringUnit": {"state": "translated", "value": "입력 보호 기능이 감지된 항목(%@) 때문에 전송을 거부했습니다. 아무것도 전송되지 않았습니다. Enter 키를 누르지 마세요. 운영자가 입력 중이면 다시 시도하지 말고 c11 raise-flag로 플래그를 올리세요."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "输入保护因检测到 %@ 而拒绝发送。未发送任何内容；请勿按 Enter。若操作员正在输入，请使用 c11 raise-flag 设置标记，不要重试。"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "輸入防護因偵測到 %@ 而拒絕傳送。未傳送任何內容；請勿按 Enter。若操作人員正在輸入，請使用 c11 raise-flag 設定標記，不要重試。"}},
        "ru": {"stringUnit": {"state": "translated", "value": "Защита ввода отклонила отправку: обнаружено %@. Ничего не отправлено; не нажимайте Enter. Если оператор набирает текст, вместо повтора установите флаг командой c11 raise-flag."}}
      }
    },
    "socket.send.unconfirmed": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Not submitted: the text was typed and Return was pressed in %@, but the agent did not take it (%@). Do not send the text again. Read the panel first; if the text is still in its composer, submit it with c11 send-key --panel %@ enter."}},
        "ja": {"stringUnit": {"state": "translated", "value": "未送信: %@ にテキストを入力して Return を押しましたが、エージェントは受け付けませんでした（%@）。テキストを再送しないでください。まずパネルを読み取り、テキストがまだ入力欄にある場合は c11 send-key --panel %@ enter で送信してください。"}},
        "uk": {"stringUnit": {"state": "translated", "value": "Не надіслано: текст введено і натиснуто Return у %@, але агент його не прийняв (%@). Не надсилайте текст повторно. Спершу прочитайте панель; якщо текст досі в полі введення, надішліть його командою c11 send-key --panel %@ enter."}},
        "ko": {"stringUnit": {"state": "translated", "value": "제출되지 않음: %@에 텍스트를 입력하고 Return을 눌렀지만 에이전트가 받아들이지 않았습니다(%@). 텍스트를 다시 보내지 마세요. 먼저 패널을 읽고, 텍스트가 아직 입력창에 있으면 c11 send-key --panel %@ enter로 제출하세요."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "未提交：已在 %@ 中输入文本并按下 Return，但代理没有接收（%@）。请勿再次发送该文本。请先读取面板；如果文本仍在输入框中，请使用 c11 send-key --panel %@ enter 提交。"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "未送出：已在 %@ 中輸入文字並按下 Return，但代理程式沒有接收（%@）。請勿再次傳送該文字。請先讀取面板；如果文字仍在輸入框中，請使用 c11 send-key --panel %@ enter 送出。"}},
        "ru": {"stringUnit": {"state": "translated", "value": "Не отправлено: текст набран и нажат Return в %@, но агент его не принял (%@). Не отправляйте текст повторно. Сначала прочитайте панель; если текст всё ещё в поле ввода, отправьте его командой c11 send-key --panel %@ enter."}}
      }
    },
    "socket.send.unconfirmed.composer": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "the text is still in its composer"}},
        "ja": {"stringUnit": {"state": "translated", "value": "テキストがまだ入力欄にあります"}},
        "uk": {"stringUnit": {"state": "translated", "value": "текст досі в полі введення"}},
        "ko": {"stringUnit": {"state": "translated", "value": "텍스트가 아직 입력창에 있습니다"}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "文本仍在输入框中"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "文字仍在輸入框中"}},
        "ru": {"stringUnit": {"state": "translated", "value": "текст всё ещё в поле ввода"}}
