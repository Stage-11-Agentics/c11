          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 스킬은 이제 %2$@ 스킬에 포함되어 있습니다. %3$@을(를) 사용합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 技能现已并入 %2$@ 技能；将使用 %3$@。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 技能現已併入 %2$@ 技能；將使用 %3$@。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Навык %1$@ теперь входит в навык %2$@; используется %3$@."
          }
