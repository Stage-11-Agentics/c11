    "mailbox.conversations.marker.hidden": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "%lld older messages are not shown."}},
        "ja": {"stringUnit": {"state": "translated", "value": "これより古いメッセージ %lld 件は表示されていません。"}},
        "uk": {"stringUnit": {"state": "translated", "value": "Старіші повідомлення не показано: %lld."}},
        "ko": {"stringUnit": {"state": "translated", "value": "이전 메시지 %lld개는 표시되지 않습니다."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "更早的 %lld 条消息未显示。"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "更早的 %lld 則訊息未顯示。"}},
        "ru": {"stringUnit": {"state": "translated", "value": "Более ранние сообщения не показаны: %lld."}}
      }
    },
    "mailbox.conversations.marker.hiddenSides": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "%lld older messages are not shown · %@ left, %@ right"}},
        "ja": {"stringUnit": {"state": "translated", "value": "これより古いメッセージ %lld 件は表示されていません · 左 %@、右 %@"}},
        "uk": {"stringUnit": {"state": "translated", "value": "Старіші повідомлення не показано: %lld · %@ ліворуч, %@ праворуч"}},
        "ko": {"stringUnit": {"state": "translated", "value": "이전 메시지 %lld개는 표시되지 않습니다 · 왼쪽 %@, 오른쪽 %@"}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "更早的 %lld 条消息未显示 · 左侧 %@，右侧 %@"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "更早的 %lld 則訊息未顯示 · 左側 %@，右側 %@"}},
        "ru": {"stringUnit": {"state": "translated", "value": "Более ранние сообщения не показаны: %lld · слева %@, справа %@"}}
      }
    },
    "mailbox.conversations.marker.ledgerFloor": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "This panel's sent record starts %@, %@. Anything %@ sent %@ before then is not recorded, so only %@'s side shows above."}},
        "ja": {"stringUnit": {"state": "translated", "value": "このパネルの送信記録は %@ %@ から始まっています。それより前に %@ が %@ へ送信したものは記録されていないため、上には %@ 側のメッセージのみ表示されます。"}},
        "uk": {"stringUnit": {"state": "translated", "value": "Запис надісланого цією панеллю починається з %@, %@. Усе надіслане від %@ до %@ раніше не записано, тому вище видно лише сторону %@."}},
        "ko": {"stringUnit": {"state": "translated", "value": "이 패널의 발신 기록은 %@ %@부터 시작합니다. 그 전에 %@ → %@ 방향으로 보낸 메시지는 기록되지 않으므로, 위에는 %@ 쪽 메시지만 표시됩니다."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "此面板的发送记录始于 %@ %@。在此之前 %@ 发给 %@ 的消息均无记录，因此上方只显示 %@ 一侧的消息。"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "此面板的傳送記錄始於 %@ %@。在此之前 %@ 傳給 %@ 的訊息均無記錄，因此上方只顯示 %@ 一側的訊息。"}},
        "ru": {"stringUnit": {"state": "translated", "value": "Журнал отправленного этой панелью начинается с %@, %@. Всё, что отправлено от %@ к %@ раньше, не записано, поэтому выше видна только сторона %@."}}
      }
    },
    "mailbox.conversations.marker.nameOnly": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "These messages carry no sender stamp, so c11 keys them by the name %@. It cannot tell which panel, if any, sent them, and never merges them into a panel's conversation. A script that writes envelopes directly looks like this."}},
        "ja": {"stringUnit": {"state": "translated", "value": "これらのメッセージには送信者スタンプがないため、c11 は名前 %@ で分類します。どのパネルが送信したのか（パネルがあるかどうかも）は判別できず、パネルの会話には統合しません。エンベロープを直接書き込むスクリプトはこのように見えます。"}},
        "uk": {"stringUnit": {"state": "translated", "value": "Ці повідомлення не мають позначки відправника, тому c11 розпізнає їх за ім’ям %@. Він не може визначити, яка панель (і чи взагалі панель) їх надіслала, і ніколи не додає їх до розмови панелі. Так виглядає скрипт, що записує конверти напряму."}},
        "ko": {"stringUnit": {"state": "translated", "value": "이 메시지에는 발신자 스탬프가 없어 c11은 이름 %@로 구분합니다. 어떤 패널이 보냈는지(패널이 있는지조차) 알 수 없으며, 패널의 대화에 합치지 않습니다. 봉투를 직접 쓰는 스크립트가 이렇게 보입니다."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "这些消息没有发件方标记，因此 c11 按名称 %@ 归类。它无法判断是哪个面板（若有）发送的，也绝不会将其并入某个面板的对话。直接写入信封的脚本就是这种情况。"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "這些訊息沒有寄件者標記，因此 c11 依名稱 %@ 歸類。它無法判斷是哪個面板（若有）傳送的，也絕不會將其併入某個面板的對話。直接寫入信封的腳本就是這種情況。"}},
        "ru": {"stringUnit": {"state": "translated", "value": "У этих сообщений нет отметки отправителя, поэтому c11 различает их по имени %@. Он не может определить, какая панель (и есть ли она вообще) их отправила, и никогда не включает их в диалог панели. Так выглядит скрипт, который пишет конверты напрямую."}}
      }
    },
    "mailbox.conversations.marker.start": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Start of the record · %@ left, %@ right"}},
        "ja": {"stringUnit": {"state": "translated", "value": "記録の先頭 · 左 %@、右 %@"}},
        "uk": {"stringUnit": {"state": "translated", "value": "Початок запису · %@ ліворуч, %@ праворуч"}},
        "ko": {"stringUnit": {"state": "translated", "value": "기록의 시작 · 왼쪽 %@, 오른쪽 %@"}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "记录开头 · 左侧 %@，右侧 %@"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "記錄開頭 · 左側 %@，右側 %@"}},
        "ru": {"stringUnit": {"state": "translated", "value": "Начало записи · слева %@, справа %@"}}
      }
    },
    "mailbox.conversations.nameOnly": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "NAME ONLY"}},
        "ja": {"stringUnit": {"state": "translated", "value": "名前のみ"}},
        "uk": {"stringUnit": {"state": "translated", "value": "ЛИШЕ ІМ’Я"}},
        "ko": {"stringUnit": {"state": "translated", "value": "이름만"}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "仅名称"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "僅名稱"}},
        "ru": {"stringUnit": {"state": "translated", "value": "ТОЛЬКО ИМЯ"}}
      }
    },
    "mailbox.conversations.note.partial": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Conversations cover the newest %lld of %lld received messages."}},
        "ja": {"stringUnit": {"state": "translated", "value": "会話は、受信した最新の %lld 件（全 %lld 件中）のみが対象です。"}},
        "uk": {"stringUnit": {"state": "translated", "value": "Розмови враховують лише найновіші %lld із %lld отриманих повідомлень."}},
        "ko": {"stringUnit": {"state": "translated", "value": "대화는 받은 메시지 중 최신 %lld개 / 전체 %lld개만 기준으로 합니다."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "对话仅统计收到的最新 %lld 条（共 %lld 条）消息。"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "對話僅統計收到的最新 %lld 則（共 %lld 則）訊息。"}},
        "ru": {"stringUnit": {"state": "translated", "value": "Диалоги учитывают только новейшие %lld из %lld полученных сообщений."}}
      }
    },
    "mailbox.conversations.number.nameOnly": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "No panel: matched by name only"}},
        "ja": {"stringUnit": {"state": "translated", "value": "パネルなし：名前のみで一致"}},
        "uk": {"stringUnit": {"state": "translated", "value": "Немає панелі: збіг лише за ім’ям"}},
        "ko": {"stringUnit": {"state": "translated", "value": "패널 없음: 이름으로만 일치"}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "无面板：仅按名称匹配"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "無面板：僅依名稱比對"}},
        "ru": {"stringUnit": {"state": "translated", "value": "Нет панели: совпадение только по имени"}}
      }
