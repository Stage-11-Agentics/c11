      }
    },
    "blueprint.markdown.error.malformedSplitRatio": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "blueprint markdown: malformed split ratio '%@' (expected `N/M` or `0.<digits>`)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "blueprint markdown: 分割比 '%@' の形式が不正です（`N/M` または `0.<digits>` が必要です）"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "blueprint markdown: некоректне співвідношення розділення '%@' (очікується `N/M` або `0.<digits>`)"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "blueprint markdown: 분할 비율 '%@'의 형식이 잘못되었습니다 (`N/M` 또는 `0.<digits>` 형식이어야 함)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "blueprint markdown: 分割比例“%@”格式有误（应为 `N/M` 或 `0.<digits>`）"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "blueprint markdown: 分割比例「%@」格式錯誤（應為 `N/M` 或 `0.<digits>`）"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "blueprint markdown: неверное соотношение разделения '%@' (ожидается `N/M` или `0.<digits>`)"
          }
        }
      }
    },
    "blueprint.markdown.error.missingChildren": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "blueprint markdown: split node missing `children:` list"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "blueprint markdown: 分割ノードに `children:` リストがありません"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "blueprint markdown: у вузла розділення немає списку `children:`"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "blueprint markdown: 분할 노드에 `children:` 목록이 없습니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "blueprint markdown: 分割节点缺少 `children:` 列表"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "blueprint markdown: 分割節點缺少 `children:` 清單"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "blueprint markdown: в узле разделения нет списка `children:`"
          }
        }
      }
    },
    "blueprint.markdown.error.missingLayoutCodeblock": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "blueprint markdown: `## Layout` section has no fenced YAML codeblock"
          }
        },
        "ja": {
          "stringUnit": {
