        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このc11のビルドには%@がありません。c11を再インストールしてください。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У цій збірці c11 бракує %@. Перевстановіть c11."
