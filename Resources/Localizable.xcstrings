    "agentLaunch.decline.emptyCommand": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This config resolves to an empty command (%@) — set a launch command for it under Edit Launch Agents."
          }
        },
        "ja": { "stringUnit": { "state": "translated", "value": "この設定から解決されたコマンドは空です（%@）。「エージェント起動設定を編集」で起動コマンドを設定してください。" } },
        "uk": { "stringUnit": { "state": "translated", "value": "Ця конфігурація дає порожню команду (%@) — задайте команду запуску в розділі «Редагувати агентів запуску»." } },
        "ko": { "stringUnit": { "state": "translated", "value": "이 설정에서 확인된 명령이 비어 있습니다(%@). ‘에이전트 실행 설정 편집’에서 실행 명령을 설정하세요." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "此配置解析出的命令为空（%@）。请在“编辑智能体启动项”中设置启动命令。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "此設定解析出的命令為空（%@）。請在「編輯代理程式啟動設定」中設定啟動命令。" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Эта конфигурация разрешается в пустую команду (%@) — задайте команду запуска в разделе «Редактировать настройки запуска агентов»." } }
      }
    },
    "agentLaunch.decline.surfaceFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't open a terminal panel for the agent — try again, or use a different area."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェント用のターミナルパネルを開けませんでした — もう一度試すか、別のエリアを使用してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이전트를 위한 터미널 패널을 열 수 없습니다. 다시 시도하거나 다른 영역을 사용해 보세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось открыть панель терминала для агента — повторите попытку или используйте другую область."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося відкрити панель термінала для агента — спробуйте ще раз або скористайтеся іншою областю."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法为代理打开终端面板，请重试，或换一个区域。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法為代理開啟終端機面板，請再試一次，或改用其他區域。"
          }
        }
      }
    },
    "agentLaunch.decline.unresolvableRecipe": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "c11 doesn't know the harness '%@' this config names — pick a known harness under Edit Launch Agents."
          }
        },
        "ja": { "stringUnit": { "state": "translated", "value": "c11 はこの設定が指定する実行環境「%@」を認識できません。「エージェント起動設定を編集」で既知の実行環境を選んでください。" } },
        "uk": { "stringUnit": { "state": "translated", "value": "c11 не розпізнає середовище запуску «%@», указане в цій конфігурації — виберіть відоме середовище в розділі «Редагувати агентів запуску»." } },
        "ko": { "stringUnit": { "state": "translated", "value": "c11은 이 설정에서 지정한 ‘%@’ 실행 환경을 알 수 없습니다. ‘에이전트 실행 설정 편집’에서 지원되는 환경을 선택하세요." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "c11 不认识此配置指定的执行环境“%@”。请在“编辑智能体启动项”中选择已知环境。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "c11 不認識此設定指定的執行環境「%@」。請在「編輯代理程式啟動設定」中選擇已知環境。" } },
        "ru": { "stringUnit": { "state": "translated", "value": "c11 не распознаёт среду запуска «%@», указанную в этой конфигурации — выберите известную среду в разделе «Редактировать настройки запуска агентов»." } }
      }
    },
