    "socket.retry_input.failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Input could not be resumed because the screen did not settle. Try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面が安定しなかったため、入力を再開できませんでした。もう一度お試しください。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося відновити введення, бо екран не стабілізувався. Спробуйте ще раз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면이 안정되지 않아 입력을 재개하지 못했습니다. 다시 시도하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由于屏幕未稳定，无法恢复输入。请重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "由於畫面未穩定，無法恢復輸入。請再試一次。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось возобновить ввод, потому что экран не стабилизировался. Повторите попытку."
          }
        }
      }
    },
    "socket.retry_input.not_paused": {
