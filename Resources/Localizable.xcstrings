    "settings.browser.externalSchemeAllowlist.invalidLine": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Line %1$lld can never match: %2$@. Write the site, then the link type (for example: https://zoom.us zoommtg)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld 行目は一致することがありません: %2$@。サイト、リンクの種類の順で書いてください（例: https://zoom.us zoommtg）。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Рядок %1$lld ніколи не збігатиметься: %2$@. Напишіть сайт, потім тип посилання (наприклад: https://zoom.us zoommtg)."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld번째 줄은 일치할 수 없습니다: %2$@. 사이트, 링크 유형 순서로 입력하세요(예: https://zoom.us zoommtg)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "第 %1$lld 行永远无法匹配：%2$@。请先写网站，再写链接类型（例如：https://zoom.us zoommtg）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "第 %1$lld 行永遠無法比對：%2$@。請先寫網站，再寫連結類型（例如：https://zoom.us zoommtg）。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Строка %1$lld никогда не совпадёт: %2$@. Напишите сайт, затем тип ссылки (например: https://zoom.us zoommtg)."
          }
        }
      }
    },
