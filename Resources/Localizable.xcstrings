        "ja": {"stringUnit": {"state": "translated", "value": "キュー済み、未配信（パネルが接続されていません。エージェントはまだ見ていません）"}},
        "uk": {"stringUnit": {"state": "translated", "value": "у черзі, не доставлено (панель не підключена; агент ще не бачив)"}},
        "ko": {"stringUnit": {"state": "translated", "value": "대기열에 추가됨, 전달되지 않음(패널이 연결되지 않았습니다. 에이전트가 아직 보지 못했습니다)"}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "已排队，未送达（面板未连接；代理尚未看到）"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "已排入佇列，未送達（面板未連接；代理程式尚未看到）"}},
        "ru": {"stringUnit": {"state": "translated", "value": "в очереди, не доставлено (панель не подключена; агент ещё не видел)"}}
      }
    },
