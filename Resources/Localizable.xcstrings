    "settings.machines.add.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Link another Mac over SSH so its terminals open here."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別のMacをSSHでリンクして、そのターミナルをここで開けるようにします。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зв’яжіть інший Mac через SSH, щоб його термінали відкривалися тут."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 Mac을 SSH로 연결하여 해당 터미널을 여기에서 열 수 있도록 합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过 SSH 链接另一台 Mac，让它的终端在这里打开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "透過 SSH 連結另一部 Mac，讓它的終端機在這裡打開。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Свяжите другой Mac по SSH, чтобы его терминалы открывались здесь."
          }
        }
      }
    },
