    "update.error.noInternet.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "c11 can't reach the update server. Check your connection and try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "c11 はアップデートサーバーに接続できません。接続を確認してもう一度試してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "c11 连不上更新服务器。查一下网络,再试一次。"
          }
        },
        "zh-Hant": {
