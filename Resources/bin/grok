#!/usr/bin/env bash
# c11 Grok wrapper - exact durable-session identity for restart/resume.
#
# Grok supports `--session-id <uuid>` for a new conversation and
# `--resume <uuid>` for an existing one. Inside c11 this wrapper injects the
# new UUID, but publishes it to c11 only after Grok creates that UUID's
# session directory (the first real message). Empty sessions remain uncaptured
# and intentionally do not resume.

set -uo pipefail

# C11_AGENT_INTERACTIVE_PID is the positive interactive-agent marker (set
# below only for a launch that reads its terminal). Clear any inherited value
# first so no early exec passes a parent's marker on.
unset C11_AGENT_INTERACTIVE_PID

find_real_grok() {
    local self_dir
    self_dir="$(cd "$(dirname "$0")" && pwd)"
    local IFS=:
    for d in $PATH; do
        [[ "$d" == "$self_dir" ]] && continue
        [[ -x "$d/grok" ]] && printf '%s' "$d/grok" && return 0
    done
    return 1
}

c11_socket_available() {
    local socket="${CMUX_SOCKET_PATH:-}"
    [[ -n "$socket" && -S "$socket" ]] || return 1
    local self_dir c11_bin
    self_dir="$(cd "$(dirname "$0")" && pwd)"
    c11_bin="$self_dir/c11"
    [[ -x "$c11_bin" ]] || c11_bin="$(command -v c11 || true)"
    [[ -n "$c11_bin" ]] || return 1
    CMUXTERM_CLI_RESPONSE_TIMEOUT_SEC=0.75 \
        "$c11_bin" --socket "$socket" ping >/dev/null 2>&1
}

REAL_GROK="$(find_real_grok)" || {
    echo "Error: grok not found in PATH" >&2
    exit 127
}
if [[ -z "${CMUX_SURFACE_ID:-}" || "${CMUX_GROK_HOOKS_DISABLED:-}" == "1" ]] \
    || ! c11_socket_available; then
    exec "$REAL_GROK" "$@"
fi

case "${1:-}" in
    agent|completions|dashboard|doctor|export|help|inspect|leader|login|logout|mcp|memory|models|plugin|sessions|setup|trace|update|version|worktree|wrap|--help|-h|--version|-v)
        exec "$REAL_GROK" "$@"
        ;;
esac
# One-shot forms, including `=` values and short-flag clusters (`-p<prompt>`,
# `-cp`), run without reading the terminal: no c11 lifecycle for them.
for arg in "$@"; do
    case "$arg" in
        --) break ;;
        -p|-p?*|--single|--single=*|--prompt-file|--prompt-file=*|--prompt-json|--prompt-json=*)
            exec "$REAL_GROK" "$@"
            ;;
        -[!-]*p*)
            exec "$REAL_GROK" "$@"
            ;;
    esac
done

# Mark this launch as an interactive agent only when it reads and writes
# its terminal. c11 pushes mailbox messages only to a tab whose
# lifecycle reports carry this PID (exec keeps it), and only while that PID's
# process group owns the terminal.
if [[ -t 0 && -t 1 ]]; then
    export C11_AGENT_INTERACTIVE_PID=$$
fi

self_dir="$(cd "$(dirname "$0")" && pwd)"
c11_bin="$self_dir/c11"
[[ -x "$c11_bin" ]] || c11_bin="$(command -v c11 || true)"

is_uuid() {
    [[ "$1" =~ ^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$ ]]
}

session_id=""
resume_id=""
expect_session_id=0
expect_resume_id=0
continue_latest=0
fork_session=0
for arg in "$@"; do
    if [[ "$expect_session_id" == "1" ]]; then
        session_id="$arg"
        expect_session_id=0
        continue
    fi
    if [[ "$expect_resume_id" == "1" ]]; then
        if [[ "$arg" != -* ]]; then resume_id="$arg"; fi
        expect_resume_id=0
        continue
    fi
    case "$arg" in
        --session-id=*) session_id="${arg#--session-id=}" ;;
        --session-id|-s) expect_session_id=1 ;;
        --resume=*) resume_id="${arg#--resume=}" ;;
        -r=*) resume_id="${arg#-r=}" ;;
        --resume|-r) expect_resume_id=1 ;;
        --continue|-c) continue_latest=1 ;;
        --fork-session) fork_session=1 ;;
    esac
done

capture_id=""
injected_id=0
if [[ "$fork_session" == "1" && -n "$session_id" ]] && is_uuid "$session_id"; then
    capture_id="$session_id"
elif [[ -n "$resume_id" ]] && is_uuid "$resume_id"; then
    capture_id="$resume_id"
elif [[ -n "$session_id" ]] && is_uuid "$session_id"; then
    capture_id="$session_id"
elif [[ "$continue_latest" == "0" && "$expect_resume_id" == "0"
        && -z "$resume_id" && -z "$session_id" ]]; then
    capture_id="$(/usr/bin/uuidgen)"
    injected_id=1
fi

if [[ -n "$c11_bin" ]]; then
    (
        CMUXTERM_CLI_RESPONSE_TIMEOUT_SEC=0.75 \
            "$c11_bin" --socket "${CMUX_SOCKET_PATH}" set-agent --type grok \
            >/dev/null 2>&1
        # A newly opened interactive Grok rests at its prompt. Its outer shell
        # stays "command running" for the TUI's whole life, so seed the agent
        # turn truth here; the session watcher below reports each turn edge.
        CMUXTERM_CLI_RESPONSE_TIMEOUT_SEC=0.75 \
            "$c11_bin" --socket "${CMUX_SOCKET_PATH}" agent-hook idle \
            >/dev/null 2>&1
    ) &
    disown 2>/dev/null || true
fi

# Grok has no hook c11 can attach per launch, but it records each turn in
# its session's events.jsonl (`turn_started` / `turn_ended`). Follow that file
# (read-only) and report the edges as agent-hook working / idle, so c11 knows
# when Grok is mid-turn and when it is back at its prompt. Polls the size,
# rescans a small overlap so an event split across two reads is still seen,
# and reports only state changes. Stops when Grok exits.
grok_watch_turns() {
    local events="$1/events.jsonl" state="" offset=0 size start last next
    while [[ ! -f "$events" ]]; do
        /bin/kill -0 "$wrapped_pid" >/dev/null 2>&1 || return 0
        /bin/sleep 0.25
    done
    while /bin/kill -0 "$wrapped_pid" >/dev/null 2>&1; do
        size="$(/usr/bin/stat -f %z "$events" 2>/dev/null || echo 0)"
        if (( size > offset )); then
            start=$(( offset > 512 ? offset - 512 : 0 ))
            last="$(/usr/bin/tail -c "+$(( start + 1 ))" "$events" 2>/dev/null \
                | /usr/bin/grep -E '"type":"turn_(started|ended)"' | /usr/bin/tail -n 1)"
            offset="$size"
            next=""
            case "$last" in
                *'"type":"turn_started"'*) next="working" ;;
                *'"type":"turn_ended"'*) next="idle" ;;
            esac
            if [[ -n "$next" && "$next" != "$state" ]]; then
                state="$next"
                CMUXTERM_CLI_RESPONSE_TIMEOUT_SEC=0.75 \
                    "$c11_bin" --socket "${CMUX_SOCKET_PATH}" agent-hook "$state" \
                    >/dev/null 2>&1
            fi
        fi
        /bin/sleep 0.5
    done
}

if [[ -n "$c11_bin" && -n "$capture_id" ]]; then
    wrapped_pid="$$"
    (
        sessions_root="${HOME}/.grok/sessions"
        while /bin/kill -0 "$wrapped_pid" >/dev/null 2>&1; do
            session_dir="$(/usr/bin/find "$sessions_root" -type d -name "$capture_id" -print -quit 2>/dev/null || true)"
            if [[ -n "$session_dir" && -d "$session_dir" ]]; then
                payload_dir="$(/usr/bin/mktemp -d /tmp/c11-grok-capture.XXXXXX 2>/dev/null || true)"
                payload_file="${payload_dir}/payload.json"
                if [[ -n "$payload_dir" ]] \
                    && /usr/bin/plutil -create xml1 "$payload_file" >/dev/null 2>&1 \
                    && /usr/bin/plutil -insert session_directory_path -string "$session_dir" "$payload_file" >/dev/null 2>&1 \
                    && /usr/bin/plutil -convert json "$payload_file" >/dev/null 2>&1; then
                    CMUXTERM_CLI_RESPONSE_TIMEOUT_SEC=0.75 \
                        "$c11_bin" --socket "${CMUX_SOCKET_PATH}" \
                        conversation push --kind grok --id "$capture_id" \
                        --source hook --state alive --cwd "$PWD" \
                        --reason "grok persisted exact injected session" \
                        --payload "@${payload_file}" \
                        >/dev/null 2>&1
                fi
                if [[ -n "$payload_dir" ]]; then
                    /bin/unlink "$payload_file" >/dev/null 2>&1 || true
                    /bin/rmdir "$payload_dir" >/dev/null 2>&1 || true
                fi
                grok_watch_turns "$session_dir"
                exit 0
            fi
            /bin/sleep 0.25
        done
    ) &
    disown 2>/dev/null || true
fi

# Native mail (route grok_leader). Grok's hidden `--leader` flag runs this
# TUI's agent in a private leader on a c11-owned socket, with no Grok config.
# The `c11 grok-mailbox` sidecar offers the fixed invitation to the bound
# session through that leader's ACP interface. The sidecar is started here,
# before exec, so it descends from the Grok process. Any skip or failure
# leaves the typed doorbell.
grok_leader_lock() { printf '%s' "${1%.sock}.lock"; }
grok_lsof=/usr/sbin/lsof
[[ -x "$grok_lsof" ]] || grok_lsof=/usr/bin/lsof
# Stop exactly the leader serving this socket: its lock names the PID, and
# that PID must hold the socket. Never `grok leader kill` (it stops them all).
grok_reap_leader() {
    local sock="$1" lock leader_pid
    lock="$(grok_leader_lock "$sock")"
    leader_pid="$(/usr/bin/head -c 32 "$lock" 2>/dev/null | /usr/bin/tr -cd '0-9')"
    if [[ -n "$leader_pid" ]] \
        && "$grok_lsof" -nP -a -p "$leader_pid" -U 2>/dev/null | /usr/bin/grep -qF "$sock"; then
        /bin/kill -TERM "$leader_pid" >/dev/null 2>&1 || true
    fi
    /bin/rm -f "$sock" "$lock" >/dev/null 2>&1 || true
}
# The leader socket lives in the per-user temp directory. A socket path is
# limited to 104 bytes (Grok may add `.daemon` beside it), so an unusually
# long TMPDIR falls back to /tmp.
grok_leader_dir="${TMPDIR:-/tmp}"
grok_leader_dir="${grok_leader_dir%/}"
if (( ${#grok_leader_dir} > 64 )) || [[ ! -d "$grok_leader_dir" || ! -w "$grok_leader_dir" ]]; then
    grok_leader_dir=/tmp
fi
# A wrapper whose watcher died with its panel leaves a leader behind. Reap
# every c11 leader whose Grok is gone.
grok_reap_stale_leaders() {
    local sock owner
    for sock in "$grok_leader_dir"/c11-grok-leader-*.sock; do
        [[ -e "$sock" ]] || continue
        owner="${sock#"$grok_leader_dir"/c11-grok-leader-}"
        owner="${owner%.sock}"
        [[ "$owner" =~ ^[0-9]+$ ]] || continue
        /bin/kill -0 "$owner" >/dev/null 2>&1 && continue
        grok_reap_leader "$sock"
    done
}

# Record why this panel's rings are or are not native, as the panel's
# `mailbox.native_state`; c11 adds it to each typed ring's `_dispatch.log` row.
grok_native_state() {
    [[ -n "$c11_bin" ]] || return 0
    CMUXTERM_CLI_RESPONSE_TIMEOUT_SEC=0.75 \
        "$c11_bin" --socket "${CMUX_SOCKET_PATH}" set-metadata --panel "${CMUX_SURFACE_ID}" \
        --key mailbox.native_state --value "$1" --type string >/dev/null 2>&1
}

grok_native=0
grok_off=""
if [[ -z "${C11_AGENT_INTERACTIVE_PID:-}" ]]; then
    grok_off="off:non_interactive"
elif [[ "${C11_GROK_NATIVE_MAIL_DISABLED:-}" == "1" ]]; then
    grok_off="off:opt_out"
elif [[ -n "${GROK_SANDBOX:-}" ]]; then
    grok_off="off:sandbox"
elif [[ -z "$capture_id" ]]; then
    grok_off="off:no_session"
elif [[ -n "$c11_bin" ]]; then
    grok_native=1
    # The operator's own leader or sandbox choice wins. Grok refuses leader
    # mode under any sandbox profile, so skipping costs nothing there.
    for arg in "$@"; do
        case "$arg" in
            --) break ;;
            --leader|--leader=*|--no-leader|--leader-socket|--leader-socket=*)
                grok_native=0; grok_off="off:operator_leader" ;;
            --sandbox|--sandbox=*)
                grok_native=0; grok_off="off:sandbox" ;;
        esac
    done
fi
# A Grok that no longer accepts --leader would exit on it: probe first.
if [[ "$grok_native" == "1" ]] && ! "$REAL_GROK" --leader --version >/dev/null 2>&1; then
    grok_native=0
    grok_off="off:no_leader_flag"
fi
if [[ -n "$grok_off" && -n "$c11_bin" ]]; then
    ( grok_native_state "$grok_off" ) </dev/null >/dev/null 2>&1 &
    disown 2>/dev/null || true
fi
leader_args=()
if [[ "$grok_native" == "1" ]]; then
    leader_socket="$grok_leader_dir/c11-grok-leader-$$.sock"
    leader_args=(--leader --leader-socket "$leader_socket")
    wrapped_pid="$$"
    ( grok_reap_stale_leaders ) >/dev/null 2>&1 &
    disown 2>/dev/null || true
    (
        grok_native_state grok_leader
        "$c11_bin" --socket "${CMUX_SOCKET_PATH}" grok-mailbox \
            --leader-socket "$leader_socket" --session-id "$capture_id" \
            --grok "$REAL_GROK" --registry "${GROK_HOME:-$HOME/.grok}/active_sessions.json" \
            </dev/null >/dev/null 2>&1
        case $? in
            3) grok_native_state off:no_socket ;;
            4) grok_native_state off:client_failed ;;
            5) grok_native_state off:subscribe_refused ;;
        esac
    ) </dev/null >/dev/null 2>&1 &
    disown 2>/dev/null || true
    (
        while /bin/kill -0 "$wrapped_pid" >/dev/null 2>&1; do /bin/sleep 1; done
        grok_reap_leader "$leader_socket"
    ) </dev/null >/dev/null 2>&1 &
    disown 2>/dev/null || true
fi

if [[ "$injected_id" == "1" ]]; then
    exec "$REAL_GROK" ${leader_args[@]+"${leader_args[@]}"} --session-id "$capture_id" "$@"
fi
exec "$REAL_GROK" ${leader_args[@]+"${leader_args[@]}"} "$@"
