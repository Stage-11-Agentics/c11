    "agentConfigEditor.systemPrompt.none": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "no system-prompt flag on %@ — control disabled (same gating as effort)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ には system-prompt フラグがありません — 操作は無効です (労力と同じ制限)"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "у %@ немає прапорця системного промпту — елемент вимкнено (так само, як і для рівня зусиль)"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에는 시스템 프롬프트 플래그가 없습니다 — 컨트롤이 비활성화됩니다 (effort와 같은 조건)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 没有 system-prompt 标志 — 此控件已停用（与推理强度的限制方式相同）"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 沒有系統提示旗標 — 控制項已停用（與 effort 的限制相同）"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "у %@ нет флага системного промпта — элемент отключён (как и для effort)"
          }
        }
      }
    },
