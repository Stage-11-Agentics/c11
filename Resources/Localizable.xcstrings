    "settings.automation.socketMode.note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Socket modes decide which local processes can drive c11. Automation and password widen access beyond c11-launched processes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ソケットモードは、どのローカルプロセスがc11を操作できるかを決めます。オートメーションとパスワードは、c11から起動したプロセス以外にもアクセスを広げます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "套接字模式决定哪些本地进程可以驱动 c11。自动化和密码模式会将访问范围扩展至 c11 启动的进程之外。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Socket 模式決定哪些本機程序可以驅動 c11。自動化和密碼模式讓 c11 啟動以外的程序也能存取。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "소켓 모드가 c11를 제어할 수 있는 로컬 프로세스를 결정합니다. 자동화 및 비밀번호 모드는 c11가 시작한 프로세스 이상으로 접근을 넓힙니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Режимы сокета определяют, какие локальные процессы могут управлять c11. Режимы автоматизации и пароля расширяют доступ за пределы процессов, запущенных из c11."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Режими сокета визначають, які локальні процеси можуть керувати c11. Режими автоматизації та пароля розширюють доступ за межі процесів, запущених c11."
          }
        }
      }
    },
    "settings.automation.socketOverrides.note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Overrides: C11_SOCKET_ENABLE, C11_SOCKET_MODE, and C11_SOCKET_PATH (set C11_ALLOW_SOCKET_OVERRIDE=1 for stable/nightly builds)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オーバーライド: C11_SOCKET_ENABLE、C11_SOCKET_MODE、C11_SOCKET_PATH（stable/nightlyビルドではC11_ALLOW_SOCKET_OVERRIDE=1を設定）。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "覆盖项：C11_SOCKET_ENABLE、C11_SOCKET_MODE 和 C11_SOCKET_PATH（对稳定版/每日构建版需设置 C11_ALLOW_SOCKET_OVERRIDE=1）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "覆寫設定：C11_SOCKET_ENABLE、C11_SOCKET_MODE 和 C11_SOCKET_PATH（穩定版/每夜版需設定 C11_ALLOW_SOCKET_OVERRIDE=1）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "재정의: C11_SOCKET_ENABLE, C11_SOCKET_MODE, C11_SOCKET_PATH (안정/나이틀리 빌드의 경우 C11_ALLOW_SOCKET_OVERRIDE=1 설정)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переопределения: C11_SOCKET_ENABLE, C11_SOCKET_MODE и C11_SOCKET_PATH (установите C11_ALLOW_SOCKET_OVERRIDE=1 для стабильных/ночных сборок)."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перевизначення: C11_SOCKET_ENABLE, C11_SOCKET_MODE та C11_SOCKET_PATH (встановіть C11_ALLOW_SOCKET_OVERRIDE=1 для stable/nightly-збірок)."
          }
        }
      }
    },
