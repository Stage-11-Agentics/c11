    "machineSetup.error.notConnected": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ was added but its link is %2$@. It will keep retrying; check it in Settings > Herder Topography."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@は追加されましたが、リンクの状態は%2$@です。再試行を続けます。“設定 > マシン”で確認してください。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ додано, але стан зв’язку: %2$@. Спроби триватимуть; перевірте в розділі Параметри > Машини."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@이(가) 추가되었지만 연결 상태가 %2$@입니다. 계속 다시 시도합니다. 설정 > 머신에서 확인하십시오."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 已添加，但其链接状态为%2$@。它会持续重试；请在“设置 > 机器”中查看。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 已加入，但其連結狀態為%2$@。它會持續重試；請在「設定 > 機器」中查看。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ добавлена, но состояние связи: %2$@. Попытки будут продолжаться; проверьте в разделе «Настройки > Машины»."
          }
        }
      }
    },
