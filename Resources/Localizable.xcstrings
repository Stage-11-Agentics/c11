    "mailbox.insights.openConversation.several.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Mail under this name came from more than one sender. Click a sender name in Messages below to open its conversation."}},
        "ja": {"stringUnit": {"state": "translated", "value": "この名前のメールは複数の送信元から届いています。下の「メッセージ」で送信元名をクリックすると、その会話を開きます。"}},
        "uk": {"stringUnit": {"state": "translated", "value": "Пошта під цим іменем надійшла від кількох відправників. Натисніть ім’я відправника в розділі «Повідомлення» нижче, щоб відкрити його розмову."}},
        "ko": {"stringUnit": {"state": "translated", "value": "이 이름의 메일은 여러 보낸 이에게서 왔습니다. 아래 메시지에서 보낸 이 이름을 클릭하면 해당 대화가 열립니다."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "此名称下的邮件来自多个发件方。点击下方“消息”中的发件方名称即可打开其对话。"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "此名稱下的郵件來自多個寄件者。點選下方「訊息」中的寄件者名稱即可開啟其對話。"}},
        "ru": {"stringUnit": {"state": "translated", "value": "Почта под этим именем пришла от нескольких отправителей. Нажмите имя отправителя в разделе «Сообщения» ниже, чтобы открыть его диалог."}}
      }
