    "settings.app.onLaunch.optionNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold Option while c11 starts to choose which workspaces to resume for that launch only."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "c11 の起動中に Option キーを押したままにすると、その起動に限り、再開するワークスペースを選択できます。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Утримуйте Option під час запуску c11, щоб вибрати, які робочі простори відновити, лише для цього запуску."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "c11이 시작되는 동안 Option 키를 누르고 있으면 해당 실행에 한해 재개할 작업 공간을 선택할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 c11 启动时按住 Option 键，可仅为本次启动选择要恢复的工作区。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 c11 啟動時按住 Option 鍵，可僅針對本次啟動選擇要恢復的工作區。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удерживайте Option при запуске c11, чтобы выбрать, какие рабочие пространства возобновить, только для этого запуска."
          }
        }
      }
    },
    "settings.app.onLaunch.subtitleResume": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "c11 reopens every workspace from your last session."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "c11 は前回のセッションのすべてのワークスペースを再び開きます。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "c11 знову відкриває всі робочі простори з вашої останньої сесії."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "c11이 지난 세션의 모든 작업 공간을 다시 엽니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "c11 会重新打开上次会话中的所有工作区。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "c11 會重新開啟上次工作階段中的所有工作區。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "c11 снова открывает все рабочие пространства из вашей последней сессии."
          }
        }
      }
    },
    "settings.app.onLaunch.subtitleAsk": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "c11 lists your last session's workspaces and asks which to bring back."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "c11 は前回のセッションのワークスペースを一覧表示し、復元するものを尋ねます。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "c11 показує робочі простори вашої останньої сесії та запитує, які з них відновити."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "c11이 지난 세션의 작업 공간을 나열하고 복원할 항목을 묻습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "c11 会列出上次会话中的工作区，并询问要恢复哪些。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "c11 會列出上次工作階段中的工作區，並詢問要恢復哪些。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "c11 показывает рабочие пространства вашей последней сессии и спрашивает, какие из них восстановить."
          }
        }
      }
    },
