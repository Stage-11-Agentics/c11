[32m+[m[32mimport Foundation[m
[32m+[m
[32m+[m[32m/// One launch's conversation audit. Restored panels await the phase their own[m
[32m+[m[32m/// resume decision needs, so a slow scrape for one panel never holds back an[m
[32m+[m[32m/// exact causal ref on another.[m
[32m+[m[32m///[m
[32m+[m[32m/// Phases run as one chain of detached tasks:[m
[32m+[m[32m/// - `seeded`: store seed, ownership audit and journal owners, in memory only.[m
[32m+[m[32m/// - `classified`: Codex launch-boundary markers, the recovery policy (dirty:[m
[32m+[m[32m///   check each transcript off the actor; no-resume: mark refs not[m
[32m+[m[32m///   resumable; clean: nothing), and the panels whose decision still depends[m
[32m+[m[32m///   on a scrape.[m
[32m+[m[32m/// - one scrape per kind, collecting only the panels that need it, then its[m
[32m+[m[32m///   commit and, in dirty mode, the transcript check of what it applied.[m
[32m+[m[32m///[m
[32m+[m[32m/// Nothing here writes state because a phase failed or ran long. A failure is[m
[32m+[m[32m/// reported in the `conversation.startup_audit` event and in each affected[m
[32m+[m[32m/// panel's skip reason; persisted refs stay as they were for the next launch.[m
[32m+[m[32mfinal class StartupConversationAudit: @unchecked Sendable {[m
[32m+[m[32m    enum ScrapeOutcome: Sendable, Equatable {[m
[32m+[m[32m        case applied[m
[32m+[m[32m        case failed(String)[m
[32m+[m[32m    }[m
[32m+[m
[32m+[m[32m    struct ScrapeResult: Sendable, Equatable {[m
[32m+[m[32m        let outcome: ScrapeOutcome[m
[32m+[m[32m        let collectMs: Int[m
[32m+[m[32m        let commitMs: Int[m
[32m+[m[32m    }[m
[32m+[m
[32m+[m[32m    /// What `classified` hands a restored panel: the launch's mode, the[m
[32m+[m[32m    /// panels whose decision waits on a scrape, and that scrape per kind.[m
[32m+[m[32m    struct Classification: Sendable {[m
[32m+[m[32m        let mode: ResumeRecoveryMode[m
[32m+[m[32m        let scrapeKindBySurface: [String: String][m
[32m+[m[32m        let scrapes: [String: Task<ScrapeResult, Never>][m
[32m+[m
[32m+[m[32m        func scrape(forSurface surfaceId: String) -> Task<ScrapeResult, Never>? {[m
[32m+[m[32m            scrapeKindBySurface[surfaceId].flatMap { scrapes[$0] }[m
[32m+[m[32m        }[m
[32m+[m[32m    }[m
[32m+[m
[32m+[m[32m    struct Environment: Sendable {[m
[32m+[m[32m        var store: ConversationStore[m
[32m+[m[32m        var pipeline: ScrapeCapturePipeline[m
[32m+[m[32m        var registry: ConversationStrategyRegistry[m
[32m+[m[32m        var filesystem: ConversationFilesystem[m
[32m+[m[32m        var loadLaunchBoundaries: @Sendable (Set<String>) -> [CodexLaunchBoundaryMarker][m
[32m+[m[32m        var refreshOwners: @Sendable () -> Void[m
[32m+[m[32m        var classificationReady: @Sendable () -> Void[m
[32m+[m[32m        var report: @Sendable (StartupConversationAuditReport) -> Void[m
[32m+[m[32m        /// QA seams for a slow or failing scrape (DEBUG builds set them from[m
[32m+[m[32m        /// `C11_DEBUG_STARTUP_SCRAPE_DELAY_SECONDS` / `_FAIL`).[m
[32m+[m[32m        var injectedScrapeDelay: TimeInterval = 0[m
[32m+[m[32m        var injectedScrapeFailure: String?[m
[32m+[m[32m    }[m
[32m+[m
[32m+[m[32m    static let shared = StartupConversationAudit()[m
[32m+[m
[32m+[m[32m    private let lock = NSLock()[m
[32m+[m[32m    private var currentMode: ResumeRecoveryMode = .clean[m
[32m+[m[32m    private var seededTask: Task<Void, Never>?[m
[32m+[m[32m    private var classifiedTask: Task<Classification, Never>?[m
[32m+[m[32m    private var completedTask: Task<StartupConversationAuditReport, Never>?[m
[32m+[m[32m    private var mainSeedWaitMs: Int?[m
[32m+[m
[32m+[m[32m    init() {}[m
[32m+[m
[32m+[m[32m    var mode: ResumeRecoveryMode {[m
