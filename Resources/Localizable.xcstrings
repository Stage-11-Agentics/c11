    "settings.app.closeWorkspaceOnLastSurfaceShortcut": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep Workspace When Last Panel Closes"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最後のパネルを閉じてもワークスペースを残す"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마지막 패널이 닫힐 때 작업 공간 유지"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭最后一个面板时保留工作区"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉最後一個面板時保留工作區"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранять рабочее пространство при закрытии последней панели"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Залишати робочий простір при закритті останньої панелі"
          }
        }
      }
    },
    "settings.app.closeWorkspaceOnLastSurfaceShortcut.subtitleOff": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If the focused panel is the last one, the close-panel shortcut also closes the workspace."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォーカス中のパネルがそのワークスペースの最後の1つなら、パネルを閉じるショートカットはワークスペースも閉じます。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Якщо фокусована панель — остання, скорочення «закрити панель» також закриває робочий простір."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "포커스된 패널이 마지막이면, 패널 닫기 단축키가 작업 공간도 닫습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "若聚焦的面板是工作区的最后一个,关闭面板的快捷键也会关闭该工作区。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "若聚焦中的面板是工作區最後一個,關閉面板的快捷鍵也會關閉該工作區。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если активная панель — последняя, сочетание «закрыть панель» закрывает и рабочее пространство."
          }
        }
      }
    },
    "settings.app.closeWorkspaceOnLastSurfaceShortcut.subtitleOn": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If the focused panel is the last one, the close-panel shortcut still closes only the panel. Close the workspace explicitly with the close-workspace shortcut."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォーカス中のパネルがそのワークスペースの最後の1つでも、パネルを閉じるショートカットはパネルだけを閉じ、ワークスペースは残します。ワークスペースを閉じるショートカットを使うと明示的に閉じられます。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Якщо фокусована панель — остання, скорочення «закрити панель» все одно закриває тільки панель. Закрийте робочий простір явно скороченням «закрити робочий простір»."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "포커스된 패널이 마지막이어도, 패널 닫기 단축키는 패널만 닫습니다. 작업 공간은 작업 공간 닫기 단축키로 명시적으로 닫으세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "即便聚焦的面板是工作区的最后一个,关闭面板的快捷键仍只关闭面板。关闭工作区请使用关闭工作区的快捷键。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "即使聚焦中的面板是工作區最後一個,關閉面板的快捷鍵也只會關閉面板,保留工作區。用關閉工作區的快捷鍵才會明確關閉。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если активная панель — последняя, сочетание «закрыть панель» всё равно закрывает только панель. Рабочее пространство закройте явно сочетанием «закрыть рабочее пространство»."
          }
        }
      }
    },
