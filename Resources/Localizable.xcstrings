    "hc.close.batch.message.one": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This ends 1 terminal session and every process it started, including background and nohup jobs."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ターミナルセッション 1 個と、それが起動したすべてのプロセス（バックグラウンドや nohup のジョブを含む）を終了します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这将结束 1 个终端会话及其启动的所有进程，包括后台任务和 nohup 任务。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這會結束 1 個終端機工作階段及其啟動的所有行程，包括背景工作和 nohup 工作。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "터미널 세션 1개와 그 세션이 시작한 모든 프로세스(백그라운드 및 nohup 작업 포함)가 종료됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Будет завершён 1 терминальный сеанс и все запущенные им процессы, включая фоновые задания и задания nohup."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Буде завершено 1 термінальний сеанс і всі запущені ним процеси, зокрема фонові завдання та завдання nohup."
          }
        }
      }
    },
