    "browser.download.blocked.noGesture": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Blocked a download from %@ that did not follow a click on this page."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このページでのクリックに続かない %@ からのダウンロードをブロックしました。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Заблоковано завантаження з %@, яке не було викликане кліком на цій сторінці."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 페이지에서 클릭한 뒤가 아닌 %@의 다운로드를 차단했습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已阻止 %@ 发起的下载，该下载并非在此页面上点击后触发。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已封鎖 %@ 發起的下載，該下載並非在此頁面上點按後觸發。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заблокирована загрузка с %@, не вызванная щелчком на этой странице."
          }
        }
      }
    },
