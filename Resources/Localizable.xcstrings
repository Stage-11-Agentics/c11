          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "記錄前景、工作區和 App 健康狀態事件。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Записывать события активного окна, рабочих пространств и состояния приложения."
          }
        }
      }
    },
    "settings.activityHistory.keepText": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep message and input text"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メッセージと入力のテキストを保持"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зберігати текст повідомлень і вводу"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메시지 및 입력 텍스트 보관"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保留消息和输入文本"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保留訊息和輸入文字"
          }
        },
        "ru": {
