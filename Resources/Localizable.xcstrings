    "createWorkspace.starter.twoByThree.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Six terminal areas in 2 columns, 3 rows. External 27-inch+ monitor suggested."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ターミナルエリア 6 つを 2 カラム 3 行で。27 インチ以上の外部モニター推奨。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Шість термінальних областей у 2 колонки, 3 рядки. Рекомендовано зовнішній монітор 27 дюймів і більше."
          }
        },
