{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://c11.stage11.ai/spec/usage.v1.schema.json",
  "title": "c11 offline usage output v1",
  "type": "object",
  "required": [
    "schema_version",
    "by",
    "totals",
    "unattributed",
    "groups",
    "coverage_gaps",
    "skipped_counts",
    "unattributed_basis",
    "until",
    "analysis_counts",
    "snapshot_basis"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "by": {
      "enum": [
        "panel",
        "workspace",
        "model",
        "harness"
      ]
    },
    "since": {
      "type": [
        "string",
        "null"
      ]
    },
    "totals": {
      "allOf": [
        {
          "$ref": "#/$defs/tokens"
        },
        {
          "$ref": "#/$defs/cost"
        }
      ]
    },
    "unattributed": {
      "$ref": "#/$defs/tokens"
    },
    "groups": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/tokens"
          },
          {
            "$ref": "#/$defs/cost"
          },
          {
            "type": "object",
            "required": [
              "key",
              "estimated_api_usd"
            ],
            "properties": {
              "key": {
                "type": "string"
              },
              "estimated_api_usd": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              }
            }
          }
        ]
      }
    },
    "coverage_gaps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "pricing_basis": {
      "type": "string"
    },
    "until": {
      "type": [
        "string",
        "null"
      ]
    },
    "unattributed_basis": {
      "type": "string"
    },
    "skipped_counts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "analysis_counts": {
      "type": "object",
      "description": "Aggregate diagnostics without transcript identities. Unproven first-cumulative records and cumulative input-plus-output tokens count only surviving globally deduplicated Codex records.",
      "additionalProperties": {
        "type": "integer"
      }
    },
    "snapshot_basis": {
      "type": "string",
      "description": "Counter chronology, copied-record identity, and snapshot comparison order used for analysis_counts."
    }
  },
  "$defs": {
    "tokens": {
      "type": "object",
      "required": [
        "input_tokens",
        "output_tokens",
        "cache_read_tokens",
        "cache_write_5m_tokens",
        "cache_write_1h_tokens",
        "cache_write_unknown_ttl_tokens",
        "reasoning_output_tokens",
        "calls",
        "total_tokens"
      ],
      "properties": {
        "input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "cache_read_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "cache_write_5m_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "cache_write_1h_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "cache_write_unknown_ttl_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "reasoning_output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "calls": {
          "type": "integer",
          "minimum": 0
        },
        "total_tokens": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "cost": {
      "type": "object",
      "required": [
        "estimated_api_usd",
        "known_api_usd_subtotal",
        "unknown_cost_tokens",
        "unknown_cost_calls",
        "estimated_api_usd_lower_bound",
        "estimated_api_usd_upper_bound"
      ],
      "properties": {
        "estimated_api_usd": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "known_api_usd_subtotal": {
          "type": "number",
          "minimum": 0
        },
        "unknown_cost_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "unknown_cost_calls": {
          "type": "integer",
          "minimum": 0
        },
        "estimated_api_usd_lower_bound": {
          "type": "number",
          "minimum": 0
        },
        "estimated_api_usd_upper_bound": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      }
    }
  }
}
