    "settings.waitingCheck.enabled": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sort finished agents out of Waiting"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完了したエージェントを「待機中」から振り分ける"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відсортовувати завершених агентів з «Очікує»"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "끝난 에이전트를 '대기 중'에서 분류"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将已完成的代理从“等待中”分出"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將已完成的代理從「等待中」分出"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Убирать завершивших агентов из «Ожидает»"
          }
        }
      }
    },
    "settings.waitingCheck.enabled.note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reads each agent's latest reply when its turn ends. A reply whose “Needs you:” line says nothing is finished, not waiting."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ターンの終了時に各エージェントの最新の返信を読み取ります。「Needs you:」の行で何も求めていない返信は、待機中ではなく完了として扱われます。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Після завершення ходу читає останню відповідь кожного агента. Відповідь, у якій рядок «Needs you:» нічого не просить, вважається завершеною, а не очікуванням."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "턴이 끝날 때 각 에이전트의 마지막 답변을 읽습니다. 'Needs you:' 줄에 요청이 없는 답변은 대기 중이 아니라 완료된 것으로 처리합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在每个代理回合结束时读取其最新回复。“Needs you:”一行写明无需任何事项的回复视为已完成,而非等待中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在每個代理回合結束時讀取其最新回覆。「Needs you:」一行寫明無需任何事項的回覆視為已完成,而非等待中。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Читает последний ответ каждого агента, когда его ход заканчивается. Ответ, в котором строка «Needs you:» ничего не просит, считается завершённым, а не ожидающим."
          }
        }
      }
    },
