    "machineSetup.error.updateUnlinked": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ was unlinked to update it, but linking it again failed: %2$@ Add it again with Add Machine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ は更新のためにリンクを解除しましたが、再リンクに失敗しました: %2$@ 「マシンを追加…」でもう一度追加してください。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ було від’єднано для оновлення, але повторне під’єднання не вдалося: %2$@ Додайте його знову через «Додати машину…»."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 업데이트를 위해 연결을 해제했지만 다시 연결하지 못했습니다: %2$@ \"머신 추가…\"로 다시 추가하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 已为更新而取消链接,但重新链接失败:%2$@ 请通过“添加机器…”重新添加。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 已為更新而取消連結,但重新連結失敗:%2$@ 請透過「加入機器…」重新加入。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ был отвязан для обновления, но повторная привязка не удалась: %2$@ Добавьте его снова через «Добавить машину…»."
          }
        }
      }
    },
    "machineSetup.error.updateBusy": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ still has %2$lld c11 terminals open. Updating restarts its hc, which would end them: close them, or Remove the machine and add it again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ では c11 のターミナルが %2$lld 個まだ開いています。アップデートすると hc が再起動され、それらが終了します。ターミナルを閉じるか、マシンを削除してから追加し直してください。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На %1$@ досі відкрито термінали c11: %2$lld. Оновлення перезапустить його hc, і вони завершаться. Закрийте їх або видаліть машину та додайте її знову."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@에 c11 터미널이 %2$lld개 열려 있습니다. 업데이트하면 hc가 다시 시작되어 터미널이 종료됩니다. 터미널을 닫거나 머신을 제거한 뒤 다시 추가하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 上仍打开着 %2$lld 个 c11 终端。更新会重启其 hc 并结束这些终端：请先关闭它们，或移除该机器后重新添加。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 上仍開啟著 %2$lld 個 c11 終端機。更新會重新啟動其 hc 並結束這些終端機：請先關閉它們，或移除該機器後重新加入。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На %1$@ всё ещё открыто терминалов c11: %2$lld. Обновление перезапустит его hc и завершит их. Закройте их или удалите машину и добавьте её снова."
          }
        }
      }
    },
    "machineSetup.error.removeIncomplete": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't end everything c11 runs on %1$@ (%2$@), so it was not removed. Try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ で c11 が実行しているものをすべて終了できなかったため (%2$@)、削除されませんでした。もう一度お試しください。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося завершити все, що c11 запускає на %1$@ (%2$@), тому машину не видалено. Спробуйте ще раз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@에서 c11가 실행 중인 항목을 모두 종료하지 못해(%2$@) 제거되지 않았습니다. 다시 시도하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法结束 c11 在 %1$@ 上运行的全部内容（%2$@），因此未移除。请重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法結束 c11 在 %1$@ 上執行的所有項目（%2$@），因此未移除。請再試一次。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось завершить всё, что c11 запускает на %1$@ (%2$@), поэтому машина не удалена. Повторите попытку."
          }
        }
      }
    },
    "machineRemove.removedUnreachable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ removed. Its link was down, so c11 couldn't end what it runs there; that keeps running until the machine's hc stops."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ を削除しました。接続が切れていたため、c11 はそこで実行中のものを終了できませんでした。マシンの hc が停止するまで実行され続けます。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ видалено. Зв’язок було втрачено, тому c11 не зміг завершити те, що там запущено; воно працюватиме, доки hc на машині не зупиниться."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@을(를) 제거했습니다. 연결이 끊어져 c11가 그곳에서 실행 중인 항목을 종료하지 못했습니다. 해당 머신의 hc가 중지될 때까지 계속 실행됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已移除 %@。其连接已断开，c11 无法结束在那里运行的内容；这些内容会一直运行，直到该机器的 hc 停止。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已移除 %@。其連線已中斷，c11 無法結束在那裡執行的項目；這些項目會持續執行，直到該機器的 hc 停止。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ удалена. Связь была потеряна, поэтому c11 не смог завершить то, что там запущено; оно продолжит работать, пока hc на машине не остановится."
          }
        }
      }
    },
    "machineSetup.step.reach": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reach the machine over SSH"
