        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "소리 없는 배너. 플래그는 계속 소리가 납니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示横幅，无声音。标记仍会发出声音。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示橫幅，無聲音。標記仍會發出聲音。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Баннеры без звука. Отметки по-прежнему со звуком."
          }
        }
      }
    },
    "notificationLevel.normal.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Banners and sound for turn ends and asks."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ターン終了と質問のときにバナーとサウンドで通知します。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Банер і звук, коли агент завершує хід або запитує."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "턴이 끝나거나 질문할 때 배너와 소리로 알립니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
