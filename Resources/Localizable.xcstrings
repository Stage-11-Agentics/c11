    "settings.app.keepTerminalsAfterQuit.on": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminals, agents and jobs keep running after c11 quits, and come back when you open it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "c11を終了しても、ターミナル、エージェント、ジョブは動き続け、c11を開くと元に戻ります。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Термінали, агенти й завдання продовжують працювати після виходу з c11 і повертаються, коли ви його відкриєте."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "c11을 종료해도 터미널, 에이전트, 작업은 계속 실행되며 c11을 다시 열면 돌아옵니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "c11 退出后，终端、智能体和任务会继续运行，再次打开 c11 时会回到原处。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "終端機、代理和工作會在 c11 結束後繼續執行，並在你重新打開時回來。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Терминалы, агенты и задачи продолжат работать после выхода из c11 и вернутся, когда вы снова его откроете."
          }
        }
      }
    },
    "settings.app.keepTerminalsAfterQuit.off": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quitting c11 ends every terminal on this Mac and the jobs inside them."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "c11を終了すると、このMac上のすべてのターミナルと、その中のジョブが終了します。"
