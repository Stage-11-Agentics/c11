    "workspaceGroup.deleteHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove the group and keep all member workspaces running, ungrouped."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "グループを削除し、メンバーのワークスペースは実行したままグループから外します。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Видаліть групу, залишивши всі робочі простори-учасники запущеними й без групи."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그룹을 삭제하고 모든 구성 워크스페이스는 실행 중인 채 그룹에서 해제합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除该组，同时保持所有成员工作区运行并移出该组。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "刪除群組，同時讓所有成員工作區保持執行並解除群組。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалить группу, оставив все входящие в неё рабочие пространства запущенными и без группы."
          }
        }
      }
    },
    "workspaceGroup.accessibility.empty": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Empty group. Add a workspace to focus it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "空のグループです。ワークスペースを追加してフォーカスしてください。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Група порожня. Додайте робочий простір, щоб перейти до нього."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그룹이 비어 있습니다. 포커스할 워크스페이스를 추가하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "组为空。添加工作区以便聚焦。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
