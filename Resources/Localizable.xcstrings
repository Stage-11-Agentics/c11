        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "常にフルカードで表示し、収まらない場合はサイドバーをスクロールします。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "始终显示完整卡片；放不下时侧边栏可滚动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一律顯示完整卡片；放不下時側邊欄可捲動。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "항상 전체 카드로 표시하며, 들어가지 않으면 사이드바가 스크롤됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всегда полные карточки; если они не помещаются, боковое меню прокручивается."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Завжди повні картки; бічна панель прокручується, коли вони не вміщуються."
          }
        }
      }
    },
