[32m+[m
[32m+[m[32m/// One renderer's WKWebView, shared by every SwiftUI host of its panel. Split[m
[32m+[m[32m/// and area churn can build a replacement host, sometimes off-window, while the[m
[32m+[m[32m/// visible one stays mounted. A host takes the web view only while it is in a[m
[32m+[m[32m/// window, and a host that leaves its window gives it back to one still showing,[m
[32m+[m[32m/// so a discarded replacement never leaves the visible reader empty (C11-485).[m
[32m+[m[32mfinal class MarkdownWebViewContainer: NSView {[m
[32m+[m[32m    let webView: MarkdownWKWebView[m
[32m+[m
[32m+[m[32m    init(webView: MarkdownWKWebView) {[m
[32m+[m[32m        self.webView = webView[m
[32m+[m[32m        super.init(frame: .zero)[m
[32m+[m[32m        webView.hostContainers.add(self)[m
[32m+[m[32m    }[m
[32m+[m
[32m+[m[32m    @available(*, unavailable)[m
[32m+[m[32m    required init?(coder: NSCoder) { fatalError("init(coder:) has not been implemented") }[m
[32m+[m
[32m+[m[32m    var holdsWebView: Bool { webView.superview === self }[m
[32m+[m
[32m+[m[32m    /// In a visible window and not hidden. A closed window that is still alive[m
[32m+[m[32m    /// does not count.[m
[32m+[m[32m    var isShowing: Bool {[m
[32m+[m[32m        guard let window, window.isVisible else { return false }[m
[32m+[m[32m        return !isHiddenOrHasHiddenAncestor[m
[32m+[m[32m    }[m
[32m+[m
[32m+[m[32m    /// A host that just joined a window is the one SwiftUI is showing, so it[m
[32m+[m[32m    /// takes the web view even from a host that has not left yet. That move is[m
[32m+[m[32m    /// safe because the old parent sits in another subtree; a host that is[m
[32m+[m[32m    /// leaving is mid-removal itself, so it hands off on the next turn.[m
[32m+[m[32m    override func viewDidMoveToWindow() {[m
[32m+[m[32m        super.viewDidMoveToWindow()[m
[32m+[m[32m        if window != nil {[m
[32m+[m[32m            claim(reason: "joined")[m
[32m+[m[32m        } else if holdsWebView {[m
[32m+[m[32m            DispatchQueue.main.async { [webView] in webView.returnToVisibleHost() }[m
[32m+[m[32m        }[m
[32m+[m[32m    }[m
[32m+[m
[32m+[m[32m    override func layout() {[m
[32m+[m[32m        super.layout()[m
[32m+[m[32m        claimIfOrphaned()[m
[32m+[m[32m        if holdsWebView, webView.frame != bounds { webView.frame = bounds }[m
[32m+[m[32m    }[m
[32m+[m
[32m+[m[32m    /// Takes the web view only when no showing host holds it.[m
[32m+[m[32m    func claimIfOrphaned() {[m
[32m+[m[32m        guard isShowing, !holdsWebView, !webView.isShownByHost else { return }[m
[32m+[m[32m        claim(reason: "orphaned")[m
[32m+[m[32m    }[m
[32m+[m
[32m+[m[32m    func claim(reason: String) {[m
[32m+[m[32m        guard window != nil, !holdsWebView else { return }[m
[32m+[m[32m#if DEBUG[m
[32m+[m[32m        dlog("markdown.host.claim reason=\(reason) host=\(ObjectIdentifier(self).hashValue) from=\(webView.superview.map { ObjectIdentifier($0).hashValue } ?? 0) fromInWindow=\(webView.window == nil ? 0 : 1)")[m
[32m+[m[32m#endif[m
[32m+[m[32m        webView.removeFromSuperview()[m
[32m+[m[32m        webView.frame = bounds[m
[32m+[m[32m        webView.autoresizingMask = [.width, .height][m
[32m+[m[32m        addSubview(webView)[m
[32m+[m[32m    }[m
[32m+[m[32m}[m
[32m+[m
[32m+[m[32mextension MarkdownWKWebView {[m
[32m+[m[32m    var isShownByHost: Bool { (superview as? MarkdownWebViewContainer)?.isShowing == true }[m
[32m+[m
[32m+[m[32m    func returnToVisibleHost() {[m
[32m+[m[32m        guard !isShownByHost else { return }[m
[32m+[m[32m        let host = hostContainers.allObjects.first { $0.isShowing }[m
[32m+[m[32m#if DEBUG[m
[32m+[m[32m        dlog("markdown.host.handBack found=\(host == nil ? 0 : 1) hosts=\(hostContainers.count)")[m
[32m+[m[32m#endif[m
[32m+[m[32m        host?.claim(reason: "handBack")[m
[32m+[m[32m    }[m
 }[m
 [m
