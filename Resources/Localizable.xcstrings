    "tabRailTip.undoBody": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "This area's panel list stays open on the left. Undo puts Strip back." } },
        "ja": { "stringUnit": { "state": "translated", "value": "このエリアでは、パネル一覧が左側に開いたままになります。元に戻すと「横並び」に戻ります。" } },
        "uk": { "stringUnit": { "state": "translated", "value": "Список панелей цієї області залишається відкритим ліворуч. «Скасувати» поверне горизонтальне розташування." } },
        "ko": { "stringUnit": { "state": "translated", "value": "이 영역의 패널 목록은 왼쪽에 열린 상태로 유지됩니다. 실행 취소하면 ‘가로형’ 보기로 돌아갑니다." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "此区域的面板列表会保持在左侧打开。撤销后将恢复为“横排”。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "此區域的面板清單會保持在左側開啟。復原後會恢復為「橫排」。" } },
        "ru": { "stringUnit": { "state": "translated", "value": "В этой области список панелей остаётся открытым слева. «Отменить» вернёт горизонтальное расположение." } }
      }
    },
