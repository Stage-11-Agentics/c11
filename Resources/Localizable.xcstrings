    "sidebar.themeLegend": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "─ legend ─  ◆ needs you  ▶ running  □ idle  ▪ cold"}},
        "ja": {"stringUnit": {"state": "translated", "value": "─ 凡例 ─  ◆ 要対応  ▶ 実行中  □ アイドル  ▪ 停止中"}},
        "uk": {"stringUnit": {"state": "translated", "value": "─ легенда ─  ◆ потрібні ви  ▶ працює  □ простій  ▪ неактивний"}},
        "ko": {"stringUnit": {"state": "translated", "value": "─ 범례 ─  ◆ 확인 필요  ▶ 실행 중  □ 유휴  ▪ 비활성"}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "─ 图例 ─  ◆ 需要你  ▶ 运行中  □ 空闲  ▪ 未启用"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "─ 圖例 ─  ◆ 需要你  ▶ 執行中  □ 閒置  ▪ 未啟用"}},
        "ru": {"stringUnit": {"state": "translated", "value": "─ легенда ─  ◆ нужны вы  ▶ работает  □ простой  ▪ неактивен"}}
      }
