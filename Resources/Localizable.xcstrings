    "settings.interfaceSize.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How big c11 draws the sidebar and the title bar above each panel: their text, tags and spacing. Terminal text has its own size: Area > Increase Font Size."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "c11 がサイドバーと各パネル上部のタイトルバーを描画するときの大きさ（文字、タグ、余白）です。ターミナルの文字には別のサイズがあります: エリア > フォントサイズを拡大。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Наскільки великими c11 малює бічну панель і рядок заголовка над кожною панеллю: їхній текст, теги та відступи. Текст термінала має власний розмір: Область > Збільшити розмір шрифту."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "c11가 사이드바와 각 패널 위의 제목 표시줄을 얼마나 크게 그릴지 정합니다. 글자, 태그, 간격이 포함됩니다. 터미널 글자는 크기가 따로 있습니다: 영역 > 글꼴 크기 확대."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "c11 绘制侧边栏和每个面板上方标题栏的大小，包括文字、标签和间距。终端文字有单独的大小设置：区域 > 增大字体大小。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "c11 繪製側邊欄和每個面板上方標題列的大小，包括文字、標籤和間距。終端機文字有單獨的大小設定：區域 > 放大字型大小。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Насколько крупно c11 рисует боковую панель и строку заголовка над каждой панелью: их текст, теги и отступы. У текста терминала свой размер: Область > Увеличить размер шрифта."
          }
        }
      }
    },
    "settings.section.theme": {
