    },
    "machineSetup.error.core": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "c11's hc on this Mac isn't answering (%@). Open c11 and try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMacのc11のhcが応答していません(%@)。c11を開いて、もう一度お試しください。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "hc від c11 на цьому Mac не відповідає (%@). Відкрийте c11 і повторіть спробу."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac의 c11 hc가 응답하지 않습니다(%@). c11를 열고 다시 시도하십시오."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 Mac 上 c11 的 hc 没有响应（%@）。请打开 c11 并重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這部 Mac 上 c11 的 hc 沒有回應（%@）。請打開 c11 並再試一次。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "hc от c11 на этом Mac не отвечает (%@). Откройте c11 и повторите попытку."
          }
        }
      }
    },
