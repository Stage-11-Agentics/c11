    "socket.sidebar.state.targetRequired": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "sidebar.state requires a workspace or panel target; selected-workspace fallback is disabled"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "sidebar.state にはワークスペースまたはパネルの対象が必要です。選択中のワークスペースへのフォールバックは無効です"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "sidebar.state вимагає цілі — робочого простору або панелі; перехід до вибраного робочого простору вимкнено"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "sidebar.state에는 작업 공간 또는 패널 대상이 필요합니다. 선택된 작업 공간으로의 대체는 비활성화되어 있습니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "sidebar.state 需要工作区或面板作为目标；已禁用回退到选中工作区"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "sidebar.state 需要工作區或面板作為目標；已停用退回使用所選工作區的行為"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "sidebar.state требует в качестве цели рабочее пространство или панель; переход к выбранному рабочему пространству отключён"
          }
        }
      }
    },
    "socket.tabRef.empty.noSelectedFallback": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A panel reference was provided but empty; pass a concrete id (no selected-context fallback)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パネルの参照が指定されましたが空です。具体的な ID を指定してください (選択中のコンテキストへのフォールバックはありません)。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Посилання на панель передано, але воно порожнє; вкажіть конкретний id (без переходу до вибраного контексту)."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "패널 참조가 전달되었지만 비어 있습니다. 구체적인 id를 전달하세요 (선택된 컨텍스트로 대체하지 않음)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提供了面板引用但其为空；请传入具体的 ID（不会回退到选中的上下文）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已提供面板參照，但內容為空；請傳入具體的 id（不會退回使用所選的情境）。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ссылка на панель указана, но пуста; передайте конкретный id (без перехода к выбранному контексту)."
          }
        }
      }
    },
