        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shares anonymized crash and usage data to improve c11."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "c11 を改善するため、匿名化されたクラッシュと使用状況データを共有します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分享匿名的崩溃和使用数据以改进 c11。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "分享匿名的當機與使用資料來改善 c11。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "c11 개선을 위해 익명화된 충돌 및 사용 데이터를 공유합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отправляет анонимные данные о сбоях и использовании для улучшения c11."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ділиться анонімізованими даними про збої та використання, щоб покращити c11."
          }
        }
      }
    },
