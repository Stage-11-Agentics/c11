    "machineSetup.secure.invalidReport": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "the machine's folder report was not valid"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
