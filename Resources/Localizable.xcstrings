      }
    },
    "settings.flagKinds.evaporateHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Lower this kind's flags after you look at the flagged panel for this many seconds (1 to 600). Leave blank to keep them until lowered."}},
        "ja": {"stringUnit": {"state": "translated", "value": "フラグが付いたパネルをこの秒数(1~600)見ると、この種類のフラグを下ろします。空欄の場合は、下ろすまで保持されます。"}},
        "uk": {"stringUnit": {"state": "translated", "value": "Знімати позначки цього виду, коли ви дивитеся на позначену панель задану кількість секунд (від 1 до 600). Залиште поле порожнім, щоб позначки трималися, доки їх не знімуть."}},
        "ko": {"stringUnit": {"state": "translated", "value": "플래그가 지정된 패널을 이 시간(1~600초) 동안 보면 이 종류의 플래그를 내립니다. 비워 두면 내리기 전까지 유지됩니다."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "在您查看已标记面板达到此秒数(1 到 600)后，自动取消该类型的标记。留空则保留到手动取消为止。"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "在您查看已標記面板達到此秒數(1 到 600)後，自動取消該類型的旗標。留空則保留到手動取消為止。"}},
        "ru": {"stringUnit": {"state": "translated", "value": "Снимать флаги этого вида, когда вы смотрите на помеченную панель заданное число секунд (от 1 до 600). Оставьте поле пустым, чтобы флаги сохранялись, пока их не снимут."}}
      }
    },
    "settings.flagKinds.evaporatePlaceholder": {
