    "whatsDifferent.picture.noMachines": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No other machine is linked yet. The c11 install guide shows how to add one."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほかのマシンはまだ接続されていません。追加方法はc11のインストールガイドをご覧ください。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Інші комп’ютери ще не під’єднано. Як додати комп’ютер, описано в посібнику зі встановлення c11."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 연결된 다른 컴퓨터가 없습니다. 추가하는 방법은 c11 설치 안내서에서 확인하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未连接其他设备。c11 安装指南介绍了如何添加。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未連結其他機器。c11 安裝指南會說明如何新增。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Другие компьютеры пока не подключены. Как добавить компьютер, описано в руководстве по установке c11."
          }
        }
      }
    },
