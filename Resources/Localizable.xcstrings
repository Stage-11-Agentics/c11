      }
    },
    "whatsDifferent.adopted.name.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app, the `c11` command and the `C11_` variables use c11's names, and updates come from c11's feed. The %@ names still work."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリ、`c11` コマンド、`C11_` 変数はc11の名前を使い、アップデートはc11のフィードから届きます。%@の名前も引き続き使えます。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Застосунок, команда `c11` і змінні `C11_` мають імена c11, а оновлення надходять із каналу c11. Імена %@ усе ще працюють."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱, `c11` 명령, `C11_` 변수는 c11의 이름을 사용하고, 업데이트는 c11의 피드에서 옵니다. %@ 이름도 계속 작동합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用、`c11` 命令和 `C11_` 变量都使用 c11 的名称，更新来自 c11 的更新源。%@ 的名称仍然可用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "App、`c11` 指令和 `C11_` 變數都使用 c11 的名稱，更新來自 c11 的更新來源。%@ 的名稱仍然可用。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложение, команда `c11` и переменные `C11_` носят имена c11, а обновления приходят из канала c11. Имена %@ по-прежнему работают."
          }
        }
      }
    },
    "whatsDifferent.adopted.name.lead": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One name."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前はひとつ。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Одне ім’я."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이름은 하나."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有一个名称。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有一個名稱。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Одно имя."
          }
        }
      }
    },
    "whatsDifferent.adopted.relink.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings > Herder Topography > Link Again… puts a machine %1$@ linked on c11's own link beside %1$@'s, so new terminals and mail work there at once. Terminals %1$@ opened there keep running."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定 > Herder トポグラフィー > 再リンク… を選ぶと、%1$@で接続していたマシンが、%1$@のリンクはそのままに、c11独自のリンクでも接続されます。新しいターミナルとメールがすぐに使えます。%1$@がそこで開いたターミナルは動き続けます。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Налаштування > Топографія herder > З’єднати знову… підключає комп’ютер, який ви з’єднали через %1$@, ще й через власне з’єднання c11, поруч зі з’єднанням %1$@, тож нові термінали й пошта працюють там одразу. Термінали, які %1$@ відкрив там, продовжують працювати."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정 > 허더 토폴로지 > 다시 연결…을 선택하면 %1$@에서 연결했던 컴퓨터가 %1$@의 연결과 나란히 c11 자체 연결로도 연결되어, 새 터미널과 메일이 바로 작동합니다. %1$@에서 그 컴퓨터에 연 터미널은 계속 실행됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选取“设置 > Herder 拓扑 > 重新链接…”，c11 会通过自己的链接，在 %1$@ 的链接旁边再连上 %1$@ 链接过的设备，新终端和邮件随即就能在那里使用。%1$@ 在那里打开的终端会继续运行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇「設定 > Herder 拓撲 > 重新連結…」，c11 會透過自己的連結，在 %1$@ 的連結旁邊再連上 %1$@ 連結過的機器，新終端機和郵件隨即就能在那裡使用。%1$@ 在那裡打開的終端機會繼續執行。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настройки > Топография herder > Связать снова… подключает компьютер, связанный через %1$@, ещё и по собственной связи c11, рядом со связью %1$@, так что новые терминалы и почта работают там сразу. Терминалы, которые %1$@ открыл там, продолжают работать."
          }
        }
      }
    },
    "whatsDifferent.adopted.relink.lead": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Link each machine again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マシンを一台ずつ再リンクします。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "З’єднайте кожен комп’ютер знову."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "컴퓨터마다 다시 연결하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "给每台设备重新链接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為每部機器重新連結。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Свяжите каждый компьютер снова."
          }
        }
      }
    },
    "whatsDifferent.adopted.sessions.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminals on this Mac kept running, and c11 attached to them. Keep %@.app installed for now: they still use its helper."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMacのターミナルは動き続けていて、c11がそれらに接続しました。いまのところ%@.appは残しておいてください。ターミナルはまだそのヘルパーを使っています。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Термінали на цьому Mac продовжили працювати, і c11 під’єднався до них. Поки що залиште %@.app встановленим: вони все ще використовують його помічника."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac의 터미널은 계속 실행되었고, c11이 그 터미널에 연결되었습니다. %@.app은 당분간 그대로 설치해 두세요. 터미널이 아직 그 도우미를 사용합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 Mac 上的终端一直在运行，c11 已接入它们。请暂时保留 %@.app：它们仍在使用它的助手。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這台 Mac 上的終端機一直在執行，c11 已接上它們。請暫時保留 %@.app：它們仍在使用它的輔助程式。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Терминалы на этом Mac продолжили работать, и c11 подключился к ним. Пока оставьте %@.app установленным: они всё ещё используют его помощник."
          }
        }
      }
    },
    "whatsDifferent.adopted.sessions.lead": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Same sessions."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セッションはそのまま。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ті самі сеанси."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "같은 세션."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会话不变。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "工作階段不變。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Те же сеансы."
          }
        }
      }
    },
    "whatsDifferent.adopted.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "c11 quit %@ and took over its terminals on this Mac. Your workspaces and settings came across, and the terminals kept running."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "c11が%@を終了し、このMac上のターミナルを引き継ぎました。ワークスペースと設定は引き継がれ、ターミナルは動き続けています。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "c11 закрив %@ і перейняв його термінали на цьому Mac. Ваші робочі простори й налаштування перенесено, а термінали продовжили працювати."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "c11이 %@ 앱을 종료하고 이 Mac의 터미널을 넘겨받았습니다. 작업 공간과 설정은 그대로 옮겨졌고, 터미널은 계속 실행되었습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "c11 已退出 %@，并接管了这台 Mac 上的终端。你的工作区和设置都已迁移过来，终端一直在运行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "c11 已結束 %@，並接手了這台 Mac 上的終端機。你的工作區和設定都已移轉過來，終端機一直在執行。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "c11 закрыл %@ и взял на себя его терминалы на этом Mac. Ваши рабочие пространства и настройки перенесены, а терминалы продолжили работать."
          }
        }
      }
    },
    "whatsDifferent.adopted.title": {
      "extractionState": "manual",
      "localizations": {
