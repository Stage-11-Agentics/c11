    "socket.retry_input.reconnecting": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Input is paused and the terminal is still reconnecting. Try again in a few seconds."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力は一時停止中で、ターミナルはまだ再接続中です。数秒後にもう一度お試しください。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Введення призупинено, термінал ще перепідключається. Повторіть спробу за кілька секунд."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "입력이 일시 중지되었으며 터미널이 아직 다시 연결 중입니다. 몇 초 후에 다시 시도하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入已暂停，终端仍在重新连接。请几秒后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輸入已暫停，終端機仍在重新連線。請幾秒後再試。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ввод приостановлен, терминал ещё переподключается. Повторите попытку через несколько секунд."
          }
        }
      }
    },
