    "machinePicker.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press a number. Return: This Mac. Esc: cancel."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "番号を押してください。Return: この Mac。Esc: キャンセル。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Натисніть цифру. Return: цей Mac. Esc: скасувати."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "번호를 누르세요. Return: 이 Mac. Esc: 취소."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按数字键选择。Return：这台 Mac。Esc：取消。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按數字鍵選擇。Return：這台 Mac。Esc：取消。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите цифру. Return: этот Mac. Esc: отмена."
          }
        }
      }
    },
    "agentLaunch.decline.machineUnavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ isn't connected right now, so the agent wasn't started there. Wait for its link, or launch on another machine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ は現在接続されていないため、エージェントはそこで起動されませんでした。リンクが復旧するまでお待ちいただくか、別のマシンで起動してください。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ зараз не підключено, тому агента там не запущено. Зачекайте на відновлення зв’язку або запустіть його на іншому комп’ютері."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 컴퓨터가 지금 연결되어 있지 않아 에이전트를 그곳에서 시작하지 못했습니다. 연결될 때까지 기다리거나 다른 컴퓨터에서 실행하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 当前未连接，因此未在该电脑上启动智能体。请等待链接恢复，或在其他电脑上启动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 目前未連線，因此未在該電腦上啟動代理程式。請等待連結恢復，或在其他電腦上啟動。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ сейчас не подключён, поэтому агент там не запущен. Дождитесь восстановления связи или запустите его на другом компьютере."
          }
        }
      }
    },
    "settings.machines.ask": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask which machine for new terminals"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新規ターミナルのマシンを確認する"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запитувати, на якому комп’ютері відкривати нові термінали"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 터미널을 열 컴퓨터 묻기"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新建终端时询问使用哪台电脑"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新增終端機時詢問要使用哪台電腦"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Спрашивать, на каком компьютере открывать новые терминалы"
          }
        }
      }
    },
    "settings.machines.ask.subtitleOn": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When another machine is connected, New Terminal and agent launches ask where to run. Press its number to choose; Return picks this Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほかのマシンが接続されているとき、新規ターミナルやエージェントの起動時に実行場所を確認します。番号を押して選択し、Return で この Mac を選びます。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Коли підключено інший комп’ютер, «Новий термінал» і запуск агентів питатимуть, де виконувати. Натисніть його цифру, щоб вибрати; Return вибирає цей Mac."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 컴퓨터가 연결되어 있으면 새 터미널과 에이전트를 실행할 때 어디서 실행할지 묻습니다. 번호를 눌러 선택하고, Return을 누르면 이 Mac이 선택됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接了其他电脑时，新建终端和启动智能体会询问在哪里运行。按对应数字键选择；按 Return 选择这台 Mac。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連線了其他電腦時，新增終端機和啟動代理程式會詢問要在哪裡執行。按對應的數字鍵選擇；按 Return 選擇這台 Mac。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда подключён другой компьютер, при создании терминала и запуске агентов приложение спросит, где их запускать. Нажмите его цифру, чтобы выбрать; Return выбирает этот Mac."
          }
        }
      }
    },
    "settings.machines.ask.subtitleOff": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New terminals and agents open on this Mac. File > New Terminal on <Machine> still opens one elsewhere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新規ターミナルとエージェントはこの Mac で開きます。ファイル > <マシン>で新規ターミナル で、ほかのマシンでも開けます。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нові термінали й агенти відкриваються на цьому Mac. «Файл > Новий термінал на <комп’ютері>» усе ще відкриває термінал на іншому комп’ютері."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 터미널과 에이전트는 이 Mac에서 열립니다. 파일 > <컴퓨터>에서 새 터미널로 다른 컴퓨터에서도 열 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新建的终端和智能体会在这台 Mac 上打开。仍可通过“文件 > 在<电脑>上新建终端”在其他电脑上打开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新增的終端機和代理程式會在這台 Mac 上開啟。仍可透過「檔案 > 在<電腦>上新增終端機」在其他電腦上開啟。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Новые терминалы и агенты открываются на этом Mac. Пункт «Файл > Новый терминал на <компьютере>» по-прежнему открывает терминал на другом компьютере."
          }
        }
      }
    },
