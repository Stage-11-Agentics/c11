    "settings.app.sidebarExpiryThreshold.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How long before a status pill grays out entirely and derived activity takes over."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ステータスピルが完全にグレーアウトし、推定アクティビティに切り替わるまでの時間。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "状态标签完全变灰并由推断活动接管之前的时长。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "狀態標籤完全變灰並由推斷活動接管之前的時長。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "상태 표시가 완전히 회색으로 바뀌고 추정 활동으로 전환되기까지의 시간."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сколько времени пройдёт, прежде чем плашка статуса полностью станет серой и её заменит производная активность."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Скільки часу мине, перш ніж плашка статусу повністю посіріє й її замінить похідна активність."
          }
        }
      }
    },
