    "hc.hostEnd.checkFirst": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Typing the resume was cut off in this terminal. Check the panel, then start the agent yourself."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このターミナルでの再開の入力が途中で途切れました。パネルを確認してから、エージェントを自分で起動してください。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Введення для відновлення в цьому терміналі обірвалося. Перевірте панель, а потім запустіть агента самостійно."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 터미널에서 재개 입력이 중간에 끊겼습니다. 패널을 확인한 다음 에이전트를 직접 시작하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在此终端中，恢复输入被中途截断。请检查面板，然后自行启动智能体。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在此終端機中，恢復輸入被中途截斷。請檢查面板，然後自行啟動代理程式。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ввод для возобновления в этом терминале оборвался. Проверьте панель, затем запустите агента самостоятельно."
          }
        }
      }
    },
    "hc.hostEnd.promptNotEmpty": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The terminal may have something typed at its prompt. Press Return on an empty prompt (or run a command), then resume."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ターミナルのプロンプトに入力中の内容が残っている可能性があります。空のプロンプトで Return を押す（またはコマンドを実行する）かしてから、再開してください。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У запрошенні терміналу може бути набраний, але не надісланий текст. Натисніть Return на порожньому запрошенні (або виконайте команду), а потім відновіть."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "터미널 프롬프트에 입력된 내용이 남아 있을 수 있습니다. 빈 프롬프트에서 Return을 누르거나 명령을 실행한 다음 재개하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "终端的提示符处可能还有已输入的内容。请在空白提示符下按 Return（或运行一条命令），然后再恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "終端機的提示符號處可能還有已輸入的內容。請在空白提示符號下按 Return（或執行一個指令），然後再恢復。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В приглашении терминала может быть набран текст. Нажмите Return на пустом приглашении (или выполните команду), затем возобновите."
          }
        }
      }
    },
