    "panelLink.notice.activation" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open c11 links by clicking them or pressing Return in a local page."
          }
        },
        "ja" : {
          "stringUnit" : {
