[32m+[m[32m        }[m
[32m+[m
[32m+[m[32m        let classified = Task.detached(priority: .userInitiated) { () -> (Classification, markersMs: Int, classifyMs: Int, tiers: [String: Int]) in[m
[32m+[m[32m            _ = await seeded.value[m
[32m+[m[32m            let markersStart = DispatchTime.now().uptimeNanoseconds[m
[32m+[m[32m            let markers = env.loadLaunchBoundaries(scope.markerSurfaceIds)[m
[32m+[m[32m            _ = await env.store.applyCodexLaunchBoundaries(markers)[m
[32m+[m[32m            let markersMs = Self.elapsedMs(since: markersStart)[m
[32m+[m[32m            let classifyStart = DispatchTime.now().uptimeNanoseconds[m
