      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Panel title mismatch for %@: expected %@, found %@. Nothing was closed."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パネル %@ のタイトルが一致しません: 期待値は %@、実際は %@ です。何も閉じませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "패널 %@의 제목이 일치하지 않습니다: 예상 값은 %@, 실제 값은 %@입니다. 아무것도 닫지 않았습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заголовок панели %@ не совпадает: ожидалось «%@», найдено «%@». Ничего не закрыто."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Заголовок панелі %@ не збігається: очікувалося «%@», знайдено «%@». Нічого не закрито."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "面板 %@ 的标题不匹配：预期为 %@，实际为 %@。未关闭任何内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "面板 %@ 的標題不相符：預期為 %@，實際為 %@。未關閉任何內容。"
          }
