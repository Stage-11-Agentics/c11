        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "继承（代理默认）"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "繼承（代理預設）"
          }
        },
        "ru": {
