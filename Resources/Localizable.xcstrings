    "panelLink.external.explanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "An outside link wants to select this destination. Confirm only if you intended to open it."}},
        "ja": {"stringUnit": {"state": "translated", "value": "外部のリンクがこの移動先を選択しようとしています。開くつもりだった場合にのみ確認してください。"}},
        "uk": {"stringUnit": {"state": "translated", "value": "Зовнішнє посилання намагається вибрати це місце призначення. Підтверджуйте, лише якщо ви справді хотіли його відкрити."}},
        "ko": {"stringUnit": {"state": "translated", "value": "외부 링크가 이 대상을 선택하려고 합니다. 직접 열려던 경우에만 확인하세요."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "外部链接想要选中此目标。仅当你确实想打开时才点击确认。"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "外部連結想要選取此目的地。僅在你確實想開啟時才按確認。"}},
        "ru": {"stringUnit": {"state": "translated", "value": "Внешняя ссылка хочет выбрать это место назначения. Подтверждайте, только если вы действительно хотели его открыть."}}
      }
    },
