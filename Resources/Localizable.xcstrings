    "mailbox.cli.error.to-captain-conflict": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pass --to-captain by itself; it cannot be combined with --to, --to-parent or --to-workspace."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "--to-captain は単独で指定してください。--to、--to-parent、--to-workspace とは併用できません。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Передайте --to-captain окремо; його не можна поєднувати з --to, --to-parent або --to-workspace."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "--to-captain은 단독으로 사용하세요. --to, --to-parent 또는 --to-workspace와 함께 사용할 수 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请单独使用 --to-captain；不能与 --to、--to-parent 或 --to-workspace 组合使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請單獨使用 --to-captain；不能與 --to、--to-parent 或 --to-workspace 組合使用。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Передайте --to-captain отдельно; его нельзя сочетать с --to, --to-parent или --to-workspace."
          }
        }
      }
    },
