    "workspaceGroup.error.notRootItem": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The target is inside a group. Name a group or a workspace that is in no group."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "対象はグループ内にあります。グループ、またはグループに属さないワークスペースを指定してください。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ціль перебуває всередині групи. Вкажіть групу або робочий простір, що не входить до жодної групи."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대상이 그룹 안에 있습니다. 그룹 또는 어떤 그룹에도 속하지 않은 워크스페이스를 지정하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目标位于某个组内。请指定一个组，或不属于任何组的工作区。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目標位於某個群組內。請指定一個群組，或不屬於任何群組的工作區。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Цель находится внутри группы. Укажите группу или рабочее пространство, не входящее ни в одну группу."
          }
        }
      }
    },
