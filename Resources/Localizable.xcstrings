    "socket.error.window_fullscreen": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That window is fullscreen. resize-window does not enter or leave fullscreen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そのウインドウはフルスクリーンです。resize-window はフルスクリーンの開始や終了を行いません。"
