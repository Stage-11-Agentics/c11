 }[m
[32m+[m
[32m+[m[32m/// C11-229 — the per-surface location triple exposed over the socket[m
[32m+[m[32m/// (`tree --json`, `get-metadata`). Built from the same inputs the sidebar[m
[32m+[m[32m/// chips use (`Workspace.panelGitContexts`, `Workspace.panelDirectories`), so[m
[32m+[m[32m/// the two never disagree. Every field is nil when unknown.[m
[32m+[m[32mpublic struct PanelGitLocation: Equatable, Sendable {[m
[32m+[m[32m    public let cwd: String?[m
[32m+[m[32m    public let branch: String?[m
[32m+[m[32m    /// Basename of the linked worktree; nil for a main checkout.[m
[32m+[m[32m    public let worktree: String?[m
[32m+[m
[32m+[m[32m    public static let unknown = PanelGitLocation(cwd: nil, branch: nil, worktree: nil)[m
[32m+[m
[32m+[m[32m    public init(cwd: String?, branch: String?, worktree: String?) {[m
[32m+[m[32m        self.cwd = cwd[m
[32m+[m[32m        self.branch = branch[m
[32m+[m[32m        self.worktree = worktree[m
[32m+[m[32m    }[m
[32m+[m
[32m+[m[32m    /// A remote (`c11 ssh`) workspace reports nothing: its reported cwd is a[m
[32m+[m[32m    /// path on another host, and resolving it here would name a local repo[m
[32m+[m[32m    /// that is not the panel's.[m
[32m+[m[32m    public static func project([m
[32m+[m[32m        context: ResolvedGitContext?,[m
[32m+[m[32m        cwd: String?,[m
[32m+[m[32m        isRemote: Bool[m
[32m+[m[32m    ) -> PanelGitLocation {[m
[32m+[m[32m        guard !isRemote else { return .unknown }[m
[32m+[m[32m        let trimmedCwd = cwd?.trimmingCharacters(in: .whitespacesAndNewlines)[m
[32m+[m[32m        let resolvedCwd = (trimmedCwd?.isEmpty ?? true) ? nil : trimmedCwd[m
[32m+[m[32m        guard let context else {[m
[32m+[m[32m            return PanelGitLocation(cwd: resolvedCwd, branch: nil, worktree: nil)[m
[32m+[m[32m        }[m
[32m+[m[32m        switch context.outer {[m
[32m+[m[32m        case .mainCheckout(let branch):[m
[32m+[m[32m            return PanelGitLocation(cwd: resolvedCwd, branch: branchLabel(branch), worktree: nil)[m
[32m+[m[32m        case .linkedWorktree(let basename, _, let branch):[m
[32m+[m[32m            return PanelGitLocation(cwd: resolvedCwd, branch: branchLabel(branch), worktree: basename)[m
[32m+[m[32m        case .notInRepo, .stale:[m
[32m+[m[32m            return PanelGitLocation(cwd: resolvedCwd, branch: nil, worktree: nil)[m
[32m+[m[32m        }[m
[32m+[m[32m    }[m
[32m+[m
[32m+[m[32m    /// Same strings the derived `branch` metadata key carries.[m
[32m+[m[32m    static func branchLabel(_ branch: BranchValue) -> String? {[m
[32m+[m[32m        switch branch {[m
[32m+[m[32m        case .attached(let name): return name[m
[32m+[m[32m        case .detached(let sha): return "(detached @ \(sha))"[m
[32m+[m[32m        case .noBranch: return nil[m
[32m+[m[32m        }[m
[32m+[m[32m    }[m
[32m+[m[32m}[m
