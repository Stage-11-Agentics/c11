    "settings.app.showSurfaceIdsInTabTitles.subtitleOff": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Panels display their title only. Turn on to prefix every panel with its addressable panel number."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パネルにはタイトルのみが表示されます。オンにすると、各パネルの先頭にアドレス指定可能なパネル番号が付きます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "面板仅显示其标题。开启后，会在每个面板前面加上可寻址的面板编号。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "面板僅顯示其標題。開啟後，會在每個面板前面加上可定址的面板編號。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "패널에는 제목만 표시됩니다. 켜면 모든 패널 앞에 주소로 지정할 수 있는 패널 번호가 붙습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Панели показывают только заголовок. Включите, чтобы добавить в начало каждой панели её адресуемый номер."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Панелі показують лише заголовок. Увімкніть, щоб додати на початок кожної панелі її адресний номер."
          }
        }
      }
    },
    "settings.app.showSurfaceIdsInTabTitles.subtitleOn": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Panels display their panel number (\"292: Build agent\"). Say the number to address a panel; agents target it as panel:N."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パネルにパネル番号が表示されます（「292: Build agent」）。番号を伝えてパネルを指定できます。エージェントは panel:N として指定します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "面板会显示其面板编号（“292: Build agent”）。说出编号即可指定某个面板；代理以 panel:N 定位它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "面板會顯示其面板編號（「292: Build agent」）。說出編號即可指定某個面板；代理以 panel:N 定位它。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "패널에 패널 번호가 표시됩니다(\"292: Build agent\"). 번호를 말해 패널을 지정하세요. 에이전트는 panel:N으로 대상을 지정합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Панели показывают свой номер («292: Build agent»). Назовите номер, чтобы указать панель; агенты обращаются к ней как panel:N."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Панелі показують свій номер («292: Build agent»). Назвіть номер, щоб указати панель; агенти адресують її як panel:N."
          }
        }
      }
    },
