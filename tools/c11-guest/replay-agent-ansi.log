[32m+[m[32m        return currentMode[m
[32m+[m[32m    }[m
[32m+[m
[32m+[m[32m    /// A launch with nothing to audit (restore off, no snapshot, or the store[m
[32m+[m[32m    /// kill switch). Every await returns at once with no scrape dependents.[m
[32m+[m[32m    func beginWithoutAudit(mode: ResumeRecoveryMode) {[m
[32m+[m[32m        lock.lock()[m
[32m+[m[32m        currentMode = mode[m
[32m+[m[32m        seededTask = nil[m
[32m+[m[32m        classifiedTask = nil[m
[32m+[m[32m        completedTask = nil[m
[32m+[m[32m        mainSeedWaitMs = nil[m
[32m+[m[32m        lock.unlock()[m
[32m+[m[32m    }[m
[32m+[m
[32m+[m[32m    /// How long launch blocked main on `awaitSeeded`, carried in the report.[m
[32m+[m[32m    func recordMainSeedWait(ms: Int) {[m
[32m+[m[32m        lock.lock()[m
[32m+[m[32m        mainSeedWaitMs = ms[m
[32m+[m[32m        lock.unlock()[m
[32m+[m[32m    }[m
[32m+[m
[32m+[m[32m    func begin([m
[32m+[m[32m        mode: ResumeRecoveryMode,[m
[32m+[m[32m        snapshot: AppSessionSnapshot,[m
[32m+[m[32m        environment env: Environment[m
[32m+[m[32m    ) {[m
[32m+[m[32m        let scope = ConversationSnapshotCaptureScope(snapshot: snapshot)[m
[32m+[m[32m        let records = WorkspaceSnapshotConversationBridge.records(from: snapshot)[m
[32m+[m[32m        let startedAt = DispatchTime.now().uptimeNanoseconds[m
[32m+[m
