    "settings.notifications.flagSound.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Played when an agent raises a flag. Flags always sound, at every notification level."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントがフラグを立てたときに再生されます。フラグはどの通知レベルでも必ず音が鳴ります。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відтворюється, коли агент ставить позначку. Позначки завжди зі звуком на кожному рівні сповіщень."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이전트가 플래그를 올릴 때 재생됩니다. 플래그는 모든 알림 수준에서 항상 소리가 납니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "代理提出标记时播放。无论通知级别如何，标记始终会发出声音。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "代理提出標記時播放。無論通知層級為何，標記一律會發出聲音。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Воспроизводится, когда агент ставит отметку. Отметки всегда со звуком на любом уровне уведомлений."
          }
        }
      }
    },
    "migration.gate.goBack": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "c11h's own files are untouched. To go back, quit c11 and open c11h. Details are in ~/Library/Logs/c11/migration.log."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "c11hのファイルには手を加えていません。元に戻すには、c11を終了してc11hを開いてください。詳細は ~/Library/Logs/c11/migration.log にあります。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Файли c11h не змінено. Щоб повернутися, закрийте c11 і відкрийте c11h. Подробиці в ~/Library/Logs/c11/migration.log."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "c11h의 파일은 그대로입니다. 되돌아가려면 c11을 종료하고 c11h를 여세요. 자세한 내용은 ~/Library/Logs/c11/migration.log에 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "c11h 的文件未被改动。如需返回，请退出 c11 并打开 c11h。详情见 ~/Library/Logs/c11/migration.log。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "c11h 的檔案未被更動。如需返回，請結束 c11 並開啟 c11h。詳細資訊請見 ~/Library/Logs/c11/migration.log。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файлы c11h не тронуты. Чтобы вернуться, закройте c11 и откройте c11h. Подробности в ~/Library/Logs/c11/migration.log."
          }
        }
      }
    },
    "migration.gate.moving": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "c11 is preparing your workspaces. It opens by itself when they are ready. Your terminals keep running."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "c11はワークスペースを準備しています。準備ができると自動的に開きます。ターミナルは動作を続けます。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "c11 готує ваші робочі простори. Коли вони будуть готові, c11 відкриється автоматично. Ваші термінали продовжують працювати."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "c11이 작업 공간을 준비하고 있습니다. 준비가 완료되면 자동으로 열립니다. 터미널은 계속 실행됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "c11 正在准备您的工作区。准备好后会自动打开。您的终端会继续运行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "c11 正在準備您的工作區。準備完成後會自動開啟。您的終端機會繼續運行。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "c11 подготавливает ваши рабочие пространства. Когда они будут готовы, c11 откроется автоматически. Ваши терминалы продолжают работать."
          }
        }
      }
    },
    "migration.gate.waiting": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "c11h is still quitting. Its terminals keep running. c11 opens by itself as soon as c11h has quit."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "c11hはまだ終了処理中です。ターミナルは実行されたままです。c11hが終了すると、c11が自動的に開きます。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "c11h ще завершує роботу. Його термінали продовжують працювати. c11 відкриється сам, щойно c11h завершить роботу."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "c11h가 아직 종료되는 중입니다. 터미널은 계속 실행됩니다. c11h가 종료되면 c11이 자동으로 열립니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "c11h 仍在退出。它的终端会继续运行。c11h 退出后，c11 会自动打开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "c11h 仍在結束中。它的終端機會繼續執行。c11h 結束後，c11 會自動開啟。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "c11h ещё закрывается. Его терминалы продолжают работать. c11 откроется сам, как только c11h закроется."
          }
        }
      }
    },
    "migration.gate.legacyStillRunning": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "c11h has not quit, so nothing has moved. Quit c11h, then open c11 again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "c11hが終了していないため、何も移行されていません。c11hを終了してから、もう一度c11を開いてください。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "c11h не завершив роботу, тому нічого не перенесено. Закрийте c11h і відкрийте c11 знову."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "c11h가 종료되지 않아 아무것도 옮겨지지 않았습니다. c11h를 종료한 뒤 c11을 다시 여세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "c11h 尚未退出，因此没有迁移任何内容。请先退出 c11h，然后重新打开 c11。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "c11h 尚未結束，因此沒有移轉任何內容。請先結束 c11h，然後重新開啟 c11。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "c11h не закрыт, поэтому ничего не перенесено. Закройте c11h и снова откройте c11."
          }
        }
      }
    },
    "migration.gate.stopped": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "c11 stopped before opening, so nothing it found is lost."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "c11は開く前に停止しました。見つかった内容は何も失われていません。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "c11 зупинився до відкриття, тому все, що він знайшов, збережено."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "c11이 열리기 전에 멈췄으므로, 찾은 내용은 하나도 손실되지 않았습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "c11 在打开前已停止，因此它发现的内容不会丢失。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "c11 在開啟前已停止，因此它發現的內容不會遺失。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "c11 остановился до открытия, поэтому всё, что он нашёл, сохранено."
          }
        }
      }
    },
    "migration.gate.quit": {
