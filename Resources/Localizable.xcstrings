  "dialog.renameWindow.refused.looksLikeRef": {
    "extractionState": "manual",
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "A name can't be only a number, a UUID, or a ref like window:2."
        }
      },
      "ja": {
        "stringUnit": {
          "state": "translated",
          "value": "数字のみ、UUID、window:2 のような参照だけの名前は使用できません。"
        }
      },
      "uk": {
        "stringUnit": {
          "state": "translated",
          "value": "Назва не може складатися лише з числа, UUID або посилання на кшталт window:2."
        }
      },
      "ko": {
        "stringUnit": {
          "state": "translated",
          "value": "이름은 숫자만, UUID, 또는 window:2 같은 참조만으로 지을 수 없어요."
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "名称不能只是数字、UUID，或 window:2 这样的引用。"
        }
      },
      "zh-Hant": {
        "stringUnit": {
          "state": "translated",
          "value": "名稱不能只是數字、UUID，或像 window:2 這樣的參照。"
        }
      },
      "ru": {
        "stringUnit": {
          "state": "translated",
          "value": "Имя не может состоять только из числа, UUID или ссылки вида window:2."
        }
      }
    }
  },
  "dialog.renameWindow.refused.inUse": {
    "extractionState": "manual",
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Another window already has that name."
        }
      },
      "ja": {
        "stringUnit": {
          "state": "translated",
