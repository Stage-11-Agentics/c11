    "mailbox.native.error.liveProcess": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Native mailbox requires the live agent process and its terminal."}},
        "ja": {"stringUnit": {"state": "translated", "value": "ネイティブのメールボックス配信には、実行中のエージェントプロセスとそのターミナルが必要です。"}},
        "uk": {"stringUnit": {"state": "translated", "value": "Нативна доставка поштової скриньки потребує запущеного процесу агента та його термінала."}},
        "ko": {"stringUnit": {"state": "translated", "value": "네이티브 메일박스 전달에는 실행 중인 에이전트 프로세스와 해당 터미널이 필요합니다."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "原生邮箱投递需要正在运行的智能体进程及其终端。"}},
