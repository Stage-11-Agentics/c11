      }
    },
    "socket.target.empty": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ was provided but empty; commands with explicit targets never fall back to the selected or focused target."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ が指定されましたが空です。明示的なターゲットを持つコマンドが、選択中またはフォーカス中のターゲットにフォールバックすることはありません。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ задано, але порожнє; команди з явними цілями ніколи не переходять до вибраної чи сфокусованої цілі."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@이(가) 제공되었지만 비어 있습니다. 대상을 명시한 명령은 선택되었거나 포커스된 대상으로 대체되지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已提供 %@，但其内容为空；带有明确目标的命令绝不会回退到所选或聚焦的目标。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已提供 %@，但內容為空；指定了明確目標的命令絕不會退而使用已選取或有焦點的目標。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ указан, но пуст; команды с явной целью никогда не переходят на выбранную или сфокусированную цель."
          }
        }
      }
    },
    "socket.target.notFound": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unknown %1$@: %2$@. Short refs last only for the current c11 process; commands with explicit targets never fall back to the selected or focused target."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "不明な %1$@: %2$@。短い ref は現在の c11 プロセスの間だけ有効です。明示的なターゲットを持つコマンドが、選択中またはフォーカス中のターゲットにフォールバックすることはありません。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Невідомо %1$@: %2$@. Короткі ref діють лише в поточному процесі c11; команди з явними цілями ніколи не переходять до вибраної чи сфокусованої цілі."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알 수 없는 %1$@: %2$@. 짧은 ref는 현재 c11 프로세스 동안만 유지됩니다. 대상을 명시한 명령은 선택되었거나 포커스된 대상으로 대체되지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未知的 %1$@：%2$@。短引用仅在当前 c11 进程内有效；带有明确目标的命令绝不会回退到所选或聚焦的目标。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未知的 %1$@：%2$@。短 ref 只在目前的 c11 行程內有效；指定了明確目標的命令絕不會退而使用已選取或有焦點的目標。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Неизвестно (%1$@): %2$@. Короткие ссылки действуют только в текущем процессе c11; команды с явной целью никогда не переходят на выбранную или сфокусированную цель."
          }
        }
      }
    },
    "workspace.companion.diagnostic.applyFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
