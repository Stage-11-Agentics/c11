    "machineSetup.error.invalidHost": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” isn't an SSH host c11 can use. Give a name from your SSH config, a host name, or user@host."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”はc11で使用できるSSHホストではありません。SSH設定にある名前、ホスト名、またはuser@hostを指定してください。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” не є вузлом SSH, який може використовувати c11. Вкажіть ім’я з конфігурації SSH, ім’я вузла або user@host."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”은(는) c11에서 사용할 수 있는 SSH 호스트가 아닙니다. SSH 설정의 이름, 호스트 이름 또는 user@host를 입력하십시오."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”不是 c11 可以使用的 SSH 主机。请提供 SSH 配置中的名称、主机名或 user@host。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」不是 c11 可以使用的 SSH 主機。請提供 SSH 設定中的名稱、主機名稱或 user@host。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» — не хост SSH, который может использовать c11. Укажите имя из конфигурации SSH, имя хоста или user@host."
          }
        }
      }
    },
    "machineSetup.error.invalidName": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” can't be a machine name. Use lower-case letters, digits, dots, dashes or underscores; “local” and “here” mean this Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”はマシン名として使用できません。小文字の英字、数字、ドット、ハイフン、アンダースコアを使用してください。“local”と“here”はこのMacを指します。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” не може бути назвою машини. Використовуйте малі літери, цифри, крапки, дефіси або підкреслення; “local” і “here” означають цей Mac."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”은(는) 머신 이름으로 사용할 수 없습니다. 영문 소문자, 숫자, 점, 하이픈 또는 밑줄을 사용하십시오. “local”과 “here”는 이 Mac을 의미합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”不能用作机器名称。请使用小写字母、数字、点、短横线或下划线；“local”和“here”表示这台 Mac。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」不能用作機器名稱。請使用小寫字母、數字、點、連字號或底線；「local」和「here」代表這部 Mac。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» не может быть именем машины. Используйте строчные буквы, цифры, точки, дефисы или подчёркивания; «local» и «here» означают этот Mac."
          }
        }
      }
    },
    "machineSetup.error.nameTaken": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A machine called %@ is already linked. Pick another name, or remove that one first."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@という名前のマシンはすでにリンクされています。別の名前を指定するか、先にそのマシンを削除してください。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Машину з назвою %@ уже зв’язано. Виберіть іншу назву або спершу вилучіть ту машину."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@(이)라는 머신이 이미 연결되어 있습니다. 다른 이름을 지정하거나 먼저 해당 머신을 제거하십시오."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "名为 %@ 的机器已链接。请选择其他名称，或先移除该机器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "名為 %@ 的機器已連結。請選擇其他名稱，或先移除該機器。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Машина с именем %@ уже связана. Выберите другое имя или сначала удалите ту машину."
          }
        }
      }
    },
    "machineSetup.error.hostKey": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Mac doesn't know %1$@'s host key yet. Run “ssh %1$@” once in a terminal, check the fingerprint and accept it, then try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMacはまだ%1$@のホスト鍵を認識していません。ターミナルで“ssh %1$@”を一度実行し、フィンガープリントを確認して承認してから、もう一度お試しください。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей Mac ще не знає ключа вузла %1$@. Один раз виконайте в терміналі “ssh %1$@”, перевірте відбиток, прийміть його й повторіть спробу."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac은 아직 %1$@의 호스트 키를 알지 못합니다. 터미널에서 “ssh %1$@”를 한 번 실행하여 핑거프린트를 확인하고 수락한 다음 다시 시도하십시오."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 Mac 尚不认识 %1$@ 的主机密钥。请在终端中运行一次“ssh %1$@”，核对并接受指纹，然后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這部 Mac 尚未認得 %1$@ 的主機密鑰。請在終端機中執行一次「ssh %1$@」，核對並接受指紋，然後再試一次。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот Mac ещё не знает ключ хоста %1$@. Один раз выполните в терминале «ssh %1$@», проверьте отпечаток, примите его и повторите попытку."
          }
        }
      }
    },
    "machineSetup.error.auth": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ didn't accept your SSH key. c11 signs in with your keys and never asks for a password: run “ssh-copy-id %1$@”, then try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@はSSH鍵を受け付けませんでした。c11はユーザのSSH鍵でサインインし、パスワードは要求しません。“ssh-copy-id %1$@”を実行してから、もう一度お試しください。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ не прийняв ваш ключ SSH. c11 входить за вашими ключами й ніколи не запитує пароль: виконайте “ssh-copy-id %1$@” і повторіть спробу."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@에서 사용자의 SSH 키를 허용하지 않았습니다. c11는 사용자의 키로 로그인하며 암호를 묻지 않습니다. “ssh-copy-id %1$@”를 실행한 다음 다시 시도하십시오."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 不接受你的 SSH 密钥。c11 使用你的密钥登录，从不询问密码：请运行“ssh-copy-id %1$@”，然后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 不接受你的 SSH 密鑰。c11 使用你的密鑰登入，絕不詢問密碼：請執行「ssh-copy-id %1$@」，然後再試一次。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ не принял ваш ключ SSH. c11 входит по вашим ключам и никогда не запрашивает пароль: выполните «ssh-copy-id %1$@» и повторите попытку."
          }
        }
      }
    },
    "machineSetup.error.unknownHost": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No machine called %@ could be found. Check the name, or use its address."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@という名前のマシンが見つかりませんでした。名前を確認するか、アドレスを使用してください。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Машину з назвою %@ не знайдено. Перевірте назву або скористайтеся її адресою."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@(이)라는 머신을 찾을 수 없습니다. 이름을 확인하거나 주소를 사용하십시오."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "找不到名为 %@ 的机器。请检查名称，或使用其地址。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "找不到名為 %@ 的機器。請檢查名稱，或使用其位址。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Машина с именем %@ не найдена. Проверьте имя или используйте её адрес."
          }
        }
      }
    },
    "machineSetup.error.unreachable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't reach %1$@ over SSH (%2$@). Check that it's on, on your network, and has Remote Login turned on."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "SSHで%1$@に接続できませんでした(%2$@)。電源が入っていること、ネットワークに接続されていること、リモートログインがオンになっていることを確認してください。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося підключитися до %1$@ через SSH (%2$@). Переконайтеся, що машину ввімкнено, що вона у вашій мережі й що на ній увімкнено віддалений вхід."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH로 %1$@에 연결할 수 없습니다(%2$@). 전원이 켜져 있는지, 네트워크에 연결되어 있는지, 원격 로그인이 켜져 있는지 확인하십시오."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法通过 SSH 连接到 %1$@（%2$@）。请检查它是否已开机、是否在你的网络上，以及是否已打开“远程登录”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法透過 SSH 連線到 %1$@（%2$@）。請檢查它是否已開機、是否在你的網路上，以及是否已開啟「遠端登入」。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось подключиться к %1$@ по SSH (%2$@). Убедитесь, что машина включена, находится в вашей сети и на ней включён удалённый вход."
          }
        }
      }
    },
    "machineSetup.error.unsupported": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ runs %2$@. c11 can add Macs with Apple silicon and x86-64 Linux machines; other machines are not supported yet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@では%2$@が動作しています。c11に追加できるのは、Apple siliconを搭載したMacとx86-64のLinuxマシンです。それ以外のマシンはまだサポートされていません。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На %1$@ працює %2$@. c11 може додавати Mac із чипом Apple silicon і машини x86-64 з Linux; інші машини ще не підтримуються."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@에서 %2$@이(가) 실행 중입니다. c11에는 Apple silicon을 탑재한 Mac과 x86-64 Linux 머신을 추가할 수 있으며, 다른 머신은 아직 지원되지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 运行的是 %2$@。c11 可以添加搭载 Apple silicon 的 Mac 和 x86-64 的 Linux 机器；暂不支持其他机器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 執行的是 %2$@。c11 可以加入搭載 Apple silicon 的 Mac 和 x86-64 的 Linux 機器；暫不支援其他機器。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На %1$@ работает %2$@. c11 может добавлять Mac с чипом Apple silicon и машины x86-64 с Linux; другие машины пока не поддерживаются."
          }
        }
      }
    },
    "machineSetup.error.linger": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ stops %2$@'s programs when their last login ends, and c11's terminals there would end with them. Run “sudo loginctl enable-linger %2$@” on it, then try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@では、最後のログインが終了すると%2$@のプログラムが停止し、そこにあるc11のターミナルも一緒に終了してしまいます。そちらで“sudo loginctl enable-linger %2$@”を実行してから、もう一度お試しください。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ зупиняє програми користувача %2$@, коли закінчується його останній вхід, і термінали c11 там завершилися б разом із ними. Виконайте на ньому “sudo loginctl enable-linger %2$@” і спробуйте ще раз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@은(는) %2$@의 마지막 로그인이 끝나면 그 프로그램을 중지하며, 그곳의 c11 터미널도 함께 종료됩니다. 해당 머신에서 다음 명령을 실행한 뒤 다시 시도하세요: “sudo loginctl enable-linger %2$@”"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 会在 %2$@ 的最后一次登录结束时停止其程序，c11 在那里的终端也会随之结束。请在该机器上运行“sudo loginctl enable-linger %2$@”，然后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 會在 %2$@ 的最後一次登入結束時停止其程式，c11 在那裡的終端機也會隨之結束。請在該機器上執行「sudo loginctl enable-linger %2$@」，然後再試一次。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ останавливает программы пользователя %2$@, когда заканчивается его последний сеанс, и терминалы c11 там завершились бы вместе с ними. Выполните на нём «sudo loginctl enable-linger %2$@» и повторите попытку."
          }
        }
      }
    },
    "machineSetup.error.nofile": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ lets your services there open only %2$lld files, which c11's terminals outgrow. On it, put “DefaultLimitNOFILE=524288” under [Manager] in /etc/systemd/user.conf.d/50-c11-nofile.conf, run “systemctl --user daemon-reexec”, then try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@では、サービスが開けるファイルが%2$lld個に制限されており、c11のターミナルにはそれでは足りません。そちらで、/etc/systemd/user.conf.d/50-c11-nofile.conf の[Manager]の下に“DefaultLimitNOFILE=524288”を追加し、“systemctl --user daemon-reexec”を実行してから、もう一度お試しください。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ дозволяє вашим службам там відкривати лише %2$lld файлів, а терміналам c11 цього замало. Додайте на ньому “DefaultLimitNOFILE=524288” у розділ [Manager] файлу /etc/systemd/user.conf.d/50-c11-nofile.conf, виконайте “systemctl --user daemon-reexec” і спробуйте ще раз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@에서는 서비스가 열 수 있는 파일이 %2$lld개뿐이라 c11 터미널에는 부족합니다. 해당 머신의 /etc/systemd/user.conf.d/50-c11-nofile.conf 파일에서 [Manager] 아래에 “DefaultLimitNOFILE=524288” 줄을 추가하고, “systemctl --user daemon-reexec” 명령을 실행한 뒤 다시 시도하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 只允许你在那里的服务打开 %2$lld 个文件，c11 的终端会超出这个数量。请在该机器上，将“DefaultLimitNOFILE=524288”添加到 /etc/systemd/user.conf.d/50-c11-nofile.conf 的 [Manager] 下，运行“systemctl --user daemon-reexec”，然后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 只允許你在那裡的服務開啟 %2$lld 個檔案，c11 的終端機會超出這個數量。請在該機器上，將「DefaultLimitNOFILE=524288」加入 /etc/systemd/user.conf.d/50-c11-nofile.conf 的 [Manager] 之下，執行「systemctl --user daemon-reexec」，然後再試一次。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ позволяет вашим службам там открывать только %2$lld файлов, а терминалам c11 этого мало. Добавьте на нём «DefaultLimitNOFILE=524288» в раздел [Manager] файла /etc/systemd/user.conf.d/50-c11-nofile.conf, выполните «systemctl --user daemon-reexec» и повторите попытку."
          }
        }
      }
    },
    "machineSetup.error.python": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ needs Python 3 at /usr/bin/python3 for c11's link. Install it there (on Debian or Ubuntu, “sudo apt install python3”), then try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@では、c11のリンクに/usr/bin/python3のPython 3が必要です。そちらにインストールしてください（DebianまたはUbuntuでは“sudo apt install python3”）。その後、もう一度お試しください。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ потрібен Python 3 за адресою /usr/bin/python3 для під’єднання c11. Установіть його там (у Debian або Ubuntu: “sudo apt install python3”) і спробуйте ще раз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에는 c11 연결을 위해 /usr/bin/python3에 Python 3이 필요합니다. 해당 머신에 설치한 뒤(Debian 또는 Ubuntu에서는 “sudo apt install python3”) 다시 시도하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 需要在 /usr/bin/python3 有 Python 3，c11 才能建立链接。请在那里安装（在 Debian 或 Ubuntu 上运行“sudo apt install python3”），然后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 需要在 /usr/bin/python3 有 Python 3，c11 才能建立連結。請在那裡安裝（在 Debian 或 Ubuntu 上執行「sudo apt install python3」），然後再試一次。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ нужен Python 3 по пути /usr/bin/python3 для связи с c11. Установите его там (в Debian или Ubuntu: «sudo apt install python3») и повторите попытку."
          }
        }
      }
    },
    "machineSetup.error.sha256": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ has neither sha256sum nor shasum, which c11 uses to check its hc there. Install coreutils there, then try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@にはsha256sumもshasumもありません。c11はこれらを使って、そこにあるhcを確認します。そちらにcoreutilsをインストールしてから、もう一度お試しください。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На %@ немає ні sha256sum, ні shasum, якими c11 перевіряє там свій hc. Установіть там coreutils і спробуйте ще раз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에는 sha256sum도 shasum도 없습니다. c11은 이 도구로 그곳의 hc를 확인합니다. 해당 머신에 coreutils를 설치한 뒤 다시 시도하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 上既没有 sha256sum 也没有 shasum，c11 要用它们来检查那里的 hc。请在那里安装 coreutils，然后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 上既沒有 sha256sum 也沒有 shasum，c11 要用它們來檢查那裡的 hc。請在那裡安裝 coreutils，然後再試一次。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На %@ нет ни sha256sum, ни shasum, которыми c11 проверяет там свой hc. Установите там coreutils и повторите попытку."
          }
        }
      }
    },
    "machineSetup.error.tar": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ has no tar, which c11 uses to unpack its relay kit there. Install tar there (on Debian or Ubuntu, “sudo apt install tar”), then try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@にはtarがありません。c11はtarを使って、そこにリレー用のファイル一式を展開します。そちらにtarをインストールしてください（DebianまたはUbuntuでは“sudo apt install tar”）。その後、もう一度お試しください。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На %@ немає tar, яким c11 розпаковує там свій набір файлів ретранслятора. Установіть там tar (у Debian або Ubuntu: “sudo apt install tar”) і спробуйте ще раз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에는 tar가 없습니다. c11은 tar로 그곳에 릴레이 키트를 풉니다. 해당 머신에 tar를 설치한 뒤(Debian 또는 Ubuntu에서는 “sudo apt install tar”) 다시 시도하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 上没有 tar，c11 要用它在那里解压中继所需的文件。请在那里安装 tar（在 Debian 或 Ubuntu 上运行“sudo apt install tar”），然后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 上沒有 tar，c11 要用它在那裡解壓縮中繼所需的檔案。請在那裡安裝 tar（在 Debian 或 Ubuntu 上執行「sudo apt install tar」），然後再試一次。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На %@ нет tar, которым c11 распаковывает там свой набор файлов ретранслятора. Установите там tar (в Debian или Ubuntu: «sudo apt install tar») и повторите попытку."
          }
        }
      }
    },
    "machineSetup.error.userManager": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ runs no systemd user manager for you, which c11's terminals there need to outlive your logins. c11 can add Linux machines that run systemd."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@では、あなた用のsystemdユーザーマネージャーが動作していません。そこにあるc11のターミナルがログアウト後も動き続けるには、これが必要です。c11はsystemdが動作するLinuxマシンを追加できます。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На %@ для вас не працює користувацький менеджер systemd, який потрібен терміналам c11 там, щоб пережити ваші сеанси входу. c11 може додавати машини Linux, на яких працює systemd."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에서는 사용자용 systemd 매니저가 실행되고 있지 않습니다. 그곳의 c11 터미널이 로그아웃 후에도 계속 실행되려면 이 매니저가 필요합니다. c11은 systemd가 실행되는 Linux 머신을 추가할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 没有为你运行 systemd 用户管理器，而那里的 c11 终端需要它才能在你退出登录后继续运行。c11 可以添加运行 systemd 的 Linux 机器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 沒有為你執行 systemd 使用者管理員，而那裡的 c11 終端機需要它才能在你登出後繼續執行。c11 可以加入執行 systemd 的 Linux 機器。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На %@ для вас не запущен пользовательский менеджер systemd, который нужен терминалам c11 там, чтобы пережить ваши выходы из системы. c11 может добавлять машины Linux, на которых работает systemd."
          }
        }
      }
    },
    "machineSetup.error.linuxFilesMissing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This c11 build doesn't name c11's files for Linux, so it can't add %@. A released c11 can."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このc11ビルドにはLinux用のc11ファイルの指定がないため、%@を追加できません。リリース版のc11なら追加できます。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ця збірка c11 не вказує файли c11 для Linux, тому не може додати %@. Випущена версія c11 може."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 c11 빌드에는 Linux용 c11 파일이 지정되어 있지 않아 %@을(를) 추가할 수 없습니다. 릴리스된 c11은 추가할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 c11 构建没有指定适用于 Linux 的 c11 文件，因此无法添加 %@。正式发布的 c11 可以。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此 c11 版本沒有指定適用於 Linux 的 c11 檔案，因此無法加入 %@。正式發行的 c11 可以。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта сборка c11 не указывает файлы c11 для Linux, поэтому не может добавить %@. Выпущенная версия c11 может."
          }
        }
      }
    },
    "machineSetup.error.linuxFileFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "c11 couldn't get its Linux %1$@ (%2$@). Check this Mac's network, or run “c11 machine link --artifacts <folder>” with a folder holding it, then try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "c11はLinux用の%1$@を取得できませんでした（%2$@）。このMacのネットワークを確認するか、それを入れたフォルダを指定して“c11 machine link --artifacts <folder>”を実行してから、もう一度お試しください。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "c11 не зміг отримати свій %1$@ для Linux (%2$@). Перевірте мережу цього Mac або виконайте “c11 machine link --artifacts <folder>” із текою, у якій він лежить, і спробуйте ще раз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "c11이 Linux용 %1$@을(를) 가져오지 못했습니다(%2$@). 이 Mac의 네트워크를 확인하거나, 해당 파일이 들어 있는 폴더를 지정해 “c11 machine link --artifacts <folder>”를 실행한 뒤 다시 시도하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "c11 无法获取其 Linux 版 %1$@（%2$@）。请检查这台 Mac 的网络，或针对存放该文件的文件夹运行“c11 machine link --artifacts <folder>”，然后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "c11 無法取得其 Linux 版 %1$@（%2$@）。請檢查這部 Mac 的網路，或針對存放該檔案的資料夾執行「c11 machine link --artifacts <folder>」，然後再試一次。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "c11 не удалось получить свой %1$@ для Linux (%2$@). Проверьте сеть этого Mac или выполните «c11 machine link --artifacts <folder>» с папкой, где он лежит, и повторите попытку."
          }
        }
      }
    },
    "machineSetup.error.linuxFileMismatch": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Linux %1$@ c11 got isn't the one this build names (it hashes %2$@, this build expects %3$@), so c11 didn't use it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "c11が取得したLinux用の%1$@は、このビルドが指定するものではないため（ハッシュは%2$@、このビルドの期待値は%3$@）、c11は使用しませんでした。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Linux-версія %1$@, яку отримав c11, не та, що вказана в цій збірці (її хеш %2$@, ця збірка очікує %3$@), тому c11 її не використав."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "c11이 가져온 Linux용 %1$@은(는) 이 빌드가 지정한 것이 아니므로(해시 %2$@, 이 빌드가 기대하는 값 %3$@) c11이 사용하지 않았습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "c11 获取的 Linux 版 %1$@ 不是此构建所指定的那一个（其哈希为 %2$@，此构建期望的是 %3$@），因此 c11 没有使用它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "c11 取得的 Linux 版 %1$@ 不是此版本所指定的那一個（其雜湊為 %2$@，此版本預期的是 %3$@），因此 c11 沒有使用它。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Linux-версия %1$@, полученная c11, не та, которую указывает эта сборка (её хеш %2$@, эта сборка ожидает %3$@), поэтому c11 не стал её использовать."
          }
        }
      }
    },
    "machineSetup.error.linuxFileNotInFolder": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No file in %2$@ is this build's Linux %1$@ (c11 matches it by its hash), so c11 didn't download it instead. Put the file in that folder, or leave out “--artifacts” to download it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@内に、このビルド用のLinux版%1$@に一致するファイルはありません（c11はハッシュで照合します）。そのため、c11は代わりにダウンロードすることはしませんでした。そのフォルダにファイルを入れるか、“--artifacts”を外してダウンロードしてください。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У %2$@ немає файлу, що є Linux-версією %1$@ для цієї збірки (c11 зіставляє його за хешем), тому c11 не став завантажувати його замість цього. Покладіть файл у цю теку або вилучіть “--artifacts”, щоб завантажити його."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@에는 이 빌드의 Linux용 %1$@에 해당하는 파일이 없습니다(c11은 해시로 대조합니다). 그래서 c11은 대신 다운로드하지 않았습니다. 해당 폴더에 파일을 넣거나, “--artifacts”를 빼고 다운로드하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ 中没有与此构建的 Linux 版 %1$@ 相符的文件（c11 通过哈希进行匹配），因此 c11 没有改为下载。请把该文件放入该文件夹，或去掉“--artifacts”以下载它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ 中沒有與此版本的 Linux 版 %1$@ 相符的檔案（c11 透過雜湊進行比對），因此 c11 沒有改為下載。請把該檔案放入該資料夾，或移除「--artifacts」以下載它。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В %2$@ нет файла, который является Linux-версией %1$@ для этой сборки (c11 сопоставляет его по хешу), поэтому c11 не стал скачивать его вместо этого. Положите файл в эту папку или уберите «--artifacts», чтобы скачать его."
          }
        }
      }
    },
    "machineSetup.install.linuxFiles": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "c11's Linux files"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "c11のLinux用ファイル"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "файли c11 для Linux"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "c11의 Linux용 파일"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "c11 的 Linux 文件"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "c11 的 Linux 檔案"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "файлы c11 для Linux"
          }
        }
      }
    },
    "machineSetup.error.clt": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ needs Apple's Command Line Tools for c11's link. Run “xcode-select --install” on it, then try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "c11のリンクには、%@にAppleのコマンドラインツールが必要です。“xcode-select --install”を実行してから、もう一度お試しください。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для зв’язку c11 на %@ потрібні інструменти командного рядка Apple (Command Line Tools). Виконайте на ній “xcode-select --install” і повторіть спробу."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "c11 연결을 위해 %@에 Apple 명령행 도구가 필요합니다. 해당 머신에서 “xcode-select --install”을 실행한 다음 다시 시도하십시오."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 需要 Apple 命令行工具才能完成 c11 的链接。请在其上运行“xcode-select --install”，然后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 需要 Apple 命令列工具才能完成 c11 的連結。請在其上執行「xcode-select --install」，然後再試一次。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для связи c11 на %@ нужны инструменты командной строки Apple (Command Line Tools). Выполните на ней «xcode-select --install» и повторите попытку."
          }
        }
      }
    },
    "machineSetup.error.ssh": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH to %1$@ failed: %2$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@へのSSH接続に失敗しました: %2$@"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося підключитися до %1$@ через SSH: %2$@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@에 대한 SSH 연결에 실패했습니다: %2$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
