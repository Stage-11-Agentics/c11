    "update.error.secureConnectionFailed.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't open a secure connection to the update server. Try again later."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アップデートサーバーへのセキュア接続を確立できませんでした。後でもう一度試してください。"
          }
        },
        "zh-Hans": {
