    "agentConfigEditor.default.failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't set the default — please try again."
          }
        },
        "ja": { "stringUnit": { "state": "translated", "value": "デフォルトに設定できませんでした。もう一度お試しください。" } },
        "uk": { "stringUnit": { "state": "translated", "value": "Не вдалося зробити конфігурацію типовою. Спробуйте ще раз." } },
        "ko": { "stringUnit": { "state": "translated", "value": "기본값으로 설정하지 못했습니다. 다시 시도해 주세요." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "无法设为默认项，请重试。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "無法設為預設項，請再試一次。" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Не удалось назначить конфигурацию по умолчанию. Попробуйте ещё раз." } }
      }
    },
    "agentConfigEditor.default.unlaunchable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That config can't launch as written, so it can't be the default — give it a command first."
          }
        },
        "ja": { "stringUnit": { "state": "translated", "value": "この設定は現在の内容では起動できないため、デフォルトにできません。先に起動コマンドを設定してください。" } },
        "uk": { "stringUnit": { "state": "translated", "value": "Цю конфігурацію не можна запустити в поточному вигляді, тому її не можна зробити типовою. Спершу задайте команду запуску." } },
        "ko": { "stringUnit": { "state": "translated", "value": "이 설정은 현재 상태로 실행할 수 없어 기본값으로 지정할 수 없습니다. 먼저 실행 명령을 설정해 주세요." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "此配置目前无法启动，因此不能设为默认项。请先设置启动命令。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "此設定目前無法啟動，因此不能設為預設項。請先設定啟動命令。" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Эту конфигурацию нельзя запустить в текущем виде, поэтому её нельзя назначить используемой по умолчанию. Сначала задайте команду запуска." } }
      }
    },
