    "whatsDifferent.point.close.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "End Session stops that terminal and everything it started, background jobs too."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「セッションを終了」を選ぶと、そのターミナルと、それが起動したものすべて（バックグラウンドのジョブも）が停止します。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кнопка «Завершити сеанс» зупиняє цей термінал і все, що він запустив, зокрема фонові завдання."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“세션 종료”를 선택하면 해당 터미널과 그 터미널이 시작한 모든 것이 중단됩니다. 백그라운드 작업도 포함됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“结束会话”会停止该终端以及它启动的所有内容，包括后台任务。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「結束工作階段」會停止該終端機及其啟動的所有項目，包括背景工作。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кнопка «Завершить сеанс» останавливает этот терминал и всё, что он запустил, включая фоновые задачи."
          }
        }
      }
    },
