    "tabRailTip.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The number opens every panel in this area. Rail keeps that list on the left."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "数字を押すと、このエリアのすべてのパネルの一覧が開きます。縦並びなら、その一覧を左に表示したままにできます。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Число відкриває всі панелі цієї області. У вертикальному розташуванні цей список закріплено ліворуч."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "숫자를 누르면 이 영역의 모든 패널 목록이 열립니다. 세로형은 그 목록을 왼쪽에 계속 표시해 줘요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击数字可查看此区域的全部面板。“竖排”会把这份列表固定在左侧。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點擊數字可查看此區域的所有面板。「直排」會把這份清單固定在左側。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Число открывает все панели этой области. При вертикальном расположении этот список остаётся открытым слева."
          }
        }
      }
    },
    "tabRailTip.bodyAfterList": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That list is the number on the bar. Rail keeps it open on the left."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その一覧が、パネルバーの数字です。縦並びなら、左に開いたままにできます。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей список відкривається числом на смузі панелей. У вертикальному розташуванні він залишається відкритим ліворуч."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그 목록이 패널 막대에 표시된 숫자예요. 세로형은 그것을 왼쪽에 계속 열어 둡니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "那份列表就是面板栏上的数字。“竖排”会让它一直展开在左侧。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "那份清單就是面板列上的數字。「直排」會讓它一直展開在左側。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот список открывается числом в строке панелей. При вертикальном расположении он остаётся открытым слева."
          }
        }
      }
    },
