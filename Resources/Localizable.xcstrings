          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "c11이 업데이트를 다운로드했지만 설치 프로그램을 실행할 수 없어요. 최신 버전을 다운로드해서 응용 프로그램 폴더의 c11을 교체하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "c11 загрузил обновление, но не смог запустить установщик. Скачайте последнюю версию и замените c11 в папке «Программы»."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "c11 завантажив оновлення, але не зміг запустити інсталятор. Завантажте найновішу версію та замініть c11 у теці «Програми»."
          }
        }
      }
    },
