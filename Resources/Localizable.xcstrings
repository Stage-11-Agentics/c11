      }
    },
    "machineSetup.error.inUse": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "c11's hc file on %@ differs from this build's and is running, so it wasn't replaced. Remove the machine (which ends its c11 terminals), then add it again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 上の c11 の hc ファイルはこのビルドのものと異なり、実行中のため置き換えられませんでした。マシンを削除し(c11 のターミナルも終了します)、もう一度追加してください。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл hc c11 на %@ відрізняється від файлу цієї збірки та використовується, тому його не було замінено. Видаліть машину (це завершить її термінали c11), потім додайте її знову."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@의 c11 hc 파일이 이 빌드의 파일과 다르고 실행 중이어서 교체되지 않았습니다. 머신을 제거한 다음(c11 터미널도 종료됩니다) 다시 추가하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 上的 c11 hc 文件与此版本的不同且正在运行,因此未被替换。请移除该机器(这会结束其 c11 终端),然后重新添加。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 上的 c11 hc 檔案與此版本的不同且正在執行,因此未被取代。請移除該機器(這會結束其 c11 終端機),然後重新加入。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл hc c11 на %@ отличается от файла этой сборки и запущен, поэтому он не был заменён. Удалите машину (это завершит её терминалы c11), затем добавьте её снова."
          }
        }
      }
    },
