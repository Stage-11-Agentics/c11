    "settings.sidebarBackground": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Sidebar Background"}},
        "ja": {"stringUnit": {"state": "translated", "value": "サイドバーの背景"}},
        "uk": {"stringUnit": {"state": "translated", "value": "Тло бічної панелі"}},
        "ko": {"stringUnit": {"state": "translated", "value": "사이드바 배경"}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "侧边栏背景"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "側邊欄背景"}},
        "ru": {"stringUnit": {"state": "translated", "value": "Фон бокового меню"}}
      }
    },
    "settings.sidebarBackground.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Shown behind the sidebar in the Dark theme slot, over the Dark Mode Tint. Choose None to use the tint. The Light theme slot keeps the tint."}},
        "ja": {"stringUnit": {"state": "translated", "value": "ダークテーマスロットで、ダークモードのティントの上、サイドバーの背後に表示されます。「なし」を選ぶとティントが使われます。ライトテーマスロットではティントがそのまま使われます。"}},
        "uk": {"stringUnit": {"state": "translated", "value": "Показується за бічною панеллю в слоті темної теми, поверх відтінку темного режиму. Виберіть «Немає», щоб використовувати відтінок. Слот світлої теми зберігає відтінок."}},
        "ko": {"stringUnit": {"state": "translated", "value": "다크 테마 슬롯에서 다크 모드 색조 위, 사이드바 뒤에 표시됩니다. 색조를 사용하려면 '없음'을 선택하세요. 라이트 테마 슬롯은 색조를 그대로 유지합니다."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "在深色主题槽中显示于侧边栏后方，叠加在深色模式色调之上。选择“无”则使用色调。浅色主题槽保持使用色调。"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "在深色主題配置中顯示於側邊欄後方，疊加在深色模式色調之上。選擇「無」則使用色調。淺色主題配置維持使用色調。"}},
        "ru": {"stringUnit": {"state": "translated", "value": "Отображается за боковым меню в слоте тёмной темы, поверх оттенка тёмного режима. Выберите «Нет», чтобы использовать оттенок. В слоте светлой темы остаётся оттенок."}}
      }
    },
    "settings.sidebarBackground.sunsetMall": {
