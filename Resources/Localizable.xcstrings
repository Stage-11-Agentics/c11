    "terminal.remoteDrop.refusedInApp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Files dragged from inside c11 aren't sent to another machine. Drag them from Finder to send them."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "c11内からドラッグしたファイルは、別のマシンに送信されません。送信するには、Finderからドラッグしてください。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Файли, перетягнуті з c11, не надсилаються на інший комп’ютер. Щоб надіслати їх, перетягніть їх із Finder."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "c11 내부에서 드래그한 파일은 다른 컴퓨터로 보내지지 않습니다. 파일을 보내려면 Finder에서 드래그하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从 c11 内部拖移的文件不会发送到其他电脑。要发送文件,请从 Finder 中拖入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從 c11 內部拖移的檔案不會傳送到其他電腦。若要傳送檔案,請從 Finder 拖入。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файлы, перетащенные из c11, не отправляются на другой компьютер. Чтобы отправить их, перетащите файлы из Finder."
          }
        }
      }
    },
    "cli.snapshot.out.snapshotKept": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "The snapshot itself was saved to %@."}},
        "ja": {"stringUnit": {"state": "translated", "value": "スナップショット自体は %@ に保存されました。"}},
        "uk": {"stringUnit": {"state": "translated", "value": "Сам знімок збережено в %@."}},
        "ko": {"stringUnit": {"state": "translated", "value": "스냅샷 자체는 %@에 저장되었습니다."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "快照本身已保存到 %@。"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "快照本身已儲存到 %@。"}},
        "ru": {"stringUnit": {"state": "translated", "value": "Сам снимок сохранён в %@."}}
      }
    },
    "cli.socket.foreignPeer": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "The socket at %@ is served by another user's process. Refusing to send to it."}},
        "ja": {"stringUnit": {"state": "translated", "value": "%@ のソケットは別のユーザーのプロセスが提供しています。送信しません。"}},
        "uk": {"stringUnit": {"state": "translated", "value": "Сокет %@ обслуговується процесом іншого користувача. Відмовляюся надсилати до нього."}},
        "ko": {"stringUnit": {"state": "translated", "value": "%@의 소켓은 다른 사용자의 프로세스가 제공하고 있습니다. 전송하지 않습니다."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "位于 %@ 的套接字由其他用户的进程提供服务。拒绝向其发送。"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "位於 %@ 的 socket 由其他使用者的行程提供服務。拒絕傳送。"}},
        "ru": {"stringUnit": {"state": "translated", "value": "Сокет %@ обслуживается процессом другого пользователя. Отправка отклонена."}}
      }
    },
    "cli.state.save.snapshotKept": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "The session snapshot itself was saved to %@."}},
        "ja": {"stringUnit": {"state": "translated", "value": "セッションスナップショット自体は %@ に保存されました。"}},
        "uk": {"stringUnit": {"state": "translated", "value": "Сам знімок сеансу збережено в %@."}},
        "ko": {"stringUnit": {"state": "translated", "value": "세션 스냅샷 자체는 %@에 저장되었습니다."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "会话快照本身已保存到 %@。"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "工作階段快照本身已儲存到 %@。"}},
        "ru": {"stringUnit": {"state": "translated", "value": "Сам снимок сеанса сохранён в %@."}}
      }
    },
    "cli.waitFor.channelRefused": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "wait-for refused '%1$@': %2$@ is not a signal file this user created."}},
        "ja": {"stringUnit": {"state": "translated", "value": "wait-for は '%1$@' を拒否しました: %2$@ は、このユーザーが作成したシグナルファイルではありません。"}},
        "uk": {"stringUnit": {"state": "translated", "value": "wait-for відхилив '%1$@': %2$@ не є файлом сигналу, створеним цим користувачем."}},
        "ko": {"stringUnit": {"state": "translated", "value": "wait-for가 '%1$@'을(를) 거부했습니다. %2$@은(는) 이 사용자가 만든 신호 파일이 아닙니다."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "wait-for 拒绝了 '%1$@'：%2$@ 不是此用户创建的信号文件。"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "wait-for 拒絕了 '%1$@'：%2$@ 不是此使用者建立的訊號檔案。"}},
        "ru": {"stringUnit": {"state": "translated", "value": "wait-for отклонил '%1$@': %2$@ не является файлом сигнала, созданным этим пользователем."}}
      }
    },
    "cli.waitFor.folderUnsafe": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "wait-for cannot use its private folder: %@"}},
        "ja": {"stringUnit": {"state": "translated", "value": "wait-for は専用フォルダを使用できません: %@"}},
        "uk": {"stringUnit": {"state": "translated", "value": "wait-for не може використовувати свою приватну теку: %@"}},
        "ko": {"stringUnit": {"state": "translated", "value": "wait-for가 전용 폴더를 사용할 수 없습니다: %@"}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "wait-for 无法使用其专用文件夹：%@"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "wait-for 無法使用其專用資料夾：%@"}},
        "ru": {"stringUnit": {"state": "translated", "value": "wait-for не может использовать свою приватную папку: %@"}}
      }
    },
    "cli.waitFor.signalRefused": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "wait-for -S did not signal '%1$@': %2$@ is not a signal file this user created."}},
        "ja": {"stringUnit": {"state": "translated", "value": "wait-for -S は '%1$@' にシグナルを送信しませんでした: %2$@ は、このユーザーが作成したシグナルファイルではありません。"}},
        "uk": {"stringUnit": {"state": "translated", "value": "wait-for -S не подав сигнал '%1$@': %2$@ не є файлом сигналу, створеним цим користувачем."}},
        "ko": {"stringUnit": {"state": "translated", "value": "wait-for -S가 '%1$@'에 신호를 보내지 않았습니다. %2$@은(는) 이 사용자가 만든 신호 파일이 아닙니다."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "wait-for -S 未向 '%1$@' 发送信号：%2$@ 不是此用户创建的信号文件。"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "wait-for -S 未向 '%1$@' 發送訊號：%2$@ 不是此使用者建立的訊號檔案。"}},
        "ru": {"stringUnit": {"state": "translated", "value": "wait-for -S не подал сигнал '%1$@': %2$@ не является файлом сигнала, созданным этим пользователем."}}
      }
    },
