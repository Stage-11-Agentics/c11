    "settings.activityHistory.analytics.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record foreground, workspace, and app health events."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォアグラウンド、ワークスペース、アプリの状態に関するイベントを記録します。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Записувати події активного вікна, робочих просторів і стану застосунку."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "포그라운드, 워크스페이스, 앱 상태 이벤트를 기록해요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
