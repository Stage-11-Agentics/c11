  "strings": {
    "agentCompanion.identity.unknownAgent": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unknown agent"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "不明なエージェント"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Невідомий агент"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알 수 없는 에이전트"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未知智能体"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未知的代理"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Неизвестный агент"
          }
        }
      }
    },
    "agentCompanion.portal.accessibilityLabel": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent companion browser privacy veil"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントコンパニオンのブラウザーを隠すプライバシーベール"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Завіса приватності браузера агента-супутника"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이전트 컴패니언 브라우저 개인정보 보호 가림막"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "智能体配套浏览器隐私遮罩"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "代理伴隨瀏覽器隱私遮罩"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Завеса приватности браузера-компаньона агента"
          }
        }
      }
    },
    "agentCompanion.portal.activeDetail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is active. Reveal this page only if you intend to cross agent contexts."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ がアクティブです。エージェントのコンテキストをまたぐ意図がある場合にのみ、このページを表示してください。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ активний. Відкривайте цю сторінку, лише якщо справді хочете перетнути контексти агентів."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@이(가) 활성 상태입니다. 에이전트 컨텍스트를 넘나들려는 경우에만 이 페이지를 표시하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 处于活动状态。仅当你确实要跨智能体上下文查看时，才显示此页面。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 運作中。只有在你有意跨越代理情境時，才顯示此頁面。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ активен. Открывайте эту страницу, только если намерены пересечь контексты агентов."
          }
        }
      }
    },
    "agentCompanion.portal.genericTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This companion page is private"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このコンパニオンページは非公開です"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ця сторінка-супутник приватна"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 컴패니언 페이지는 비공개입니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此配套页面为私有页面"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此伴隨頁面為私人頁面"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта страница-компаньон приватна"
          }
        }
      }
    },
    "agentCompanion.portal.linkedTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This page belongs to %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このページは %@ に属しています"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ця сторінка належить агенту %@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 페이지는 %@의 것입니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此页面属于 %@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此頁面屬於 %@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта страница принадлежит %@"
          }
        }
      }
    },
    "agentCompanion.portal.orphanedDetail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The linked agent %@ is no longer available."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リンク先のエージェント %@ は利用できなくなりました。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пов’язаний агент %@ більше недоступний."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결된 에이전트 %@을(를) 더 이상 사용할 수 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所关联的智能体 %@ 已不可用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已連結的代理 %@ 已無法使用。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Связанный агент %@ больше не доступен."
          }
        }
      }
    },
