        "uk": {"stringUnit": {"state": "translated", "value": "Перейти до наступного агента з позначкою"}},
        "ko": {"stringUnit": {"state": "translated", "value": "다음 플래그된 에이전트로 이동"}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "跳转到下一个已标记的代理"}},
