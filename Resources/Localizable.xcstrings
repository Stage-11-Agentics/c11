          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 페이지에서 대화상자를 표시하려고 합니다. 페이지를 클릭하면 볼 수 있습니다."
          }
        },
        "zh-Hans": {
