    "machineSetup.done": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is linked. Open a terminal there with File > New Terminal on %@, or pick it when c11 asks."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@をリンクしました。“ファイル > %@で新規ターミナル”を選ぶか、c11が尋ねたときに選択すると、そこでターミナルを開けます。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ зв’язано. Відкрийте там термінал через Файл > Новий термінал на %@ або виберіть його, коли c11 запитає."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@이(가) 연결되었습니다. 파일 > %@에서 새로운 터미널을 선택하거나 c11에서 물을 때 선택하여 해당 머신에서 터미널을 여십시오."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已链接。请通过“文件 > 在 %@ 上新建终端”在其上打开终端，或在 c11 询问时选择它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已連結。請透過「檔案 > 在 %@ 上新增終端機」在其上打開終端機，或在 c11 詢問時選擇它。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ связана. Откройте там терминал через «Файл > Новый терминал на %@» или выберите её, когда c11 спросит."
          }
        }
      }
    },
