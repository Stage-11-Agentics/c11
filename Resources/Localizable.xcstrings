    "settings.app.sidebarDensity.subtitleAutomatic": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Full cards while every workspace fits; two-line cards once they would scroll."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのワークスペースが収まるうちはフルカード、スクロールが必要になると2行カードにします。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有工作区都能放下时显示完整卡片，需要滚动时改为两行卡片。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所有工作區都放得下時顯示完整卡片，需要捲動時改為兩行卡片。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 작업 공간이 들어가면 전체 카드로, 스크롤이 필요해지면 두 줄 카드로 표시합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Полные карточки, пока все рабочие пространства помещаются; двухстрочные, когда понадобилась бы прокрутка."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Повні картки, поки всі робочі простори вміщуються; дворядкові, коли довелося б прокручувати."
          }
        }
      }
    },
    "settings.app.sidebarDensity.subtitleCompact": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Always two-line cards: name, number, agent marks and counts. Hover a card for the rest."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "常に2行カード：名前、番号、エージェントのマーク、件数。詳細はカードにカーソルを合わせると表示されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "始终显示两行卡片：名称、编号、代理标记和数量。悬停在卡片上可查看其余内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一律顯示兩行卡片：名稱、編號、代理標記和數量。將游標移到卡片上可查看其餘內容。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "항상 두 줄 카드: 이름, 번호, 에이전트 마크, 개수. 나머지는 카드에 마우스를 올리면 표시됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всегда двухстрочные карточки: имя, номер, метки агентов и счётчики. Наведите курсор на карточку, чтобы увидеть остальное."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Завжди дворядкові картки: назва, номер, позначки агентів і лічильники. Наведіть на картку, щоб побачити решту."
          }
        }
      }
    },
    "settings.app.sidebarDensity.subtitleCards": {
      "extractionState": "manual",
