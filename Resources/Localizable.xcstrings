    "machineSetup.consent.keys": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "c11 signs in with your SSH keys, installs its own hc there and starts it whenever this Mac connects, and never forwards your SSH agent, X11 or ports there."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "c11はあなたのSSH鍵でサインインし、専用のhcをそこにインストールして、このMacが接続するたびに起動します。また、SSHエージェント、X11、ポートをそこへ転送することはありません。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "c11 входить за вашими ключами SSH, встановлює там власний hc і запускає його щоразу, коли цей Mac підключається, а також ніколи не пересилає туди ваш агент SSH, X11 чи порти."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "c11은 사용자의 SSH 키로 로그인하고, 해당 머신에 자체 hc를 설치하며, 이 Mac이 연결될 때마다 hc를 시작하고, SSH 에이전트, X11, 포트를 그쪽으로 포워딩하지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "c11 使用你的 SSH 密钥登录，在该机器上安装自己的 hc，并在这台 Mac 每次连接时启动它，且绝不会向该机器转发 SSH 代理、X11 或端口。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "c11 使用你的 SSH 金鑰登入，在該機器上安裝自己的 hc，並在這台 Mac 每次連線時啟動它，且絕不會向該機器轉發 SSH 代理、X11 或連接埠。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "c11 входит по вашим ключам SSH, устанавливает там собственный hc и запускает его при каждом подключении этого Mac, а также никогда не пробрасывает туда ваш агент SSH, X11 или порты."
          }
        }
      }
    },
    "machineSetup.consent.asYou": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Anything you or an agent runs in a c11 terminal there runs as you, with your files and keys on that machine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そちらのc11ターミナルであなたやエージェントが実行したものは、そのマシン上のファイルや鍵を使って、あなたとして実行されます。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Усе, що ви або агент запускаєте в терміналі c11 на тій машині, виконується від вашого імені, з вашими файлами й ключами на ній."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "해당 머신의 c11 터미널에서 사용자나 에이전트가 실행하는 모든 것은 그 머신의 파일과 키를 사용해 사용자 권한으로 실행됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你或智能体在该机器的 c11 终端中运行的任何内容，都会以你的身份运行，可使用该机器上的文件和密钥。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你或代理程式在該機器的 c11 終端機中執行的任何內容，都會以你的身分執行，可使用該機器上的檔案和金鑰。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё, что вы или агент запускаете в терминале c11 на той машине, выполняется от вашего имени, с вашими файлами и ключами на ней."
          }
        }
      }
    },
    "machineSetup.consent.sameAccount": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Any program running as you on %@ can read and type into the c11 terminals there. hc has no per-program check."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@上であなたとして動作する任意のプログラムは、そこのc11ターミナルを読み取り、入力できます。hcにはプログラムごとの確認がありません。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Будь-яка програма, запущена від вашого імені на %@, може читати термінали c11 там і вводити в них текст. hc не перевіряє окремі програми."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에서 사용자 권한으로 실행 중인 모든 프로그램은 그곳의 c11 터미널을 읽고 입력할 수 있습니다. hc는 프로그램별 확인을 하지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 上以你的身份运行的任何程序，都可以读取并向那里的 c11 终端输入内容。hc 不会逐个程序检查。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 上以你的身分執行的任何程式，都可以讀取並向那裡的 c11 終端機輸入內容。hc 不會逐一檢查程式。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Любая программа, запущенная от вашего имени на %@, может читать терминалы c11 там и вводить в них текст. У hc нет проверки для отдельных программ."
          }
        }
      }
    },
    "machineSetup.consent.checks": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "c11 checks hc's hash before it runs it, keeps hc's folders private, and records every cross-machine action in its audit log. For a Linux machine, c11 first downloads its Linux hc and c11 from c11's release, about 75 MB once, and checks each against this build's hash."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "c11はhcを実行する前にそのハッシュを確認し、hcのフォルダを非公開に保ち、マシン間の操作をすべて監査ログに記録します。Linuxマシンの場合、c11はまずc11のリリースからLinux用のhcとc11を一度だけ約75 MBダウンロードし、それぞれをこのビルドのハッシュと照合します。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "c11 перевіряє хеш hc перед запуском, тримає теки hc закритими й записує кожну дію між машинами в журнал аудиту. Для машини з Linux c11 спершу один раз завантажує з випуску c11 свої версії hc і c11 для Linux, приблизно 75 МБ, і перевіряє кожну за хешем цієї збірки."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "c11은 hc를 실행하기 전에 해시를 확인하고, hc의 폴더를 비공개로 유지하며, 머신 간 작업을 모두 감사 로그에 기록합니다. Linux 머신의 경우 c11은 먼저 c11 릴리스에서 Linux용 hc와 c11을 한 번, 약 75 MB 내려받고 각각을 이 빌드의 해시와 대조합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "c11 在运行 hc 之前会检查其哈希，保持 hc 的文件夹私有，并把每个跨机器操作记录到审计日志中。对于 Linux 机器，c11 会先从 c11 的发布版中下载其 Linux 版 hc 和 c11（仅一次，约 75 MB），并将各自与此构建的哈希进行核对。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "c11 在執行 hc 之前會檢查其雜湊，保持 hc 的資料夾私人，並將每個跨機器操作記錄到稽核日誌中。對於 Linux 機器，c11 會先從 c11 的發行版下載其 Linux 版 hc 與 c11（僅一次，約 75 MB），並將各自與此版本的雜湊核對。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "c11 проверяет хеш hc перед запуском, держит папки hc закрытыми и записывает каждое межмашинное действие в журнал аудита. Для машины с Linux c11 сначала один раз скачивает из релиза c11 свои версии hc и c11 для Linux, примерно 75 МБ, и сверяет каждую с хешем этой сборки."
          }
        }
      }
    },
    "machineSetup.trust.title": {
      "extractionState": "manual",
      "localizations": {
