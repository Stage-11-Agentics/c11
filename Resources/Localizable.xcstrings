            "value": "Open hc Core"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "hc コアを開く"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкрити ядро hc"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "hc 코어 열기"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开 hc 核心"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "打開 hc 核心"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открыть ядро hc"
          }
        }
      }
    },
    "whatsDifferent.link.machines": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Herder Topography"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Herder トポグラフィーを開く"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкрити топографію herder"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "허더 토폴로지 열기"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开 Herder 拓扑"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "打開 Herder 拓撲"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открыть топографию herder"
          }
        }
      }
    },
    "whatsDifferent.machines.agents.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "They set their status, raise flags and send mail. Link only machines you trust: linking gives c11 a shell there as you."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ステータスの設定、フラグの送信、メールの送信ができます。信頼できるマシンだけをリンクしてください。リンクすると、c11があなたとしてそのマシンのシェルを使えるようになります。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вони встановлюють свій статус, піднімають прапорці й надсилають пошту. З’єднуйте лише комп’ютери, яким довіряєте: з’єднання дає c11 оболонку там від вашого імені."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "상태를 설정하고, 플래그를 올리고, 메일을 보냅니다. 신뢰하는 컴퓨터만 연결하세요. 연결하면 c11이 그 컴퓨터에서 사용자로서 셸을 쓰게 됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它们会设置自己的状态、举旗并发送邮件。只链接你信任的设备：链接后，c11 会以你的身份在那里获得一个 shell。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "它們會設定自己的狀態、舉旗並傳送郵件。只連結你信任的機器：連結後，c11 會以你的身分在那裡取得一個 shell。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Они задают свой статус, поднимают флаги и отправляют почту. Связывайте только те компьютеры, которым доверяете: связь даёт c11 оболочку там от вашего имени."
          }
        }
      }
    },
    "whatsDifferent.machines.agents.lead": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Agents there work as local ones."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そこのエージェントも、ローカルのエージェントと同じように動きます。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Агенти там працюють так само, як локальні."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그곳의 에이전트도 로컬 에이전트처럼 일합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "那里的智能体与本地智能体一样工作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "那裡的代理程式和本機代理程式一樣運作。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Агенты там работают как локальные."
          }
        }
      }
    },
    "whatsDifferent.machines.label.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each terminal's title bar names its machine, in a color you choose. Reconnecting means the link is down; the session itself is fine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各ターミナルのタイトルバーには、そのマシンの名前が、あなたが選んだ色で表示されます。「再接続中」は接続が切れているという意味で、セッション自体は無事です。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У заголовку кожного термінала вказано його комп’ютер кольором, який ви вибираєте. «Повторне підключення» означає, що зв’язок перервано, але сам сеанс у порядку."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 터미널의 제목 막대에는 해당 컴퓨터 이름이 직접 고른 색으로 표시됩니다. “다시 연결 중”은 연결이 끊어졌다는 뜻이며, 세션 자체는 정상입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个终端的标题栏会用你选的颜色显示它所在的设备名称。“正在重新连接”表示连接已断开，会话本身没有问题。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每個終端機的標題列會用你選的顏色顯示它所在的機器名稱。「正在重新連線」表示連線中斷，工作階段本身沒有問題。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В заголовке каждого терминала указан его компьютер, цветом на ваш выбор. Метка «Переподключение» означает, что связь прервана, но сам сеанс в порядке."
          }
        }
      }
    },
    "whatsDifferent.machines.link.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings > Herder Topography > Add Machine…, or `c11 machine link --host <ssh-target>`. c11 installs its own hc there."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定 > Herder トポグラフィー > マシンを追加… を使うか、`c11 machine link --host <ssh-target>` を実行します。c11がそこに専用のhcをインストールします。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Налаштування > Топографія herder > Додати машину… або `c11 machine link --host <ssh-target>`. c11 встановлює там власний hc."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정 > 허더 토폴로지 > 머신 추가…를 사용하거나 `c11 machine link --host <ssh-target>`을 실행하세요. c11이 그곳에 자체 hc를 설치합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用“设置 > Herder 拓扑 > 添加机器…”，或运行 `c11 machine link --host <ssh-target>`。c11 会在那里安装它自己的 hc。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用「設定 > Herder 拓撲 > 加入機器…」，或執行 `c11 machine link --host <ssh-target>`。c11 會在那裡安裝它自己的 hc。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настройки > Топография herder > Добавить машину… или `c11 machine link --host <ssh-target>`. c11 устанавливает там собственный hc."
          }
        }
      }
    },
    "whatsDifferent.machines.link.lead": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Link one."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まず一台リンクします。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "З’єднайте один."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하나 연결해 보세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "链接一台。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連結一部。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Свяжите один."
          }
        }
      }
    },
    "whatsDifferent.machines.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Link a Mac or an x86-64 Linux machine you reach over SSH, and its terminals sit in this window beside the ones on this Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "SSHで接続できるMacまたはx86-64のLinuxマシンをリンクすると、そのターミナルが、このMacのターミナルと並んでこのウインドウに表示されます。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "З’єднайте Mac або комп’ютер x86-64 з Linux, до якого ви маєте доступ через SSH, і його термінали з’являться в цьому вікні поруч із терміналами на цьому Mac."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH로 접속할 수 있는 Mac 또는 x86-64 Linux 컴퓨터를 연결하면, 그 터미널이 이 Mac의 터미널과 나란히 이 윈도우에 표시됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "链接一台可通过 SSH 访问的 Mac 或 x86-64 Linux 设备，它的终端就会和这台 Mac 上的终端并排出现在这个窗口中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連結一部可透過 SSH 連線的 Mac 或 x86-64 Linux 機器，它的終端機就會和這部 Mac 上的終端機並排出現在這個視窗中。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Свяжите Mac или компьютер с Linux x86-64, к которому вы подключаетесь по SSH, и его терминалы появятся в этом окне рядом с терминалами на этом Mac."
          }
        }
      }
    },
    "whatsDifferent.machines.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your terminals can run on other machines."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ターミナルは、ほかのマシンでも動かせます。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваші термінали можуть працювати на інших комп’ютерах."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "터미널을 다른 컴퓨터에서 실행할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的终端可以在其他设备上运行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的終端機可以在其他機器上執行。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши терминалы могут работать на других компьютерах."
          }
        }
      }
    },
    "whatsDifferent.machines.where.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New Terminal and agent launches ask where to run. From the command line, add `--on <machine>`."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「新規ターミナル」とエージェントの起動では、どこで実行するかを尋ねられます。コマンドラインでは `--on <machine>` を付けます。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Новий термінал» і запуск агентів запитують, де виконувати. У командному рядку додайте `--on <machine>`."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“새 터미널”과 에이전트 실행 시 어디서 실행할지 묻습니다. 명령줄에서는 `--on <machine>`을 추가하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“新建终端”和启动智能体时，会询问在哪里运行。在命令行中，加上 `--on <machine>`。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「新增終端機」和啟動代理程式時，會詢問要在哪裡執行。在命令列中，加上 `--on <machine>`。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Новый терминал» и запуск агентов спрашивают, где выполнять. В командной строке добавьте `--on <machine>`."
          }
        }
      }
    },
    "whatsDifferent.machines.where.lead": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose where."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "場所を選べます。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оберіть, де."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위치를 고르세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择在哪里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇在哪裡。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите, где."
          }
        }
      }
    },
    "whatsDifferent.mail.address.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "`c11 mailbox send --to <address>`, or `--to-parent` for the agent that launched it. Agents on linked machines send the same way."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "`c11 mailbox send --to <address>` を使います。起動元のエージェントに送るには `--to-parent` を使います。リンクしたマシン上のエージェントも同じ方法で送れます。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "`c11 mailbox send --to <address>` або `--to-parent` для агента, який його запустив. Агенти на під’єднаних комп’ютерах надсилають так само."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "`c11 mailbox send --to <address>`를 사용하거나, 자신을 실행한 에이전트에게는 `--to-parent`를 사용하세요. 연결된 컴퓨터의 에이전트도 같은 방식으로 보냅니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 `c11 mailbox send --to <address>`，若要发给启动它的智能体，则用 `--to-parent`。已连接设备上的智能体以同样的方式发送。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 `c11 mailbox send --to <address>`，若要寄給啟動它的代理程式，則用 `--to-parent`。已連結機器上的代理程式以同樣的方式傳送。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "`c11 mailbox send --to <address>` или `--to-parent` для агента, который его запустил. Агенты на подключённых компьютерах отправляют так же."
          }
        }
      }
    },
    "whatsDifferent.mail.address.lead": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Address an agent."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントを宛先にします。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Адресуйте агента."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이전트를 지정하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "指定收件的智能体。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "指定收件的代理程式。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Адресуйте агента."
          }
        }
      }
    },
    "whatsDifferent.mail.cell.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The mailbox cell under each terminal opens its thread."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各ターミナルの下にあるメールボックスのセルを押すと、そのターミナルのスレッドが開きます。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Комірка поштової скриньки під кожним терміналом відкриває листування цього термінала."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 터미널 아래의 메일함 셀을 누르면 해당 터미널의 스레드가 열립니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个终端下方的邮箱单元格会打开该终端的对话。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每個終端機下方的郵箱格會打開該終端機的對話串。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ячейка почтового ящика под каждым терминалом открывает переписку этого терминала."
          }
        }
      }
    },
    "whatsDifferent.mail.cell.lead": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every panel has one."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どのパネルにもあります。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Є в кожної панелі."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 패널에 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个面板都有一个。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每個面板都有一個。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Есть у каждой панели."
          }
        }
      }
    },
    "whatsDifferent.mail.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every panel has a mailbox. Agents hand off work, report back and ask questions without typing into each other's terminals."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どのパネルにもメールボックスがあります。エージェントは、互いのターミナルに入力することなく、作業を引き継ぎ、報告し、質問できます。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У кожної панелі є поштова скринька. Агенти передають роботу, звітують і ставлять запитання, не вводячи нічого в термінали одне одного."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 패널에는 메일함이 있습니다. 에이전트는 서로의 터미널에 입력하지 않고도 작업을 넘기고, 결과를 보고하고, 질문할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个面板都有一个邮箱。智能体无需在彼此的终端里输入，就能交接工作、回报结果和提出问题。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每個面板都有一個郵箱。代理程式不必在彼此的終端機中輸入，就能交接工作、回報結果和提出問題。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У каждой панели есть почтовый ящик. Агенты передают работу, отчитываются и задают вопросы, не печатая в терминалах друг друга."
          }
        }
      }
    },
    "whatsDifferent.mail.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Agents send each other mail."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェント同士がメールを送り合います。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Агенти надсилають одне одному пошту."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이전트가 서로에게 메일을 보냅니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "智能体之间可以互发邮件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "代理程式之間可以互寄郵件。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Агенты отправляют друг другу почту."
          }
        }
      }
    },
    "whatsDifferent.mail.wait.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It arrives when the agent is idle, never mid-turn, and survives a relaunch. `c11 mailbox status <id>` says where a message is and why."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メールは、エージェントがアイドル状態のときに届き、処理の途中で届くことはなく、再起動しても失われません。`c11 mailbox status <id>` で、メッセージの現在地とその理由がわかります。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Лист надходить, коли агент вільний, ніколи посеред ходу, і переживає перезапуск. `c11 mailbox status <id>` показує, де повідомлення і чому."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메일은 에이전트가 쉬고 있을 때 도착하며, 작업 도중에는 절대 도착하지 않고, 다시 실행해도 사라지지 않습니다. `c11 mailbox status <id>`로 메시지가 어디에 있고 왜 그런지 확인할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "邮件会在智能体空闲时送达，绝不会在它处理到一半时打断，重启后也不会丢失。`c11 mailbox status <id>` 会告诉你消息在哪里、为什么在那里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "郵件會在代理程式閒置時送達，絕不會在它處理到一半時打斷，重新啟動後也不會遺失。`c11 mailbox status <id>` 會告訴你訊息在哪裡、為什麼在那裡。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Письмо приходит, когда агент свободен, никогда посреди хода, и переживает перезапуск. `c11 mailbox status <id>` показывает, где сообщение и почему."
          }
        }
      }
    },
    "whatsDifferent.mail.wait.lead": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mail waits for a free moment."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メールは空き時間まで待ちます。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пошта чекає на вільну мить."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메일은 여유가 생길 때까지 기다립니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "邮件会等到有空的时候。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "郵件會等到有空的時候。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Почта ждёт свободной минуты."
          }
        }
      }
    },
    "whatsDifferent.mail.web.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "`c11 messages view` draws every conversation as a web."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "`c11 messages view` は、すべての会話を網目状の図として描きます。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "`c11 messages view` малює кожну розмову як мережу."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "`c11 messages view`는 모든 대화를 거미줄 모양으로 그려 줍니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "`c11 messages view` 会把每一段对话画成一张网。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "`c11 messages view` 會把每一段對話畫成一張網。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "`c11 messages view` рисует все переписки в виде сети."
          }
        }
      }
    },
    "whatsDifferent.mail.web.lead": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See who talks to whom."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "誰が誰と話しているかが見えます。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бачте, хто з ким спілкується."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "누가 누구와 대화하는지 보세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "看看谁在和谁交流。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "看看誰在和誰交流。"
          }
        },
        "ru": {
