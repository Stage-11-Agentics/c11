    "update.error.installerLaunch.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "c11 downloaded the update but couldn’t launch the installer. Download the latest version and replace c11 in your Applications folder."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "c11 はアップデートをダウンロードしましたが、インストーラを起動できませんでした。最新版をダウンロードして、アプリケーションフォルダの c11 を置き換えてください。"
          }
        },
        "zh-Hans": {
