    "cli.conversation.find.ambiguous": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "find --open needs one session. %lld matched. Pass --session."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "find --open にはセッションが 1 件必要です。%lld 件が一致しました。--session を指定してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "find --open 에는 세션이 하나 필요합니다. %lld개가 일치했습니다. --session 을 지정하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "find --open нужна одна сессия. Совпало: %lld. Укажите --session."
