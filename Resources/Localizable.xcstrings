    "sidebarIcon.error.workspaceTooLong": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too long for a workspace icon: %lld characters at most. Pick an emoji or a shorter symbol name."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ワークスペースのアイコンとしては長すぎます。最大%lld文字です。絵文字か、もっと短いシンボル名を選んでください。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Занадто довго для піктограми робочого простору: щонайбільше %lld символів. Виберіть емодзі або коротшу назву символу."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "워크스페이스 아이콘으로는 너무 깁니다. 최대 %lld자입니다. 이모티콘이나 더 짧은 심볼 이름을 선택하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "作为工作区图标太长了：最多 %lld 个字符。请选择表情符号或更短的符号名称。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "作為工作區圖示太長了：最多 %lld 個字元。請選擇表情符號或更短的符號名稱。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Слишком длинно для значка рабочего пространства: не более %lld символов. Выберите эмодзи или более короткое имя символа."
          }
        }
      }
    },
