    "mailbox.conversations.footer.long": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "The drawer never sends, claims or deletes mail. Agents reply with c11 mailbox send."}},
        "ja": {"stringUnit": {"state": "translated", "value": "ドロワーはメールの送信・受け取り・削除を行いません。エージェントは c11 mailbox send で返信します。"}},
        "uk": {"stringUnit": {"state": "translated", "value": "Панель ніколи не надсилає, не забирає і не видаляє пошту. Агенти відповідають командою c11 mailbox send."}},
        "ko": {"stringUnit": {"state": "translated", "value": "서랍은 메일을 보내거나 가져가거나 삭제하지 않습니다. 에이전트는 c11 mailbox send로 답장합니다."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "抽屉从不发送、取走或删除邮件。智能体通过 c11 mailbox send 回复。"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "抽屜從不傳送、取走或刪除郵件。代理透過 c11 mailbox send 回覆。"}},
        "ru": {"stringUnit": {"state": "translated", "value": "Панель никогда не отправляет, не забирает и не удаляет почту. Агенты отвечают командой c11 mailbox send."}}
      }
    },
