    "machineSetup.intro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "c11 signs in to the other machine (a Mac, or a Linux machine) with your SSH keys, installs its own hc there, and links it. Terminals you open on it run there and appear here."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "c11はSSH鍵を使って別のマシン（MacまたはLinuxマシン）にサインインし、専用のhcをインストールしてリンクします。そのマシンで開いたターミナルはそこで実行され、ここに表示されます。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "c11 входить на інший комп’ютер (Mac або машину з Linux) за вашими ключами SSH, установлює там власний hc і зв’язує його. Термінали, які ви відкриваєте на ньому, працюють там і відображаються тут."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "c11은 사용자의 SSH 키로 다른 머신(Mac 또는 Linux 머신)에 로그인하여 자체 hc를 설치하고 연결합니다. 해당 머신에서 여는 터미널은 그곳에서 실행되며 여기에 표시됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "c11 使用你的 SSH 密钥登录另一台机器（Mac 或 Linux 机器），在其上安装自己的 hc 并建立链接。你在其上打开的终端会在那里运行，并显示在这里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "c11 使用你的 SSH 密鑰登入另一部機器（Mac 或 Linux 機器），在其上安裝自己的 hc 並建立連結。你在其上打開的終端機會在那裡執行，並顯示在這裡。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "c11 входит на другую машину (Mac или Linux) по вашим ключам SSH, устанавливает там собственный hc и связывает его. Терминалы, открытые на ней, работают там и отображаются здесь."
          }
        }
      }
    },
