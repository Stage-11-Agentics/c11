    "settings.app.markdownSpawnButton.subtitleOn": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The panel bar shows the Markdown spawn button. Turn off to reclaim the slot; markdown panels stay available via the CLI and command palette."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パネルバーに Markdown 作成ボタンが表示されます。オフにするとその分のスペースを取り戻せます。Markdown のパネルは CLI とコマンドパレットから引き続き利用できます。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Смуга панелей показує кнопку створення Markdown. Вимкніть, щоб звільнити місце; панелі Markdown залишаються доступними через CLI та палітру команд."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "패널 막대에 Markdown 생성 버튼이 표시됩니다. 끄면 그 자리를 되찾을 수 있습니다. Markdown 패널은 CLI와 명령어 팔레트를 통해 계속 사용할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "面板栏显示 Markdown 生成按钮。关闭可腾出该位置；Markdown 面板仍可通过 CLI 和命令面板使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "面板列顯示 Markdown 建立按鈕。關閉可騰出該位置；Markdown 面板仍可透過 CLI 和指令面板使用。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Строка панелей показывает кнопку создания Markdown. Отключите, чтобы освободить место; панели Markdown остаются доступны через CLI и палитру команд."
          }
        }
      }
    },
    "settings.app.markdownSpawnButton.subtitleOff": {
      "extractionState": "manual",
      "localizations": {
