    "settings.waitingCheck.jev.note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Jev reads the end of the agent's screen. With a key set, that text is sent to TypeSafe."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Jev はエージェントの画面の末尾を読み取ります。キーを設定すると、そのテキストが TypeSafe に送信されます。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Jev читає кінець екрана агента. Якщо ключ задано, цей текст надсилається до TypeSafe."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Jev는 에이전트 화면의 끝부분을 읽습니다. 키를 설정하면 그 텍스트가 TypeSafe로 전송됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Jev 会读取代理屏幕的末尾内容。设置密钥后,这些文本会发送到 TypeSafe。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Jev 會讀取代理畫面的末尾內容。設定金鑰後,這些文字會傳送到 TypeSafe。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Jev читает конец экрана агента. Если задан ключ, этот текст отправляется в TypeSafe."
          }
        }
      }
    },
    "settings.waitingCheck.withheldTerms": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Withhold lines containing"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次を含む行を送信しない"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не надсилати рядки, що містять"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음을 포함한 줄 제외"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不发送包含以下内容的行"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不傳送包含以下內容的行"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не отправлять строки, содержащие"
          }
        }
      }
    },
    "settings.waitingCheck.withheldTerms.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One term per line. A screen line containing any of them is never sent to Jev."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1行に1語。いずれかを含む画面の行は Jev に送信されません。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Один термін на рядок. Рядок екрана, що містить будь-який із них, ніколи не надсилається до Jev."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 줄에 한 항목씩 입력하세요. 이 중 하나라도 포함된 화면 줄은 Jev로 전송되지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每行一个词。包含其中任何一个词的屏幕行绝不会发送给 Jev。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每行一個詞。包含其中任何一個詞的畫面行絕不會傳送給 Jev。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Один термин на строку. Строка экрана, содержащая любой из них, никогда не отправляется в Jev."
          }
        }
      }
    },
