    "mailbox.conversations.copyGone": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Copy gone. %@'s copy is no longer on disk, so the text cannot be shown. The sent record keeps the topic, time and recipients."}},
        "ja": {"stringUnit": {"state": "translated", "value": "コピーがありません。%@ のコピーはディスク上にないため、テキストを表示できません。送信記録にはトピック、時刻、送信先が残っています。"}},
        "uk": {"stringUnit": {"state": "translated", "value": "Копії немає. Копії %@ більше немає на диску, тому текст показати неможливо. У записі про надіслане збережено тему, час і одержувачів."}},
        "ko": {"stringUnit": {"state": "translated", "value": "복사본 없음. %@의 복사본이 더 이상 디스크에 없어 텍스트를 표시할 수 없습니다. 발신 기록에는 주제, 시간, 수신자가 남아 있습니다."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "副本已丢失。%@ 的副本已不在磁盘上，因此无法显示文本。发送记录仍保留主题、时间和收件方。"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "副本已遺失。%@ 的副本已不在磁碟上，因此無法顯示文字。傳送記錄仍保留主題、時間和收件者。"}},
        "ru": {"stringUnit": {"state": "translated", "value": "Копии нет. Копии %@ больше нет на диске, поэтому текст показать нельзя. В записи об отправленном сохранены тема, время и получатели."}}
      }
    },
