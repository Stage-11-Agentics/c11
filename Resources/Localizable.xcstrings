    "mailbox.hold.trace.headless": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "held: the panel has no screen and hc does not report its agent idle"}},
        "ja": {"stringUnit": {"state": "translated", "value": "保留: パネルに画面がなく、hc がそのエージェントを待機中と報告していない"}},
        "uk": {"stringUnit": {"state": "translated", "value": "утримано: панель не має екрана, а hc не повідомляє, що її агент у простої"}},
        "ko": {"stringUnit": {"state": "translated", "value": "보류: 패널에 화면이 없고 hc가 해당 에이전트를 유휴 상태로 보고하지 않음"}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "暂缓: 面板没有屏幕，且 hc 未将其智能体报告为空闲"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "暫緩: 面板沒有螢幕，且 hc 未將其智慧體回報為閒置"}},
        "ru": {"stringUnit": {"state": "translated", "value": "удержано: у панели нет экрана, а hc не сообщает, что её агент простаивает"}}
      }
    },
    "mailbox.hold.trace.composerUnread": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "held: the panel has no screen and c11 could not read its composer; it reads it again shortly"}},
        "ja": {"stringUnit": {"state": "translated", "value": "保留: パネルに画面がなく、c11 が入力欄を読み取れなかった。まもなく再度読み取る"}},
        "uk": {"stringUnit": {"state": "translated", "value": "утримано: панель не має екрана, а c11 не зміг прочитати її поле введення; незабаром він прочитає його знову"}},
        "ko": {"stringUnit": {"state": "translated", "value": "보류: 패널에 화면이 없고 c11이 입력창을 읽지 못함. 곧 다시 읽음"}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "暂缓: 面板没有屏幕，且 c11 无法读取其输入框；稍后会再次读取"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "暫緩: 面板沒有螢幕，且 c11 無法讀取其輸入框；稍後會再次讀取"}},
        "ru": {"stringUnit": {"state": "translated", "value": "удержано: у панели нет экрана, а c11 не смог прочитать её поле ввода; вскоре он прочитает его снова"}}
      }
    },
