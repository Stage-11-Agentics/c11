#!/usr/bin/env bash
# c11 claude wrapper - reference implementation of the session-resume wrapper pattern.
#
# When running inside a c11 terminal (CMUX_SURFACE_ID is set + socket live),
# this wrapper intercepts `claude` invocations to inject --session-id and
# --settings flags so that Claude Code hooks fire back into c11 for
# session-resume capture and lifecycle status. Outside c11 (or when the
# socket is unreachable), it passes through to the real claude binary
# unchanged. A surviving c11-owned hc terminal keeps per-launch hooks while
# the app is down, so its original SessionStart bridge can reconnect later.
#
# === SESSION-RESUME WRAPPER PATTERN (REFERENCE IMPLEMENTATION) ================
# c11's principle is: host and primitive, not configurator. c11 does not
# reach into tenant config files (~/.claude/settings.json, ~/.codex/*,
# ~/.kimi/*, shell rc files, etc.) or persist behavior outside its own
# runtime. The one narrow exception: PATH-scoped wrappers like this one
# that capture the minimum lifecycle signal needed for session resume
# across c11 reboots.
#
# Constraints all session-resume wrappers must honour:
#
#   1. Live in c11's bundle (Resources/bin/<tool>) and prepend onto PATH
#      ONLY inside c11 terminals — gated on CMUX_SURFACE_ID and a live
#      c11 socket. An already-running c11 hc terminal retains its per-launch
#      hooks across app downtime; other unavailable sockets pass through.
#   2. Make NO persistent writes to tenant config, dotfiles, or any path
#      outside c11's runtime. /tmp is fine; ~/.claude/, ~/.codex/, etc.
#      are not.
#   3. Capture only the minimum needed: typically session id + terminal_type,
#      plus lifecycle status where the TUI exposes it (claude does via
#      hooks; codex does not — its wrapper relies on cwd-filter at restore
#      time instead).
#   4. Pass through to the real binary unchanged when outside a c11
#      terminal or when an ordinary c11 socket is unreachable. Failures are
#      best-effort: claude must still launch even when the socket is dead.
#
# Skill-driven self-reporting (`c11 set-metadata` / `c11 set-status` from
# the agent's own lifecycle, per the c11 skill) remains the standard for
# *runtime* telemetry. Wrappers handle only the resume-capture rail that
# the skill cannot, because they have to run *before* the agent process
# exists.
#
# `c11 install <tui>` (writing to tenant config) remains rejected. The
# wrapper pattern is the upper bound on what c11 reaches for. See
# CLAUDE.md "Principle: unopinionated about the terminal" for the full
# writeup.
# ============================================================================

# C11_AGENT_INTERACTIVE_PID is the positive interactive-agent marker (set
# below only for a launch that reads its terminal). Clear any inherited value
# first so no early exec passes a parent's marker on.
unset C11_AGENT_INTERACTIVE_PID

# Keep c11 membership available to both the early reentry and normal paths.
# A terminal an older build opened carries the retired names (hidden fallbacks).
for _c11_var in RELAY_BIN RELAY_AUTH RELAY_HC_SOCKET RELAY_SESSION AGENT_NOTE_DISABLED; do
    _c11_old="C11H_$_c11_var" # c11-2.0:legacy
    [[ -z "${!_c11_old:-}" ]] || [[ -n "$(eval "printf %s \"\${C11_$_c11_var:-}\"")" ]] || export "C11_$_c11_var=${!_c11_old}"
done
unset _c11_var _c11_old

IN_C11=0
if [[ -n "${C11_PANEL_ID:-${CMUX_SURFACE_ID:-}}" ]]; then
    IN_C11=1
fi

# Find the real claude binary, skipping our own directory.
find_real_claude() {
    local self_dir d candidate
    self_dir="$(cd "$(dirname "$0")" && pwd)"
    # C11H-134: c11's relay bin/ on another machine holds a claude entry, or
    # the operator's own shim that may exec this wrapper; neither is the real
    # claude, and taking the shim would loop.
    local relay_bin=""
    [[ "${C11_RELAY_BIN:-}" == "$HOME/.local/share/c11/relay/"*/bin ]] && relay_bin="$C11_RELAY_BIN"
    [[ "${C11_RELAY_BIN:-}" == "$HOME/.local/share/c11h/relay/"*/bin ]] && relay_bin="$C11_RELAY_BIN" # c11-2.0:legacy kit
    local IFS=:
    for d in $PATH; do
        [[ "$d" == "$self_dir" ]] && continue
        [[ -n "$relay_bin" && "$d" == "$relay_bin" ]] && continue
        candidate="$d/claude"
        [[ -x "$candidate" ]] || continue
        if LC_ALL=C head -c 512 "$candidate" 2>/dev/null | LC_ALL=C grep -Fq '# c11 claude wrapper'; then
            continue
        fi
        # A shim of the operator's that still ends in `exec <relay>/libexec/claude`
        # (the old relay advice) would run this wrapper again, forever. Match that
        # exec target only, anywhere in a small script, so a shim that merely names
        # a relay path is still taken.
        if LC_ALL=C head -c 65536 "$candidate" 2>/dev/null | LC_ALL=C grep -Eq '/c11/relay/[^/[:space:]]+/libexec/claude'; then
            continue
        fi
        printf '%s' "$candidate"
        return 0
    done
    return 1
}

# The real CLI inherits this marker. If it starts a child through PATH, bypass
# c11 hooks and forward directly to a non-wrapper binary instead of nesting.
if [[ -n "${C11_CLAUDE_WRAPPER_REENTRY:-}" ]]; then
    # Match the normal in-c11 passthrough behavior before forwarding a
    # descendant launch to the real binary.
    if [[ "$IN_C11" == "1" ]]; then
        unset CLAUDECODE
    fi
    REAL_CLAUDE="$(find_real_claude)" || { echo "Error: claude not found in PATH" >&2; exit 127; }
    unset C11_CLAUDE_WRAPPER_REENTRY
    exec "$REAL_CLAUDE" "$@"
fi

# Resolve the c11 binary the wrapper will use to talk to the running app.
# Bundle-relative `c11` first (so dev-tagged builds always hit the binary
# they shipped with, never a PATH shim that points at a different build),
# then `command -v c11` as a last resort for development environments
# where the bundle layout has shifted. Mirrors the codex wrapper.
find_c11_bin() {
    local self_dir
    self_dir="$(cd "$(dirname "$0")" && pwd)"
    local candidate="$self_dir/c11"
    if [[ -x "$candidate" ]]; then
        printf '%s' "$candidate"
        return 0
    fi
    candidate="$(command -v c11 || true)"
    if [[ -n "$candidate" ]]; then
        printf '%s' "$candidate"
        return 0
    fi
    return 1
}

# Return 0 only when the inherited app socket is live.
c11_socket_available() {
    local socket="${C11_SOCKET_PATH:-${CMUX_SOCKET_PATH:-}}"
    [[ -n "$socket" && -S "$socket" ]] || return 1

    local c11_bin
    c11_bin="$(find_c11_bin)" || return 1

    # Keep stale/hung socket checks bounded so claude startup does not block
    # behind the CLI default timeout (15s).
    CMUXTERM_CLI_RESPONSE_TIMEOUT_SEC=0.75 \
        "$c11_bin" --socket "$socket" ping >/dev/null 2>&1
}

# The one offline exception is the persistent tuple c11 placed in this
# terminal before the app stopped. hc's terminal id is local to that socket;
# an operator's foreign hc session, remote alias, or stale c11 env is not it.
# This installs only this launch's hooks. No tenant configuration is written.
c11_persistent_terminal() {
    # The session base and hc root follow the app's path namespace: c11's own, or the
    # retired line's while the app adopts its terminals (C11Paths, C11H-266).
    { [[ "${HC_SESSION:-}" =~ ^c11(-[A-Za-z0-9._-]+)?$ &&
         "${HC_SOCKET:-}" == "$HOME/.local/share/c11/run/${HC_SESSION}.sock" ]] ||
      [[ "${HC_SESSION:-}" =~ ^c11h(-[A-Za-z0-9._-]+)?$ && # c11-2.0:legacy
         "${HC_SOCKET:-}" == "$HOME/.local/share/c11h/run/${HC_SESSION}.sock" ]]; } && # c11-2.0:legacy
    [[ "${HC_SESSION:-}" == "${C11_HC_SESSION:-}" &&
       "${HC_SOCKET:-}" == "${C11_HC_SOCKET:-}" &&
       "${HC_SOCKET:-}" == "${HC_TERMINAL_SOCKET:-}" &&
       "${HC_TERMINAL_ID:-}" =~ ^t[1-9][0-9bcdfghjkmnpqrstvwxyz]*$ &&
       "${C11_PANEL_ID:-}" =~ ^[A-Fa-f0-9]{8}-[A-Fa-f0-9]{4}-[A-Fa-f0-9]{4}-[A-Fa-f0-9]{4}-[A-Fa-f0-9]{12}$ &&
       -n "${C11_SOCKET_PATH:-}" ]]
}

# C11H-134: a c11 terminal on another machine has no c11 socket. c11 gives
# each terminal there C11_RELAY_BIN, the relay folder whose c11 reaches c11
# through hc's link. Hooks run that c11. No tenant config is written.
c11_relay_terminal() {
    local relay_bin="${C11_RELAY_BIN:-}"
    # The hooks file names this folder inside JSON and a shell command.
    [[ ( "$relay_bin" == "$HOME/.local/share/c11/relay/"*/bin ||
         "$relay_bin" == "$HOME/.local/share/c11h/relay/"*/bin ) && # c11-2.0:legacy namespace
       "$relay_bin" =~ ^/[A-Za-z0-9._/@\ -]+$ && "$relay_bin" != *..* &&
       -x "$relay_bin/c11" &&
       "${HC_TERMINAL_ID:-}" =~ ^t[1-9][0-9bcdfghjkmnpqrstvwxyz]*$ &&
       "${C11_PANEL_ID:-}" =~ ^[A-Fa-f0-9]{8}-[A-Fa-f0-9]{4}-[A-Fa-f0-9]{4}-[A-Fa-f0-9]{4}-[A-Fa-f0-9]{12}$ ]]
}
C11_RELAY_MODE=0
if [[ "$IN_C11" == "1" ]] && c11_relay_terminal; then
    C11_RELAY_MODE=1
fi

# Missing/stale ordinary c11 sockets still pass through unchanged.
if [[ "$IN_C11" == "0" || "${C11_CLAUDE_HOOKS_DISABLED:-${CMUX_CLAUDE_HOOKS_DISABLED:-}}" == "1" ]] ||
   { [[ "$C11_RELAY_MODE" == "0" ]] && ! c11_socket_available && ! c11_persistent_terminal; }; then
    # Preserve old behavior when passing through due to a stale socket.
    if [[ "$IN_C11" == "1" ]]; then
        unset CLAUDECODE
    fi
    REAL_CLAUDE="$(find_real_claude)" || { echo "Error: claude not found in PATH" >&2; exit 127; }
    C11_CLAUDE_WRAPPER_REENTRY=1 exec "$REAL_CLAUDE" "$@"
fi

# Find real claude.
REAL_CLAUDE="$(find_real_claude)" || { echo "Error: claude not found in PATH" >&2; exit 127; }

# Unset CLAUDECODE to avoid "nested session" detection — c11 terminals are
# independent sessions even when the parent shell was launched from Claude Code.
# Applied before the passthrough case below so Agent View subcommands like
# `claude agents` and `claude attach <id>` (which open interactive Claude UIs)
# do not inherit a stale nested-session marker from the c11 parent.
unset CLAUDECODE

# Pass through subcommands that don't support session/hook flags.
#
# Agent View (Claude Code 2.1.139+, shipped 2026-05-11) added a family of
# subcommands that act on the per-user supervisor's pool of background
# sessions, not on a fresh interactive session: `agents` opens the TUI;
# `attach`/`logs`/`stop`/`kill`/`respawn`/`rm` operate by short session id.
# Injecting `--session-id <uuid>` and `--settings <hooks>` into any of them
# either replaces the real argv target with the wrapper's synthetic uuid or
# wedges the TUI into launching a new session instead of listing existing
# ones. They all bypass the session-resume rail.
# Docs: https://code.claude.com/docs/en/agent-view
case "${1:-}" in
    mcp|config|api-key|rc|remote-control|agents|attach|logs|stop|kill|respawn|rm)
        C11_CLAUDE_WRAPPER_REENTRY=1 exec "$REAL_CLAUDE" "$@"
        ;;
esac

# Check if the user already specified a session/resume flag.
# If so, don't inject our own --session-id (it would conflict).
SKIP_SESSION_ID=false
for arg in "$@"; do
    case "$arg" in
        --) break ;;
        --resume|--resume=*|--session-id|--session-id=*|--continue|-c|-r)
            SKIP_SESSION_ID=true
            break
            ;;
        # Combined short flags carrying -c or -r (`-cp`, `-pc`, `-rp`).
        -[!-]?*)
            if [[ "$arg" == *[cr]* ]]; then
                SKIP_SESSION_ID=true
                break
            fi
            ;;
    esac
done

# Export the wrapper's PID. Because we exec claude below, this PID becomes
# the actual claude process PID, which hooks use for stale-session detection.
export CMUX_CLAUDE_PID=$$

# Mark this launch as an interactive agent only when it reads and writes its
# terminal: not print mode (`-p`, `--print`) and not a background session
# (`--bg`, `--background`). c11 pushes mailbox messages only to a tab whose
# lifecycle reports carry this PID (exec keeps it, and hooks inherit it), and
# only while that PID's process group owns the terminal.
claude_interactive=1
[[ -t 0 && -t 1 ]] || claude_interactive=0
for arg in "$@"; do
    case "$arg" in
        --) break ;;
        -p|--print|--print=*|--bg|--background) claude_interactive=0; break ;;
        # Combined short flags (`-cp`, `-pc`): any cluster carrying `p`.
        -[!-]*p*|-p?*) claude_interactive=0; break ;;
    esac
done
# C11H-134: through the relay this PID would name a process on the wrong
# machine, so a relayed launch carries none (the relay drops it as well).
if [[ "$claude_interactive" == "1" && "$C11_RELAY_MODE" == "0" ]]; then
    export C11_AGENT_INTERACTIVE_PID=$$
fi

# Declare agent identity via `c11 set-agent` (source=declare). Runs in the
# background so startup latency is unaffected. Precedence at the store level
# ensures a prior explicit value is not overwritten.
#
# Default --type to "claude-code" since this is the claude wrapper; callers may
# override by exporting CMUX_AGENT_TYPE. Optional --task / --role forward from
# matching CMUX_AGENT_* vars if present. --model is deliberately NOT forwarded:
# CMUX_AGENT_MODEL is what the launch asked for, which c11 already recorded as a
# launch stamp (heuristic tier). Declaring it here would outrank the model c11
# detects from the session file, so a later `/model` would never show.
c11_set_agent_bg() {
    local c11_bin="$1"
    local agent_type="${CMUX_AGENT_TYPE:-claude-code}"
    [[ -n "$agent_type" ]] || return 0
    local args=(--type "$agent_type")
    [[ -n "${CMUX_AGENT_TASK:-}" ]] && args+=(--task "$CMUX_AGENT_TASK")
    [[ -n "${CMUX_AGENT_ROLE:-}" ]] && args+=(--role "$CMUX_AGENT_ROLE")
    (CMUXTERM_CLI_RESPONSE_TIMEOUT_SEC=0.75 \
        "$c11_bin" --socket "${CMUX_SOCKET_PATH}" set-agent "${args[@]}" \
        >/dev/null 2>&1) &
    disown 2>/dev/null || true
}
# C11H-134: the relay refuses both background calls; hc names the agent.
C11_SET_AGENT_BIN=""
[[ "$C11_RELAY_MODE" == "0" ]] && C11_SET_AGENT_BIN="$(find_c11_bin || true)"
[[ -n "$C11_SET_AGENT_BIN" ]] && c11_set_agent_bg "$C11_SET_AGENT_BIN"

# C11-24: wrapper-claim a placeholder ConversationRef so c11's conversation
# store has *something* to attach to before the SessionStart hook fires
# (or, if Claude crashes before the hook, the wrapper-claim establishes
# the lower bound for the next-launch pull-scrape filter).
#
# Idempotent and conservative — ConversationStore.claim never displaces a
# non-wrapperClaim source, so a second invocation in the same surface
# cannot regress a real id back to a placeholder.
#
# Background; disown so the wrapper exec doesn't wait on it.
c11_conversation_claim_bg() {
    local cli="$1"
    (
        CMUXTERM_CLI_RESPONSE_TIMEOUT_SEC=0.75 \
            "$cli" --socket "${CMUX_SOCKET_PATH}" \
            conversation claim --kind claude-code --cwd "$PWD" \
            >/dev/null 2>&1
    ) &
    disown 2>/dev/null || true
}
[[ -n "$C11_SET_AGENT_BIN" ]] && c11_conversation_claim_bg "$C11_SET_AGENT_BIN"

# The inbox bridge is interactive-only and opt-in (C11_CLAUDE_NATIVE_MAIL=1):
# Claude wraps every peer-inbox turn in its own permission notice, so mail
# defaults to the typed doorbell and the Stop drain. C11_CLAUDE_NATIVE_MAIL_DISABLED=1
# still wins. Older Claude versions without the exported messaging socket/token
# leave typed mail enabled even when opted in.
# It shares this launch's settings file; no MCP or tenant configuration is used.
# SessionStart runs this launch's own c11 when it was resolved and quotes cleanly into the
# JSON command: a different c11 earlier on PATH would add its own launch text to the note.
c11_session_start_bin="c11"
if [[ -n "$C11_SET_AGENT_BIN" && "$C11_SET_AGENT_BIN" != *[\'\"\\]* ]]; then
    c11_session_start_bin="'$C11_SET_AGENT_BIN'"
fi
SESSION_START_HOOKS='{"type":"command","command":"'"$c11_session_start_bin"' claude-hook session-start","timeout":10}'
if [[ "$claude_interactive" == "1" && "${C11_CLAUDE_NATIVE_MAIL:-}" == "1" &&
      "${C11_CLAUDE_NATIVE_MAIL_DISABLED:-}" != "1" ]]; then
    SESSION_START_HOOKS+=',{"type":"command","command":"c11 claude-mailbox","timeout":5,"async":true}'
fi

# Build hooks settings JSON.
# Claude Code merges --settings additively with the user's own settings.json.
# - SessionStart/Stop/Notification: existing lifecycle hooks
# - SessionEnd: cleanup when Claude exits (covers Ctrl+C where Stop doesn't fire)
# - UserPromptSubmit: clears "Needs input" and sets "Running" on new prompt
# - PreToolUse: tool observations, delivered asynchronously.
# - PostToolUse: ordinary tool observations are asynchronous; AskUserQuestion and
#   ExitPlanMode stay synchronous so their answer edge cannot pass Stop first.
# - StopFailure, SubagentStart, SubagentStop, PreCompact: lifecycle observations
# - PermissionRequest: synchronous, timeout 1, stdout {} from the hook. It must not answer Claude.
HOOKS_JSON='{"hooks":{"SessionStart":[{"matcher":"","hooks":['"$SESSION_START_HOOKS"']}],"Stop":[{"matcher":"","hooks":[{"type":"command","command":"c11 claude-hook stop","timeout":10}]}],"SessionEnd":[{"matcher":"","hooks":[{"type":"command","command":"c11 claude-hook session-end","timeout":1}]}],"Notification":[{"matcher":"","hooks":[{"type":"command","command":"c11 claude-hook notification","timeout":10}]}],"UserPromptSubmit":[{"matcher":"","hooks":[{"type":"command","command":"c11 claude-hook prompt-submit","timeout":10}]}],"PreToolUse":[{"matcher":"","hooks":[{"type":"command","command":"c11 claude-hook pre-tool-use","timeout":5,"async":true}]}],"PostToolUse":[{"matcher":"AskUserQuestion|ExitPlanMode","hooks":[{"type":"command","command":"c11 claude-hook post-tool-use","timeout":5}]},{"matcher":"^(?!(AskUserQuestion|ExitPlanMode)$).*","hooks":[{"type":"command","command":"c11 claude-hook post-tool-use","timeout":5,"async":true}]}],"StopFailure":[{"matcher":"","hooks":[{"type":"command","command":"c11 claude-hook stop-failure","timeout":10}]}],"PermissionRequest":[{"matcher":"","hooks":[{"type":"command","command":"c11 claude-hook permission-request","timeout":1}]}],"SubagentStart":[{"matcher":"","hooks":[{"type":"command","command":"c11 claude-hook subagent-start","timeout":5,"async":true}]}],"SubagentStop":[{"matcher":"","hooks":[{"type":"command","command":"c11 claude-hook subagent-stop","timeout":5,"async":true}]}],"PreCompact":[{"matcher":"","hooks":[{"type":"command","command":"c11 claude-hook pre-compact","timeout":5,"async":true}]}]}}'

# C11H-134: through the relay, each hook command is the relay's c11 by absolute
# path, and only the turn and attention edges are hooked: the relay is a
# polled hc document, not a channel for every tool call. The ask tools'
# PreToolUse is kept (it is what shows a question or plan review as blocked).
# Every edge but Stop (whose stdout carries mail) and the ask answer (which
# must land before Stop) is async, so a slow or dropped link never holds
# Claude. PermissionRequest (observe-only, a 1 s budget) and the native
# mailbox bridge (its stream does not cross the relay) are left out.
if [[ "$C11_RELAY_MODE" == "1" ]]; then
    relay_hook() { # <subcommand> <timeout> <async>
        printf '{"type":"command","command":"%s claude-hook %s","timeout":%s%s}' \
            "'$C11_RELAY_BIN/c11'" "$1" "$2" "$([[ "$3" == 1 ]] && printf ',"async":true')"
    }
    relay_event() { # <event> <matcher> <hook json>
        printf '"%s":[{"matcher":"%s","hooks":[%s]}]' "$1" "$2" "$3"
    }
    relay_asks='AskUserQuestion|ExitPlanMode'
    HOOKS_JSON='{"hooks":{'"$(relay_event SessionStart "" "$(relay_hook session-start 10 1)")"
    HOOKS_JSON+=','"$(relay_event UserPromptSubmit "" "$(relay_hook prompt-submit 10 1)")"
    HOOKS_JSON+=','"$(relay_event Stop "" "$(relay_hook stop 10 0)")"
    HOOKS_JSON+=','"$(relay_event StopFailure "" "$(relay_hook stop-failure 10 1)")"
    HOOKS_JSON+=','"$(relay_event Notification "" "$(relay_hook notification 10 1)")"
    HOOKS_JSON+=','"$(relay_event PreToolUse "$relay_asks" "$(relay_hook pre-tool-use 5 1)")"
    HOOKS_JSON+=','"$(relay_event PostToolUse "$relay_asks" "$(relay_hook post-tool-use 5 0)")"
    HOOKS_JSON+=','"$(relay_event SessionEnd "" "$(relay_hook session-end 5 1)")"'}}'
fi

# Claude Code 2.1.119 silently drops hooks loaded from inline
# `--settings <json>` but honours them when loaded from
# `--settings <path>`. Write it to a file and pass the path. Confirmed
# in 2.1.119 (no working SessionStart hook with inline JSON; identical
# JSON via file path fires correctly). If a future claude version
# restores inline-JSON support, this rail can be deleted without
# behavioural change.
#
# C11H-354: the file goes in a fresh folder that mktemp creates (0700,
# ours), under umask 077, so no other user can plant a symlink where it
# is written; never a predictable name. Claude reads it after this
# wrapper has exec'd, so it stays until the temp folder is reaped: a
# small JSON blob with no secrets.
#
# If mktemp or the write fails (e.g. unwritable TMPDIR, full /tmp,
# or sandboxed filesystem), fall back to passing inline JSON so
# claude still launches and the rest of the operator's session
# proceeds — hooks just won't fire that run. We surface the
# fallback on stderr (claude's stderr is generally surfaced by
# c11 terminals) so the regression is at least visible rather
# than completely silent.
HOOKS_ARG="$HOOKS_JSON"
c11_hooks_tmp="${TMPDIR:-/tmp}"
if c11_hooks_dir="$(umask 077 && mktemp -d "${c11_hooks_tmp%/}/c11-claude-hooks.XXXXXXXX" 2>/dev/null)" \
    && [[ -n "$c11_hooks_dir" ]] \
    && (umask 077 && printf '%s' "$HOOKS_JSON" > "$c11_hooks_dir/hooks.json") 2>/dev/null; then
    HOOKS_ARG="$c11_hooks_dir/hooks.json"
else
    echo "c11: warning: could not write the hooks file under ${c11_hooks_tmp}; falling back to inline --settings (claude 2.1.x will silently drop hooks)" >&2
fi
unset c11_hooks_tmp c11_hooks_dir

# C11H-35: the per-launch c11 note, by Claude's own flag (no file, no config).
c11_bin_dir="$(cd "$(dirname "$0")" && pwd)"
C11_NOTE_ARGS=()
# shellcheck source=/dev/null
[[ -r "$c11_bin_dir/c11-agent-note.sh" ]] && . "$c11_bin_dir/c11-agent-note.sh" && c11_note_args claude "$c11_bin_dir" "$@"
# The note is the one launch instruction. When it rides on the flag, the SessionStart hook
# adds nothing; when it does not (the operator passed their own flag), the hook sends it.
unset C11_AGENT_NOTE_SENT
[[ ${#C11_NOTE_ARGS[@]} -gt 0 ]] && export C11_AGENT_NOTE_SENT=1

if [[ "$SKIP_SESSION_ID" == true ]]; then
    C11_CLAUDE_WRAPPER_REENTRY=1 exec "$REAL_CLAUDE" --settings "$HOOKS_ARG" ${C11_NOTE_ARGS[@]+"${C11_NOTE_ARGS[@]}"} "$@"
else
    # A Linux machine may lack uuidgen (Debian's uuid-runtime); its kernel makes one too (C11H-191).
    SESSION_ID="$({ uuidgen 2>/dev/null || cat /proc/sys/kernel/random/uuid; } | tr '[:upper:]' '[:lower:]')"
    C11_CLAUDE_WRAPPER_REENTRY=1 exec "$REAL_CLAUDE" --session-id "$SESSION_ID" --settings "$HOOKS_ARG" ${C11_NOTE_ARGS[@]+"${C11_NOTE_ARGS[@]}"} "$@"
fi
