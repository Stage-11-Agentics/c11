    "agentLaunch.promptNotDelivered": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The agent's prompt was not delivered: %@. The agent was not given its task."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントのプロンプトを配信できませんでした: %@。エージェントにタスクは渡されていません。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Промпт агента не доставлено: %@. Агент не отримав свого завдання."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이전트의 프롬프트가 전달되지 않았습니다: %@. 에이전트에 작업이 주어지지 않았습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "智能体的提示词未送达：%@。智能体没有收到它的任务。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "代理的提示未送達：%@。代理未收到其任務。"
