    "agentConfigEditor.effort.kimiHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "kimi has no effort flag — rides %@ in the launch environment"
          }
        },
        "ja": { "stringUnit": { "state": "translated", "value": "Kimi は effort フラグに対応していません。起動環境では %@ を使用します。" } },
        "uk": { "stringUnit": { "state": "translated", "value": "Kimi не підтримує прапорець effort — значення задається змінною середовища запуску %@." } },
        "ko": { "stringUnit": { "state": "translated", "value": "Kimi는 effort 플래그를 지원하지 않습니다. 실행 환경에서 %@를 사용합니다." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "Kimi 不支持 effort 标志，启动环境中使用 %@。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "Kimi 不支援 effort 旗標，啟動環境中使用 %@。" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Kimi не поддерживает флаг effort — в среде запуска используется %@." } }
      }
    },
