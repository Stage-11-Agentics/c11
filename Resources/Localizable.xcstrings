          }
        }
      }
    },
    "settings.notifications.needsYouSound.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Played when an agent stops on you: a permission prompt, a question, a plan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントがあなたの対応待ちで止まったときに再生されます。許可の確認、質問、プランなど。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відтворюється, коли агент зупинився й чекає на вас: запит дозволу, питання, план."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이전트가 사용자를 기다리며 멈출 때 재생됩니다: 권한 요청, 질문, 계획."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "代理停下来等你时播放：权限请求、提问或计划。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "代理停下來等你時播放：權限請求、提問或計畫。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Воспроизводится, когда агент остановился и ждёт вас: запрос разрешения, вопрос, план."
          }
        }
      }
    },
    "settings.notifications.flagSound.subtitleKinds": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Played when an agent raises a flag whose kind has no sound of its own. Flags always sound, at every notification level."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントがフラグを立てたとき、その種類に専用のサウンドがない場合に再生されます。フラグはどの通知レベルでも必ず音が鳴ります。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відтворюється, коли агент ставить позначку, для якої немає власного звуку. Позначки завжди зі звуком на кожному рівні сповіщень."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이전트가 플래그를 올렸는데 해당 종류에 고유 소리가 없을 때 재생됩니다. 플래그는 모든 알림 수준에서 항상 소리가 납니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "代理提出的标记所属类型没有专属声音时播放。无论通知级别如何，标记始终会发出声音。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "代理提出的標記所屬類型沒有專屬音效時播放。無論通知層級為何，標記一律會發出聲音。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Воспроизводится, когда агент ставит отметку, у вида которой нет своего звука. Отметки всегда со звуком на любом уровне уведомлений."
          }
        }
      }
    },
    "settings.flagKinds.sound": {
