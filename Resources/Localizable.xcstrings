    "tabBar.layoutSwitch.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Switch Panel Layout for every area. Also in Settings > General > Areas & Panels."}},
        "ja": {"stringUnit": {"state": "translated", "value": "すべてのエリアのパネルのレイアウトを切り替えます。「設定 > 一般 > エリアとパネル」でも変更できます。"}},
        "uk": {"stringUnit": {"state": "translated", "value": "Перемикає розташування панелей для всіх областей. Також доступно в розділі «Налаштування > Загальні > Області та панелі»."}},
        "ko": {"stringUnit": {"state": "translated", "value": "모든 영역의 패널 레이아웃을 전환합니다. 설정 > 일반 > 영역 및 패널에서도 바꿀 수 있어요."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "切换所有区域的面板布局。也可在「设置 > 通用 > 区域和面板」中更改。"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "切換所有區域的面板版面。也可在「設定 > 一般 > 區域與面板」中更改。"}},
        "ru": {"stringUnit": {"state": "translated", "value": "Переключает расположение панелей во всех областях. Также доступно в «Настройки > Общие > Области и панели»."}}
      }
    },
    "feed.answer.multilineUnsupported": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Multiline feed answers are unsupported in c11 1.0. Nothing was sent; use c11 feed open to answer in the panel."
          }
        },
        "ja": {"stringUnit": {"state": "translated", "value": "c11 1.0 ではフィードへの複数行の回答に対応していません。何も送信されていません。パネルで回答するには c11 feed open を使用してください。"}},
        "uk": {"stringUnit": {"state": "translated", "value": "У c11 1.0 відповіді на запити через стрічку з кількох рядків не підтримуються. Нічого не надіслано; щоб відповісти в панелі, скористайтеся c11 feed open."}},
        "ko": {"stringUnit": {"state": "translated", "value": "c11 1.0에서는 피드 답변에 여러 줄을 사용할 수 없습니다. 아무것도 전송되지 않았습니다. 패널에서 답변하려면 c11 feed open을 사용하세요."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "c11 1.0 不支持在信息流中提交多行回答。未发送任何内容；如需在面板中回答，请使用 c11 feed open。"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "c11 1.0 不支援在資訊流中提交多行回答。未傳送任何內容；如需在面板中回答，請使用 c11 feed open。"}},
        "ru": {"stringUnit": {"state": "translated", "value": "В c11 1.0 нельзя отправлять ответы в ленте из нескольких строк. Ничего не отправлено; чтобы ответить в панели, используйте c11 feed open."}}
      }
    },
