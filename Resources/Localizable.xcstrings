          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "c11을 종료하면 이 Mac의 모든 터미널과 그 안의 작업이 종료됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "退出 c11 会结束这台 Mac 上的所有终端以及其中的任务。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
