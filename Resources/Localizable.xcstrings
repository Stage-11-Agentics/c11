    "agentSkills.replaceLocal.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ in %2$@ were synced from a checkout or edited after install, and may be newer than the copies bundled with this c11. Replacing installs the bundled copies and discards those changes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ の %1$@ は、チェックアウトから同期されたか、インストール後に編集されたもので、この c11 にバンドルされているコピーより新しい可能性があります。置き換えると、バンドルされたコピーがインストールされ、それらの変更は破棄されます。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ у %2$@ синхронізовано з робочої копії репозиторію або змінено після встановлення, тож вони можуть бути новішими за копії, вбудовані в цей c11. Заміна встановить вбудовані копії та відкине ці зміни."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@의 %1$@은(는) 체크아웃에서 동기화되었거나 설치 후 편집되었으며, 이 c11에 번들된 사본보다 최신일 수 있어요. 교체하면 번들된 사본이 설치되고 해당 변경 내용은 삭제돼요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ 中的 %1$@ 是从检出副本同步而来，或在安装后被修改过，可能比此 c11 内置的副本更新。替换将安装内置的副本，并丢弃这些更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ 中的 %1$@ 是從 checkout 同步而來，或在安裝後被編輯過，可能比此 c11 隨附的副本更新。取代後會安裝隨附的副本，並捨棄這些變更。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ в %2$@ синхронизированы из рабочей копии репозитория или изменены после установки и могут быть новее копий, встроенных в этот c11. Замена установит встроенные копии и отбросит эти изменения."
          }
        }
      }
    },
    "agentSkills.replaceLocal.title": {
