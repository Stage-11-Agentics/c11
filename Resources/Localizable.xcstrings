          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請在本機頁面中點按 c11 連結或按 Return 鍵將其開啟。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Открывайте ссылки c11 на локальной странице щелчком или клавишей Return."
          }
        }
      }
    },
    "panelLink.notice.invalid" : {
      "extractionState" : "manual",
      "localizations" : {
