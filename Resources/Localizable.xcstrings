    "agentPicker.notice.notInstalled": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ isn't on PATH — install it, or pin the row as default anyway"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ が PATH 上に見つかりません。インストールするか、このままデフォルトとして固定できます"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 不在 PATH 中 —— 请安装它，或仍将此行固定为默认"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 不在 PATH 中 —— 請安裝它，或仍將此列固定為預設"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@이(가) PATH에 없습니다 — 설치하거나, 그래도 이 행을 기본값으로 고정할 수 있습니다"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ отсутствует в PATH — установите его или всё равно закрепите строку по умолчанию"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ відсутній у PATH — встановіть його або все одно закріпіть рядок як типовий"
          }
        }
      }
    },
    "agentPicker.notice.pinFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't set '%@' as the default — please try again."
          }
        },
        "ja": { "stringUnit": { "state": "translated", "value": "「%@」をデフォルトに設定できませんでした。もう一度お試しください。" } },
        "uk": { "stringUnit": { "state": "translated", "value": "Не вдалося зробити «%@» типовою конфігурацією. Спробуйте ще раз." } },
        "ko": { "stringUnit": { "state": "translated", "value": "‘%@’을(를) 기본값으로 설정하지 못했습니다. 다시 시도해 주세요." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "无法将“%@”设为默认项，请重试。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "無法將「%@」設為預設項，請再試一次。" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Не удалось назначить «%@» конфигурацией по умолчанию. Попробуйте ещё раз." } }
      }
    },
    "agentPicker.notice.pinUnlaunchable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' can't launch as written, so it can't be the default — give it a launch command first."
          }
        },
        "ja": { "stringUnit": { "state": "translated", "value": "「%@」は現在の設定では起動できないため、デフォルトにできません。先に起動コマンドを設定してください。" } },
        "uk": { "stringUnit": { "state": "translated", "value": "«%@» не можна запустити в поточному вигляді, тому її не можна зробити типовою — спершу задайте команду запуску." } },
        "ko": { "stringUnit": { "state": "translated", "value": "‘%@’은(는) 현재 설정으로 실행할 수 없어 기본값으로 지정할 수 없습니다. 먼저 실행 명령을 설정해 주세요." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "“%@”目前无法启动，因此不能设为默认项。请先为其设置启动命令。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "「%@」目前無法啟動，因此不能設為預設項。請先為它設定啟動命令。" } },
        "ru": { "stringUnit": { "state": "translated", "value": "«%@» нельзя запустить в текущем виде, поэтому её нельзя назначить используемой по умолчанию — сначала задайте команду запуска." } }
      }
    },
