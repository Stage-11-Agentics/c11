    "herderTopography.help.agentLede": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paste this into Claude Code, Codex or any agent running in a c11 terminal. It checks the machine first, shows you the command, and links nothing until you say yes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これを Claude Code、Codex、または c11 のターミナルで動いている任意のエージェントに貼り付けてください。まずマシンを確認し、コマンドを見せて、あなたが了承するまで何もリンクしません。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вставте це в Claude Code, Codex або будь-якого агента, що працює в терміналі c11. Він спершу перевірить комп’ютер, покаже вам команду й нічого не приєднає, доки ви не погодитеся."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code, Codex 또는 c11 터미널에서 실행 중인 아무 에이전트에 이것을 붙여 넣으세요. 먼저 컴퓨터를 확인하고, 명령을 보여 주며, 승인하기 전에는 아무것도 연결하지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把这段内容粘贴到 Claude Code、Codex 或任何在 c11 终端中运行的智能体里。它会先检查那台电脑，把命令展示给你，在你同意之前不会链接任何东西。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把這段貼到 Claude Code、Codex，或任何在 c11 終端機中執行的代理。它會先檢查電腦、把指令給你看，在你同意之前不會連結任何東西。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вставьте это в Claude Code, Codex или любого агента в терминале c11. Он сначала проверит компьютер, покажет вам команду и ничего не свяжет, пока вы не скажете «да»."
          }
        }
      }
    },
    "herderTopography.help.agentTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Or hand it to your agent"
          }
        },
        "ja": {
