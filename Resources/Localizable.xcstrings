    "blueprint.markdown.error.wrongChildCount": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "blueprint markdown: split must have exactly two children (got %lld)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "blueprint markdown: 分割にはちょうど 2 つの子が必要です（%lld 個ありました）"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "blueprint markdown: розділення має містити рівно два дочірні вузли (отримано %lld)"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
