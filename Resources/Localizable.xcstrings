    "mailbox.insights.pickup.claims.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Taken messages these figures cover: each one's claim is recorded in the last %lld days."}},
        "ja": {"stringUnit": {"state": "translated", "value": "これらの数値の対象となる受け取り済みメッセージ：それぞれの取得が直近 %lld 日以内に記録されています。"}},
        "uk": {"stringUnit": {"state": "translated", "value": "Забрані повідомлення, на яких ґрунтуються ці цифри: запис про кожне зроблено за останні %lld дн."}},
        "ko": {"stringUnit": {"state": "translated", "value": "이 수치에 포함된 가져간 메시지: 각각의 가져감이 최근 %lld일 이내에 기록되었습니다."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "这些数据涵盖的已取走消息：每条的取走记录都在最近 %lld 天内。"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "這些數據涵蓋的已取走訊息：每則的取走紀錄都在最近 %lld 天內。"}},
        "ru": {"stringUnit": {"state": "translated", "value": "Забранные сообщения, на которых основаны эти цифры: запись о каждом сделана за последние %lld дн."}}
      }
    },
    "mailbox.insights.pickup.measure": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "From landing in this inbox to the agent taking it (recv --ack or a hook drain)"}},
        "ja": {"stringUnit": {"state": "translated", "value": "この受信箱に届いてから、エージェントが受け取るまで（recv --ack またはフックによる取り込み）"}},
        "uk": {"stringUnit": {"state": "translated", "value": "Від надходження в цю скриньку до моменту, коли агент забере повідомлення (recv --ack або вибірка хуком)"}},
        "ko": {"stringUnit": {"state": "translated", "value": "이 수신함에 도착한 때부터 에이전트가 가져갈 때까지 (recv --ack 또는 훅 비우기)"}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "从送达此收件箱到智能体取走（recv --ack 或钩子取空）"}},
