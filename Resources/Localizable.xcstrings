    "machineSetup.consent.headline": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Linking gives c11 a shell on %@ as you."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リンクすると、c11は%@上であなたとしてシェルを使えるようになります。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Після під'єднання c11 отримає на %@ оболонку від вашого імені."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결하면 c11이 %@에서 사용자 권한으로 셸을 사용하게 됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接后，c11 将以你的身份在 %@ 上获得一个 shell。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連結後，c11 會以你的身分在 %@ 上取得一個 shell。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После подключения c11 получит на %@ оболочку от вашего имени."
          }
        }
      }
    },
