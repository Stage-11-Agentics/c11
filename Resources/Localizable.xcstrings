    "socket.error.unsupported_routing_key": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unsupported parameter '%1$@'; use '%2$@'."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パラメータ '%1$@' には対応していません。'%2$@' を使用してください。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Непідтримуваний параметр '%1$@'; використовуйте '%2$@'."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지원하지 않는 매개변수 '%1$@'입니다. '%2$@'을(를) 사용하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不支持参数“%1$@”；请使用“%2$@”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不支援的參數 '%1$@'；請改用 '%2$@'。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Неподдерживаемый параметр '%1$@'; используйте '%2$@'."
          }
        }
      }
    },
    "socket.send.raw_unavailable": {
      "extractionState": "manual",
      "localizations": {
