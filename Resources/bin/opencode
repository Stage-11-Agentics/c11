#!/usr/bin/env bash
# c11 OpenCode wrapper - runtime lifecycle and session-resume bridge.
#
# Inside a live c11 terminal this wrapper declares OpenCode, seeds its resting
# state, and runtime-loads c11's bundled OpenCode plugin. It never writes
# ~/.config/opencode or any other persistent tenant configuration.

set -uo pipefail

# C11_AGENT_INTERACTIVE_PID is the positive interactive-agent marker (set
# below only for a launch that reads its terminal). Clear any inherited value
# first so no early exec passes a parent's marker on.
unset C11_AGENT_INTERACTIVE_PID

# Current names take precedence; legacy names remain accepted for old terminals.
c11_socket="${C11_SOCKET_PATH:-${CMUX_SOCKET_PATH:-}}"
c11_panel="${C11_PANEL_ID:-${C11_TAB_ID:-${CMUX_SURFACE_ID:-}}}"

find_real_opencode() {
    local self_dir
    self_dir="$(cd "$(dirname "$0")" && pwd)"
    local IFS=:
    for d in $PATH; do
        [[ "$d" == "$self_dir" ]] && continue
        [[ -x "$d/opencode" ]] && printf '%s' "$d/opencode" && return 0
    done
    return 1
}

c11_socket_available() {
    local socket="$c11_socket"
    [[ -n "$socket" && -S "$socket" ]] || return 1

    local self_dir c11_bin
    self_dir="$(cd "$(dirname "$0")" && pwd)"
    c11_bin="$self_dir/c11"
    [[ -x "$c11_bin" ]] || c11_bin="$(command -v c11 || true)"
    [[ -n "$c11_bin" ]] || return 1

    C11_DEFAULT_SOCKET_DEADLINE_MS=750 \
        "$c11_bin" --socket "$socket" ping >/dev/null 2>&1
}

REAL_OPENCODE="$(find_real_opencode)" || {
    echo "Error: opencode not found in PATH" >&2
    exit 127
}

if [[ -z "$c11_panel" || "${C11_OPENCODE_HOOKS_DISABLED:-${CMUX_OPENCODE_HOOKS_DISABLED:-}}" == "1" ]] ||
   ! c11_socket_available; then
    exec "$REAL_OPENCODE" "$@"
fi

self_dir="$(cd "$(dirname "$0")" && pwd)"
c11_bin="$self_dir/c11"
[[ -x "$c11_bin" ]] || c11_bin="$(command -v c11 || true)"
config_helper="$self_dir/opencode-v2-config.py"

# OpenCode's named subcommands and informational flags are transparent.
case "${1:-}" in
    serve|web|agent|models|auth|upgrade|uninstall|mcp|github|pr|stats|export|import|attach|acp|debug|--help|-h|--version|-v)
        exec "$REAL_OPENCODE" "$@"
        ;;
esac

opencode_version=""
if [[ -x "$config_helper" ]] && command -v python3 >/dev/null 2>&1; then
    opencode_version="$(python3 "$config_helper" version "$REAL_OPENCODE" 2>/dev/null || true)"
fi

# OpenCode v2 loads TUI plugins from the CLI config and shares its server
# across clients. Never give the legacy server plugin a panel identity.
if [[ "$opencode_version" == 2.0.25 ]]; then
    if [[ -t 0 && -t 1 && "${1:-}" != "run" ]]; then
        export C11_AGENT_INTERACTIVE_PID=$$
    fi

    # Claim this exact TUI process before OpenCode initializes. The TUI plugin
    # later captures through its own socket peer PID, not environment inherited
    # by a shared-server tool subprocess.
    expected_session=""
    launch_args=("$@")
    for ((arg_index=0; arg_index<${#launch_args[@]}; arg_index++)); do
        case "${launch_args[$arg_index]}" in
            --session|-s)
                if ((arg_index + 1 < ${#launch_args[@]})); then expected_session="${launch_args[$((arg_index + 1))]}"; fi
                break
                ;;
            --session=*) expected_session="${launch_args[$arg_index]#--session=}"; break ;;
            -s?*) expected_session="${launch_args[$arg_index]#-s}"; break ;;
        esac
    done
    if [[ -n "${C11_AGENT_INTERACTIVE_PID:-}" ]]; then
        if [[ -n "$c11_bin" ]] && command -v python3 >/dev/null 2>&1; then
            claim_payload="$(python3 - "$c11_panel" "$PWD" "$C11_AGENT_INTERACTIVE_PID" "$expected_session" <<'PY'
import json, os, sys, time

panel_id, cwd, pid, expected_id = sys.argv[1:5]
payload = {
    "panel_id": panel_id,
    "kind": "opencode",
    "cwd": cwd,
    "placeholder_id": f"wrapper-claim:{panel_id}",
    "interactive_pid": int(pid),
    "expires_at_epoch_ms": int(time.time() * 1000) + 120_000,
}
if expected_id:
    payload["expected_resume_id"] = expected_id
for env_name, param_name in (
    ("HOME", "recovery_home"),
    ("XDG_DATA_HOME", "recovery_xdg_data_home"),
    ("OPENCODE_DB", "recovery_database_override"),
):
    if env_name in os.environ:
        payload[param_name] = os.environ[env_name]
print(json.dumps(payload, separators=(",", ":")))
PY
            )"
            claim_accepted=0
            if [[ -n "$claim_payload" ]]; then
                # The socket can answer ping before restore has admitted
                # conversation claims. Retry only that transient startup
                # response, keeping the same expiry-bounded claim payload.
                for ((claim_attempt=1; claim_attempt<=20; claim_attempt++)); do
                    claim_output="$(C11_DEFAULT_SOCKET_DEADLINE_MS=750 \
                        "$c11_bin" --socket "$c11_socket" rpc conversation.claim "$claim_payload" 2>&1)"
                    if [[ $? -eq 0 ]]; then
                        claim_accepted=1
                        break
                    fi
                    [[ "$claim_output" == not_ready:* ]] || break
                    ((claim_attempt < 20)) || break
                    sleep 0.25
                done
            fi
            if [[ "$claim_accepted" == "1" ]]; then
                export C11_OPENCODE_TUI_CLAIMED=1
                [[ -z "$expected_session" ]] || export C11_OPENCODE_RESUME_RESERVED=1
            else
                export C11_OPENCODE_TUI_CLAIM_FAILED=1
                export C11_OPENCODE_RESUME_RESERVATION_FAILED=1
            fi
        else
            export C11_OPENCODE_TUI_CLAIM_FAILED=1
            export C11_OPENCODE_RESUME_RESERVATION_FAILED=1
        fi
    fi

    if [[ -n "$c11_bin" ]]; then
        ( C11_DEFAULT_SOCKET_DEADLINE_MS=750 "$c11_bin" --socket "$c11_socket" set-agent --type opencode >/dev/null 2>&1 ) &
        disown 2>/dev/null || true
        ( C11_DEFAULT_SOCKET_DEADLINE_MS=750 "$c11_bin" --socket "$c11_socket" agent-hook idle >/dev/null 2>&1 ) &
        disown 2>/dev/null || true
    fi

    # CLI-content plugins are the v2 TUI extension seam. The helper composes
    # the effective operator plugin list in memory and fails closed on invalid
    # or unreadable config. It never edits cli.json or an explicit override.
    if [[ -t 0 && -t 1 && "${1:-}" != "run" && -n "${C11_AGENT_INTERACTIVE_PID:-}" &&
          -x "$config_helper" ]]; then
        v2_plugin_dir="$self_dir/../skills/opencode-plugins/c11-opencode-v2"
        if [[ -d "$v2_plugin_dir" ]]; then
            composed="$(python3 "$config_helper" compose "$v2_plugin_dir" 2>/dev/null)" &&
                export OPENCODE_CLI_CONFIG_CONTENT="$composed"
        fi
    fi
    export C11_AGENT_HOOK_CLI="$c11_bin"
    exec "$REAL_OPENCODE" "$@"
fi

# Unknown versions get no c11 extension, because neither panel ownership nor
# config loading behavior is proven. v1 keeps the original supported path.
if [[ "$opencode_version" != 1.* ]]; then
    exec "$REAL_OPENCODE" "$@"
fi

# Mark this launch as an interactive agent only when it reads and writes
# its terminal (`opencode run` is one-shot). c11 pushes mailbox messages only to a panel whose
# lifecycle reports carry this PID (exec keeps it), and only while that PID's
# process group owns the terminal.
if [[ -t 0 && -t 1 ]] && [[ "${1:-}" != "run" ]]; then
    export C11_AGENT_INTERACTIVE_PID=$$
fi

if [[ -n "$c11_bin" ]]; then
    (
        C11_DEFAULT_SOCKET_DEADLINE_MS=750 \
            "$c11_bin" --socket "$c11_socket" set-agent --type opencode \
            >/dev/null 2>&1
    ) &
    disown 2>/dev/null || true

    (
        C11_DEFAULT_SOCKET_DEADLINE_MS=750 \
            "$c11_bin" --socket "$c11_socket" agent-hook idle \
            >/dev/null 2>&1
    ) &
    disown 2>/dev/null || true
fi

plugin_path="$(cd "$self_dir/../skills/opencode-plugins" && pwd)/c11-notify.js"
plugin_url="file://$plugin_path"
plugin_url="${plugin_url//\\/\\\\}"
plugin_url="${plugin_url//\"/\\\"}"
c11_runtime_config="{\"plugin\":[\"$plugin_url\"]}"
c11_runtime_plugin=0

# OpenCode merges its config sources. Prefer the in-memory content override;
# if the operator already owns that slot, supply c11's plugin through a private
# runtime file instead. If both runtime slots are explicitly occupied,
# preserve them untouched—the shared foreground-agent liveness guard still
# prevents false-idle decay.
if [[ -z "${OPENCODE_CONFIG_CONTENT:-}" ]]; then
    export OPENCODE_CONFIG_CONTENT="$c11_runtime_config"
    c11_runtime_plugin=1
elif [[ -z "${OPENCODE_CONFIG:-}" ]]; then
    # Migration and the server open this separately. /dev/fd shares its read
    # position and loses the plugin on the second read. Like the Claude wrapper,
    # retain a private, secret-free c11 tempfile until /tmp is reaped.
    c11_config_file="$(mktemp /tmp/c11-opencode-config.XXXXXX)"
    if [[ -n "$c11_config_file" ]] && printf '%s\n' "$c11_runtime_config" > "$c11_config_file"; then
        export OPENCODE_CONFIG="$c11_config_file"
        c11_runtime_plugin=1
    fi
fi

# OpenCode 1.15's TUI plugins can identify the displayed session. Keep the
# operator's explicit TUI config untouched; that case uses typed delivery.
# Older versions ignore this runtime override and retain their existing route.
if [[ "$c11_runtime_plugin" == "1" && -n "${C11_AGENT_INTERACTIVE_PID:-}" && -z "${OPENCODE_TUI_CONFIG:-}" &&
      "${C11_OPENCODE_NATIVE_MAIL_DISABLED:-}" != "1" ]]; then
    tui_plugin_url="${plugin_url%/c11-notify.js}/c11-mailbox.mjs"
    if [[ -f "${plugin_path%/c11-notify.js}/c11-mailbox.mjs" ]]; then
        exec 9<<<"{\"plugin\":[\"$tui_plugin_url\"]}"
        export OPENCODE_TUI_CONFIG="/dev/fd/9"
    fi
fi

export C11_AGENT_HOOK_CLI="$c11_bin"
exec "$REAL_OPENCODE" "$@"
