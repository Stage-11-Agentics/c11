    "privateFile.directory.unsafe": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Refusing to use %@: it must be a folder owned by the current user, not a symlink."}},
        "ja": {"stringUnit": {"state": "translated", "value": "%@ は使用しません。現在のユーザーが所有するフォルダである必要があり、シンボリックリンクは使用できません。"}},
        "uk": {"stringUnit": {"state": "translated", "value": "Відмовляюся використовувати %@: це має бути тека, що належить поточному користувачу, а не символічне посилання."}},
        "ko": {"stringUnit": {"state": "translated", "value": "%@을(를) 사용하지 않습니다. 현재 사용자가 소유한 폴더여야 하며 심볼릭 링크는 사용할 수 없습니다."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "拒绝使用 %@：它必须是当前用户拥有的文件夹，而不是符号链接。"}},
        "zh-Hant": {"stringUnit": {"state": "translated", "value": "拒絕使用 %@：它必須是目前使用者擁有的資料夾，而不是符號連結。"}},
        "ru": {"stringUnit": {"state": "translated", "value": "Отказ от использования %@: это должна быть папка, принадлежащая текущему пользователю, а не символическая ссылка."}}
      }
    },
